1	 	 	 	 	; MODE.COM for MS-DOS 1.25 on the Timex
	 	 	 	 FDD3000: the WD2123's serial ports.
2	 	 	 	 	;
3	 	 	 	 	;       MODE port[:] [baud][,[parity][,
	 	 	 	[data bits][,stop bits]]]
4	 	 	 	 	;       MODE [port[:]]
5	 	 	 	 	;
6	 	 	 	 	; port: PRN, LPT1 or COM1 for channel A
	 	 	 	 (DOS's PRN), AUX or COM2 for
7	 	 	 	 	; channel B (DOS's AUX); COM1 and COM2 
	 	 	 	are INT 14H's ports 0 and 1.
8	 	 	 	 	; baud: 50 75 110 134.5 (or 134) 150 20
	 	 	 	0 300 600 1200 1800 2400 3600 4800
9	 	 	 	 	; 7200 9600 19200, or the PC's 11 15 30
	 	 	 	 60 12 24 48 96 19. parity: N, O or
10	 	 	 	 	; E. data bits: 5 to 8. stop bits: 1, 1
	 	 	 	.5 or 2. A setting left out stays
11	 	 	 	 	; as it is. MODE with a port alone show
	 	 	 	s its settings, with no port both.
12	 	 	 	 	;
13	 	 	 	 	; The settings go to the chip through I
	 	 	 	NT 14H's FDD3000 calls (BIOS.ASM's
14	 	 	 	 	; I14X, with I86.ASM's I14RD and SSET):
	 	 	 	 F0H reads the mode byte and baud
15	 	 	 	 	; code the BIOS last set, F1H sets them
	 	 	 	. CP/M programs run by CPM.COM use the same set
	 	 	 	tings.
16	 	 	 	 	; Every boot sets both channels to 1200
	 	 	 	 baud, no parity, 8 bits, 1.5 stop
17	 	 	 	 	; bits, as the FDD3000's CP/M does: put
	 	 	 	 MODE lines in AUTOEXEC.BAT to
18	 	 	 	 	; have others.
19	 	 	 	 	;
20	 	 	 	 	; The mode byte is the 8251A's: bits 7-
	 	 	 	6 stop bits (01 1, 10 1.5, 11 2),
21	 	 	 	 	; 5 even parity, 4 parity on, 3-2 data 
	 	 	 	bits - 5, 1-0 10 (x16 clock).
22	 	 	 	 	
23	 0000	 	 	 	CODE    SEGMENT
24	 	 	 	 	        ASSUME  CS:CODE,DS:CODE,ES:CODE
	 	 	 	,SS:CODE
25	 0100	 	 	 	        ORG     100H
26	 	 	 	 	
27	 0100  E9 030B R	 	BEGIN:  JMP     START
28	 	 	 	 	
29	 0103  0000	 	 	CHAN    DW      0               ; INT 1
	 	 	 	4H's port: 0 channel A, 1 channel B
30	 0105  00	 	 	MODEB   DB      0               ; the n
	 	 	 	ew settings
31	 0106  00	 	 	BAUDC   DB      0
32	 0107  20 20 20 20	 	NAMBUF  DB      "    "          ; the p
	 	 	 	ort's name, then a field
33	 010B  20 20 20 20 20 20	TOKEN   DB      "      "
 The Microsoft MACRO Assembler             11-08-<6    	PAGE	1-2



