1	 	 	 	 	; FORMAT.COM for MS-DOS 1.25 on the Tim
	 	 	 	ex FDD3000.
2	 	 	 	 	;
3	 	 	 	 	;       FORMAT [d:] [/S]
4	 	 	 	 	;
5	 	 	 	 	; Formats the disk in drive d: (default
	 	 	 	: the current drive) in the FDD3000
6	 	 	 	 	; DOS format of mkfat.py: 40 tracks of 
	 	 	 	18 x 256-byte sectors, IDs 0-17,
7	 	 	 	 	; the boot sector, 2 FATs of 2 sectors,
	 	 	 	 64 directory entries, 1 KB
8	 	 	 	 	; clusters.
9	 	 	 	 	;
10	 	 	 	 	; Each track is written by the BIOS tra
	 	 	 	p 1BH (FORMAT TRACK in BIOS.ASM:
11	 	 	 	 	; the WD177x write track) from a track 
	 	 	 	image made here, then read back
12	 	 	 	 	; with INT 25H. The clusters of a track
	 	 	 	 that does not read back are
13	 	 	 	 	; marked bad (FF7H); a bad track 0 (boo
	 	 	 	t sector, FATs, directory) fails
14	 	 	 	 	; the format. Every disk gets the boot 
	 	 	 	sector of the current drive: it
15	 	 	 	 	; boots the system or says "Non-System 
	 	 	 	disk".
16	 	 	 	 	;
17	 	 	 	 	; /S copies the system from the current
	 	 	 	 drive: the hidden files Z86.SYS
18	 	 	 	 	; (the Z80 interpreter and BIOS), IO.SY
	 	 	 	S and MSDOS.SYS, then COMMAND.COM.
19	 	 	 	 	; On the empty disk DOS gives them the 
	 	 	 	first directory entries and the
20	 	 	 	 	; first clusters, contiguous, where the
	 	 	 	 boot sector and COLD look for
21	 	 	 	 	; them. Everything is read before the n
	 	 	 	ew disk is asked for, so
22	 	 	 	 	; FORMAT A:/S works with one drive.
23	 	 	 	 	;
24	 	 	 	 	; INT 25H / 26H in MS-DOS 1.25 call the
	 	 	 	 BIOS READ / WRITE directly: CF=1
25	 	 	 	 	; and AL = error code, the flags are le
	 	 	 	ft on the stack.
26	 	 	 	 	
27	 = 0012	 	 	 	SPT     EQU     18
28	 = 0028	 	 	 	NTRACK  EQU     40
29	 = 1778	 	 	 	TRKLEN  EQU     32+SPT*332      ; track
	 	 	 	 image bytes (the FDC pads with 4EH)
30	 = 0002	 	 	 	NDRIVE  EQU     2               ; IO.SY
	 	 	 	S has A: and B:
31	 = 0001	 	 	 	FATSEC  EQU     1               ; FAT 1
	 	 	 	 at 1-2, FAT 2 at 3-4
32	 = 0002	 	 	 	FATSECS EQU     2
33	 = 0005	 	 	 	DIRSEC  EQU     5
 The Microsoft MACRO Assembler             11-06-<6    	PAGE	1-2



34	 = 0008	 	 	 	DIRSECS EQU     8
35	 = 000D	 	 	 	FIRREC  EQU     13
36	 = 00B1	 	 	 	MAXCLUS EQU     177             ; clust
	 	 	 	ers 2-177
37	 = 0004	 	 	 	NSYS    EQU     4               ; files
	 	 	 	 copied by /S
38	 = 5800	 	 	 	SYSMAX  EQU     22528           ; their
	 	 	 	 bytes
39	 	 	 	 	
40	 	 	 	 	; buffers after the program, at TRACK
41	 =	 	 	 	VEROFF  EQU     TRKLEN          ; one t
	 	 	 	rack read back (4.5 KB); the directory
42	 = 2978	 	 	 	FATOFF  EQU     VEROFF+SPT*256  ; the F
	 	 	 	AT (512 bytes)
43	 = 2B78	 	 	 	BOOTOFF EQU     FATOFF+512      ; the b
	 	 	 	oot sector
44	 = 2C78	 	 	 	SYSOFF  EQU     BOOTOFF+256     ; the /
	 	 	 	S files, one after the other
45	 = 8478	 	 	 	BUFEND  EQU     SYSOFF+SYSMAX
