 The Microsoft MACRO Assembler             11-07-<6    	PAGE	1-1



1	 	 	 	 	; EDIT.COM for MS-DOS 1.25 on the Timex
	 	 	 	 FDD3000: a full-screen text
2	 	 	 	 	; editor, with the keys and the status 
	 	 	 	line of TMX CP/M's EDIT
3	 	 	 	 	; (cpm80ds/progs/edit.asm).
4	 	 	 	 	;
5	 	 	 	 	;       EDIT name.ext [/80]
6	 	 	 	 	;
7	 	 	 	 	; The whole file is held in memory in a
	 	 	 	 gap buffer: the text before the
8	 	 	 	 	; cursor at BUFS..GAPS-1, the text afte
	 	 	 	r it at GAPE..TEND-1. Lines end in
9	 	 	 	 	; LF inside; the file is read and writt
	 	 	 	en with CR LF and a ^Z at the end.
10	 	 	 	 	;
11	 	 	 	 	; The 8086 runs here on an interpreter,
	 	 	 	 at about 17 000 instructions a
12	 	 	 	 	; second, so the screen is not kept as 
	 	 	 	a copy and compared, as EDIT does
13	 	 	 	 	; on the Z80. Each text row has a mark 
	 	 	 	instead: the first column to send
14	 	 	 	 	; again, or FFH. A command marks what i
	 	 	 	t changed, and only marked rows are
15	 	 	 	 	; sent, a row at a time, until a key is
	 	 	 	 waiting. A line moved past the top
16	 	 	 	 	; or bottom row scrolls the terminal (E
	 	 	 	SC I on the top row, LF on the
17	 	 	 	 	; bottom one), and the fields of the st
	 	 	 	atus line are sent only when they
18	 	 	 	 	; change.
19	 	 	 	 	;
20	 	 	 	 	; The terminal is the Terminal 3000's V
	 	 	 	T52: ESC Y row col, ESC H ESC J,
21	 	 	 	 	; ESC K, ESC L / ESC M (inverse), ESC I
	 	 	 	. The editor never writes in the
22	 	 	 	 	; last column (the terminal wraps there
	 	 	 	). Output goes through INT 10H
23	 	 	 	 	; (teletype) and keys come from INT 16H
	 	 	 	, so ^C, ^S and the rest reach the
24	 	 	 	 	; editor, not DOS.
25	 	 	 	 	
26	 = 0009	 	 	 	TAB     EQU     9
27	 = 000A	 	 	 	LF      EQU     10
28	 = 000D	 	 	 	CR      EQU     13
29	 = 001A	 	 	 	CTLZ    EQU     26
30	 = 001B	 	 	 	KESC    EQU     27
31	 = 0018	 	 	 	NRMAX   EQU     24              ; text 
	 	 	 	rows at most
32	 = 0400	 	 	 	LMAX    EQU     1024            ; colum
	 	 	 	ns of a line that can be shown
33	 = 0010	 	 	 	FMAX    EQU     16              ; longe
	 	 	 	st search string
34	 = 0400	 	 	 	OBSZ    EQU     1024            ; outpu
 The Microsoft MACRO Assembler             11-07-<6    	PAGE	1-2



	 	 	 	t to the terminal, sent at once
35	 = 0800	 	 	 	WBSZ    EQU     2048            ; the f
	 	 	 	ile, written in blocks of this
36	 = 0017	 	 	 	LNUMC   EQU     23              ; statu
	 	 	 	s line: line number,
37	 = 0021	 	 	 	CNUMC   EQU     33              ;   col
	 	 	 	umn,
38	 = 0027	 	 	 	MSGC    EQU     39              ;   mes
	 	 	 	sages
39	 	 	 	 	
40	 	 	 	 	; buffers after the program, at BUFFERS
41	 = 0000	 	 	 	OBOFF   EQU     0
42	 = 0400	 	 	 	EBOFF   EQU     OBOFF+OBSZ      ; a row
	 	 	 	 with its tabs expanded
43	 = 0810	 	 	 	WBOFF   EQU     EBOFF+LMAX+16
44	 = 1110	 	 	 	STKOFF  EQU     WBOFF+WBSZ+256  ; the s
	 	 	 	tack's top
45	 =	 	 	 	TXOFF   EQU     STKOFF          ; then 
	 	 	 	the text
46	 	 	 	 	
