1	 	 	 	 	; TERM.COM for MS-DOS 1.25 on the Timex
	 	 	 	 FDD3000: a serial terminal on one
2	 	 	 	 	; of the WD2123's channels, with the Ti
	 	 	 	mex terminal as screen and keyboard.
3	 	 	 	 	;
4	 	 	 	 	;       TERM [port[:] [baud][,[parity][
	 	 	 	,[data bits][,stop bits]]]] [/opts]
5	 	 	 	 	;
6	 	 	 	 	; port and settings as for MODE (defaul
	 	 	 	t: AUX, as it is set now). Options:
7	 	 	 	 	;       /80     an 80-column terminal (
	 	 	 	default 64)
8	 	 	 	 	;       /52     the host sends VT52 cod
	 	 	 	es (default VT100 / ANSI)
9	 	 	 	 	;       /X      XON / XOFF flow control
	 	 	 	 (the default), /R RTS / CTS, /N none
10	 	 	 	 	;       /E      local echo: what is typ
	 	 	 	ed shows on the screen too
11	 	 	 	 	;       /C      a CR received also goes
	 	 	 	 to the next line (an implicit LF)
12	 	 	 	 	;
13	 	 	 	 	; Ctrl-A brings up the menu on the bott
	 	 	 	om line: Q quit, L log to a file
14	 	 	 	 	; (on / off), E local echo (on / off), 
	 	 	 	C implicit LF (on / off), R
15	 	 	 	 	; receive a file by XMODEM, S send one,
	 	 	 	 B send a break, Ctrl-A send a
16	 	 	 	 	; Ctrl-A; any other key goes back.
17	 	 	 	 	;
18	 	 	 	 	; The work is done by the Z80 part (TER
	 	 	 	MZ80.ASM, here as TERMZ80.INC),
19	 	 	 	 	; which BIOS trap 1CH copies over the B
	 	 	 	IOS's COLD and then calls: the
20	 	 	 	 	; session itself, the screen, and the c
	 	 	 	hannel's bytes for XMODEM. This
21	 	 	 	 	; part reads the command line, keeps th
	 	 	 	e files and runs the menu and the
22	 	 	 	 	; XMODEM protocol. The buffers the Z80 
	 	 	 	part uses are here, over the copy
23	 	 	 	 	; of it, once it is loaded.
24	 	 	 	 	
25	 = 0018	 	 	 	ROWS    EQU     24
26	 = 0800	 	 	 	RINGSZ  EQU     2048
27	 = 2000	 	 	 	LOGSZ   EQU     8192
28	 = 0001	 	 	 	MENUK   EQU     1               ; Ctrl-
	 	 	 	A
29	 	 	 	 	
30	 = 0001	 	 	 	SOH     EQU     1
31	 = 0004	 	 	 	EOT     EQU     4
32	 = 0006	 	 	 	ACK     EQU     6
33	 = 0015	 	 	 	NAK     EQU     15H
34	 = 0018	 	 	 	CAN     EQU     18H
35	 	 	 	 	
