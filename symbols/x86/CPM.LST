1	 	 	 	 	; CPM.COM for MS-DOS 1.25 on the Timex 
	 	 	 	FDD3000: CP/M 2.2 programs, run
2	 	 	 	 	; natively on the FDD3000's Z80, with t
	 	 	 	heir files on the DOS disk.
3	 	 	 	 	;
4	 	 	 	 	;       CPM program [arguments]
5	 	 	 	 	;
6	 	 	 	 	; The program is program.CPM, or progra
	 	 	 	m.COM if there is no .CPM (a CP/M
7	 	 	 	 	; .COM is Z80 code: keep CP/M programs 
	 	 	 	as .CPM, so that DOS does not run
8	 	 	 	 	; one as 8086 code). The arguments beco
	 	 	 	me the CP/M command tail and the
9	 	 	 	 	; FCBs at 5CH and 6CH, as the CCP makes
	 	 	 	 them.
10	 	 	 	 	;
11	 	 	 	 	; This part, in 8086 code, has BIOS tra
	 	 	 	p 1CH copy the Z80 part
12	 	 	 	 	; (CPMZ80.ASM, here as CPMZ80.INC) to t
	 	 	 	he Z80's memory above the BIOS,
13	 	 	 	 	; reads the program over it (STAGE) and
	 	 	 	 works out the memory: the
14	 	 	 	 	; program gets 0100H up to P, a page th
	 	 	 	at holds its BDOS and BIOS
15	 	 	 	 	; entries; above it DOS, COMMAND and CP
	 	 	 	M.COM wait while it runs. Trap
16	 	 	 	 	; 1CH again runs the Z80 part, which re
	 	 	 	turns when the program ends.
17	 	 	 	 	
18	 = 0200	 	 	 	PSIZE   EQU     200H            ; the P
	 	 	 	 area (CPMZ80.ASM)
19	 	 	 	 	
20	 0000	 	 	 	CODE    SEGMENT
21	 	 	 	 	        ASSUME  CS:CODE,DS:CODE,ES:CODE
	 	 	 	,SS:CODE
22	 0100	 	 	 	        ORG     100H
23	 	 	 	 	
24	 0100  E9 0235 R	 	BEGIN:  JMP     START
25	 	 	 	 	
26	 0103  0000	 	 	BASE    DW      0               ; CS * 
	 	 	 	16: this program's linear address
27	 0105  00	 	 	DRIVE   DB      0               ; the c
	 	 	 	urrent drive
28	 0106  0000	 	 	STGOFF  DW      0               ; STAGE
	 	 	 	, rounded up to a paragraph
29	 	 	 	 	
30	 0108  00 20 20 20 20 20	PFCB    DB      0,"           "
31	       20 20 20 20 20 20	
32	 0114     19 [	 	 	        DB      25 DUP (0)
33	                00	 	
34	                    ]	 	
35	 	 	 	 	
36	 	 	 	 	
