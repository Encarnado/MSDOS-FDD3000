1514	                             C	;       CX = No. of bytes to transfer
1515	                             C	;       BP = Base of drive parameters
1516	                             C	;       SI = FAT pointer
1517	                             C	;       [RECCNT] = Record count
1518	                             C	;       [RECPOS] = Record position in file
1519	                             C	;       [FCB] = DI
1520	                             C	;       [NEXTADD] = Displacement of disk transfer within segment
1521	                             C	;       [SECPOS] = Position of first sector
1522	                             C	;       [BYTPOS] = Byte position in file
1523	                             C	;       [BYTSECPOS] = Byte position in first sector
1524	                             C	;       [CLUSNUM] = First cluster
1525	                             C	;       [SECCLUSPOS] = Sector within first cluster
1526	                             C	;       [DSKERR] = 0 (no errors yet)
1527	                             C	;       [TRANS] = 0 (No transfers yet)
1528	                             C	;       [THISDRV] = Physical drive unit number
