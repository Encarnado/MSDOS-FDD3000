116	 0024                        C	FCBLOCK ENDS
117	 = 0010                      C	FILDIRENT       = FILSIZ                ;Used only by SEARCH FIRST and SEARCH NEXT
118	                             C	
119	                             C	; Description of 32-byte directory entry (same as returned by SEARCH FIRST
120	                             C	; and SEARCH NEXT, functions 17 and 18).
121	                             C	;
122	                             C	; Location      bytes   Description
123	                             C	;
124	                             C	;    0          11      File name and extension ( 0E5H if empty)
125	                             C	;   11           1      Attributes. Bits 1 or 2 make file hidden
126	                             C	;   12          10      Zero field (for expansion)
127	                             C	;   22           2      Time. Bits 0-4=seconds/2, bits 5-10=minute, 11-15=hour
128	                             C	;   24           2      Date. Bits 0-4=day, bits 5-8=month, bits 9-15=year-1980
129	                             C	;   26           2      First allocation unit ( < 4080 )
130	                             C	;   28           4      File size, in bytes (LSB first, 30 bits max.)
131	                             C	;
132	                             C	; The File Allocation Table uses a 12-bit entry for each allocation unit on
133	                             C	; the disk. These entries are packed, two for every three bytes. The contents
134	                             C	; of entry number N is found by 1) multiplying N by 1.5; 2) adding the result
135	                             C	; to the base address of the Allocation Table; 3) fetching the 16-bit word at
136	                             C	; this address; 4) If N was odd (so that N*1.5 was not an integer), shift the
137	                             C	; word right four bits; 5) mask to 12 bits (AND with 0FFF hex). Entry number
138	                             C	; zero is used as an end-of-file trap in the OS and as a flag for directory
139	                             C	; entry size (if SMALLDIR selected). Entry 1 is reserved for future use. The
140	                             C	; first available allocation unit is assigned entry number two, and even
141	                             C	; though it is the first, is called cluster 2. Entries greater than 0FF8H are
142	                             C	; end of file marks; entries of zero are unallocated. Otherwise, the contents
143	                             C	; of a FAT entry is the number of the next cluster in the file.
144	                             C	
145	                             C	
146	                             C	; Field definition for Drive Parameter Block
147	                             C	
148	                             C	DPBLOCK STRUC
149	 0000  ??                    C	DEVNUM  DB      ?       ;I/O driver number
150	 0001  ??                    C	DRVNUM  DB      ?       ;Physical Unit number
151	 0002  ????                  C	SECSIZ  DW      ?       ;Size of physical sector in bytes
152	 0004  ??                    C	CLUSMSK DB      ?       ;Sectors/cluster - 1
153	 0005  ??                    C	CLUSSHFT DB     ?       ;Log2 of sectors/cluster
154	 0006  ????                  C	FIRFAT  DW      ?       ;Starting record of FATs
155	 0008  ??                    C	FATCNT  DB      ?       ;Number of FATs for this drive
156	 0009  ????                  C	MAXENT  DW      ?       ;Number of directory entries
157	 000B  ????                  C	FIRREC  DW      ?       ;First sector of first cluster
158	 000D  ????                  C	MAXCLUS DW      ?       ;Number of clusters on drive + 1
159	 000F  ??                    C	FATSIZ  DB      ?       ;Number of records occupied by FAT
160	 0010  ????                  C	FIRDIR  DW      ?       ;Starting record of directory
161	 0012  ????                  C	FAT     DW      ?       ;Pointer to start of FAT
162	 0014                        C	DPBLOCK ENDS
163	                             C	
164	 = 0014                      C	DPBSIZ  EQU     20      ;Size of the structure in bytes
