1	 	 	 	 	 	TITLE	MS-DOS version 1.25 by 
	 	 	 	Tim Paterson     March 3, 1982
2	 	 	 	 	 	PAGE	60,132
3	 	 	 	 	; Use the following booleans to set the switches 
4	 = 0000	 	 	 	FALSE	EQU	0
5	 =-0001	 	 	 	TRUE	EQU	NOT FALSE
6	 	 	 	 	
7	 	 	 	 	; Use the switches below to produce the standard Microsoft version of the IBM
8	 	 	 	 	; version of the operating system
9	 =	 	 	 	MSVER	EQU	TRUE
10	 =	 	 	 	IBM	EQU	FALSE
11	 	 	 	 	
12	 	 	 	 	; Set this switch to cause DOS to move itself to the end of memory
13	 =	 	 	 	HIGHMEM	EQU	FALSE
14	 	 	 	 	
15	 	 	 	 	; Turn on switch below to allow testing disk code with DEBUG. It sets
16	 	 	 	 	; up a different stack for disk I/O (functions > 11) than that used for
17	 	 	 	 	; character I/O which effectively makes the DOS re-entrant.
18	 	 	 	 	
19	 =	 	 	 	DSKTEST	EQU	FALSE
20	 	 	 	 	
21	                             C	 	INCLUDE	MSDOS.ASM
22	                             C	; 86-DOS  High-performance operating system for the 8086  version 1.25
23	                             C	;       by Tim Paterson
24	                             C	
25	                             C	
26	                             C	; ****************** Revision History *************************
27	                             C	;          >> EVERY change must noted below!! <<
28	                             C	;
29	                             C	; 0.34 12/29/80 General release, updating all past customers
30	                             C	; 0.42 02/25/81 32-byte directory entries added
31	                             C	; 0.56 03/23/81 Variable record and sector sizes
32	                             C	; 0.60 03/27/81 Ctrl-C exit changes, including register save on user stack
33	                             C	; 0.74 04/15/81 Recognize I/O devices with file names
34	                             C	; 0.75 04/17/81 Improve and correct buffer handling
35	                             C	; 0.76 04/23/81 Correct directory size when not 2^N entries
36	                             C	; 0.80 04/27/81 Add console input without echo, Functions 7 & 8
37	                             C	; 1.00 04/28/81 Renumber for general release
38	                             C	; 1.01 05/12/81 Fix bug in `STORE'
39	                             C	; 1.10 07/21/81 Fatal error trapping, NUL device, hidden files, date & time,
40	                             C	;               RENAME fix, general cleanup
41	                             C	; 1.11 09/03/81 Don't set CURRENT BLOCK to 0 on open; fix SET FILE SIZE
42	                             C	; 1.12 10/09/81 Zero high half of CURRENT BLOCK after all (CP/M programs don't)
43	                             C	; 1.13 10/29/81 Fix classic "no write-through" error in buffer handling
44	                             C	; 1.20 12/31/81 Add time to FCB; separate FAT from DPT; Kill SMALLDIR;
45	                             C	;               Add FLUSH and MAPDEV calls; allow disk mapping in DSKCHG;
46	                             C	;               Lots of smaller improvements
47	                             C	; 1.21 01/06/82 HIGHMEM switch to run DOS in high memory
48	                             C	; 1.22 01/12/82 Add VERIFY system call to enable/disable verify after write
49	                             C	; 1.23 02/11/82 Add defaulting to parser; use variable escape character
50	                             C	;               Don't zero extent field in IBM version (back to 1.01!)
51	                             C	; 1.24 03/01/82 Restore fcn. 27 to 1.0 level; add fcn. 28
52	                             C	; 1.25 03/03/82 Put marker (00) at end of directory to speed searches
53	                             C	;
54	                             C	; *************************************************************
