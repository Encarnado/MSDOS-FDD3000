1	 	 	 	 	; I/O system for MS-DOS 1.25 on the Tim
	 	 	 	ex FDD3000 (8086 interpreter).
2	 	 	 	 	;
3	 	 	 	 	; The FDD3000 has a Z80, so this 8086 c
	 	 	 	ode runs on an interpreter. Each
4	 	 	 	 	; device entry is a BIOS trap: opcode 0
	 	 	 	FH (POP CS, unused on a real 8086)
5	 	 	 	 	; followed by a function number. The in
	 	 	 	terpreter does the function in
6	 	 	 	 	; native code (console over the 2FH lin
	 	 	 	k to the TT3000 / TC3256 / TC2068
7	 	 	 	 	; terminal, sectors through the WD177x)
	 	 	 	 and the following RETF returns
8	 	 	 	 	; to MS-DOS.
9	 	 	 	 	;
10	 	 	 	 	; The boot loader (COLD in BIOS.ASM) pu
	 	 	 	ts this file at 0040:0000 and
11	 	 	 	 	; MSDOS.SYS at DOSSEG:0000, then jumps 
	 	 	 	to 0040:0000. Both are hidden files
12	 	 	 	 	; on the disk, after Z86.SYS (the Z80 i
	 	 	 	nterpreter and BIOS).
13	 	 	 	 	
14	 = 0040	 	 	 	BIOSSEG EQU     40H
15	 = 0060	 	 	 	DOSSEG  EQU     60H             ; this 
	 	 	 	file must stay below 512 bytes
16	 	 	 	 	
17	 	 	 	 	ENTRY   MACRO   N
18	 	 	 	 	        DB      0FH,N,0CBH      ; TRAP 
	 	 	 	N / RETF
19	 	 	 	 	        ENDM
20	 	 	 	 	
21	 0000	 	 	 	CODE    SEGMENT
22	 	 	 	 	        ASSUME  CS:CODE,DS:CODE,ES:CODE
	 	 	 	,SS:CODE
23	 0000	 	 	 	        ORG     0
24	 	 	 	 	
25	 0000  EB 2B 90	 	 	        JMP     INIT
26	 	 	 	 	        ENTRY   1               ; STATU
	 	 	 	S  ZF=1 nothing; else ZF=0, AL=char
27	 0003  0F 01 CB               +	        DB      0FH,1,0CBH      ; TRAP 
	 	 	 	N / RETF
28	 	 	 	 	        ENTRY   2               ; INP  
	 	 	 	   AL=char (waits)
29	 0006  0F 02 CB               +	        DB      0FH,2,0CBH      ; TRAP 
	 	 	 	N / RETF
30	 	 	 	 	        ENTRY   3               ; OUTP 
	 	 	 	   AL=char
31	 0009  0F 03 CB               +	        DB      0FH,3,0CBH      ; TRAP 
	 	 	 	N / RETF
32	 	 	 	 	        ENTRY   4               ; PRINT
	 	 	 	   AL=char
33	 000C  0F 04 CB               +	        DB      0FH,4,0CBH      ; TRAP 
	 	 	 	N / RETF
