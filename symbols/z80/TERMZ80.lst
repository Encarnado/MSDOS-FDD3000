F4E0  C8                                RET Z
F4E1  CD B8 F4                          CALL SERPUT
F4E4  23                                INC HL
F4E5  18 F7                             JR SENDS
                                
                                ; SENDN: A (0-255) in decimal to the channel
F4E7  0E 00                     SENDN:  LD C,0
F4E9  06 64                             LD B,100
F4EB  CD F7 F4                          CALL SN1
F4EE  06 0A                             LD B,10
F4F0  CD F7 F4                          CALL SN1
F4F3  C6 30                             ADD A,'0'
F4F5  18 C1                             JR SERPUT
F4F7  16 2F                     SN1:    LD D,'0'-1
F4F9  14                        SN2:    INC D
F4FA  90                                SUB B
F4FB  30 FC                             JR NC,SN2
F4FD  80                                ADD A,B
F4FE  5F                                LD E,A
F4FF  7A                                LD A,D
F500  FE 30                             CP '0'
F502  20 04                             JR NZ,SN3
F504  79                                LD A,C                  ; no leading zeros
F505  B7                                OR A
F506  7B                                LD A,E
F507  C8                                RET Z
F508  7A                        SN3:    LD A,D
F509  CD B8 F4                          CALL SERPUT
F50C  0E 01                             LD C,1
F50E  7B                                LD A,E
F50F  C9                                RET
                                
                                ; ---------------------------------------------------------------- keys
                                ; KEYOUT: a key to the channel. For a VT100 host the arrow keys (the
                                ; terminal sends ESC A-D) become ESC [ A-D (ESC O A-D in cursor key mode);
                                ; an ESC not followed at once by A-D goes alone. With local echo (flag 8)
                                ; a key also goes to the screen, CR as CR LF; not ESC, the arrows, nor
                                ; (VT52 host) the key after an ESC.
F510  32 8C FE                  KEYOUT: LD (KCH),A
F513  3A 64 FE                          LD A,(FLAGS)
F516  0F                                RRCA
F517  38 19                             JR C,KO2
F519  3A 8C FE                          LD A,(KCH)
F51C  FE 1B                             CP 1Bh
F51E  20 12                             JR NZ,KO2
F520  21 20 03                          LD HL,800               ; about 53 ms
F523  CD D8 F3                  KO1:    CALL RXPOLL
F526  E5                                PUSH HL
F527  CD E3 EB                          CALL PEEKEY
F52A  E1                                POP HL
F52B  38 38                             JR C,KO3
F52D  2B                                DEC HL
F52E  7C                                LD A,H
F52F  B5                                OR L
F530  20 F1                             JR NZ,KO1
F532  3A 8C FE                  KO2:    LD A,(KCH)
F535  CD B8 F4                          CALL SERPUT
F538  21 8D FE                          LD HL,KLAST
F53B  46                                LD B,(HL)               ; the key before
F53C  3A 8C FE                          LD A,(KCH)
F53F  77                                LD (HL),A
F540  3A 64 FE                          LD A,(FLAGS)
F543  CB 5F                             BIT 3,A
F545  C8                                RET Z
F546  0F                                RRCA
F547  30 04                             JR NC,KO5
F549  78                                LD A,B
F54A  FE 1B                             CP 1Bh
F54C  C8                                RET Z
F54D  3A 8C FE                  KO5:    LD A,(KCH)
F550  FE 1B                             CP 1Bh
F552  C8                                RET Z
F553  FE 0D                             CP 0Dh
F555  20 0B                             JR NZ,KO6
F557  CD CA F9                          CALL EMUL               ; (with flag 10h it has added the LF)
F55A  3A 64 FE                          LD A,(FLAGS)
F55D  E6 10                             AND 10h
F55F  C0                                RET NZ
F560  3E 0A                             LD A,0Ah
F562  C3 CA F9                  KO6:    JP EMUL
F565  D6 41                     KO3:    SUB 'A'
F567  FE 04                             CP 4
F569  30 C7                             JR NC,KO2               ; not an arrow: it stays for SESS
F56B  CD 00 EC                          CALL GETKEY
F56E  32 8C FE                          LD (KCH),A
F571  3E 1B                             LD A,1Bh
F573  CD B8 F4                          CALL SERPUT
F576  3A 78 FE                          LD A,(CKM)
F579  B7                                OR A
F57A  3E 5B                             LD A,'['
F57C  28 02                             JR Z,KO4
F57E  3E 4F                             LD A,'O'
F580  CD B8 F4                  KO4:    CALL SERPUT
F583  3A 8C FE                          LD A,(KCH)
F586  C3 B8 F4                          JP SERPUT
                                
                                ; ---------------------------------------------------------------- the terminal
                                ; TOUT: A to the terminal, as the BIOS's CONOUT, but taking received
                                ; bytes while the terminal is busy. Keeps BC, DE, HL.
F589  C5                        TOUT:   PUSH BC
F58A  D5                                PUSH DE
F58B  32 8B FE                          LD (TOCH),A
F58E  3A 8B FE                  TO1:    LD A,(TOCH)
F591  47                                LD B,A
F592  CD A7 F5                          CALL TSEND
F595  28 0D                             JR Z,TO3
F597  CD D8 F3                  TO2:    CALL RXPOLL             ; timed out: wait for the terminal's abort
F59A  DB 2F                             IN A,(2Fh)
F59C  E6 5F                             AND 5Fh
F59E  FE 07                             CP 07h
F5A0  20 F5                             JR NZ,TO2
F5A2  18 EA                             JR TO1
F5A4  D1                        TO3:    POP DE
F5A5  C1                                POP BC
F5A6  C9                                RET
                                
                                ; TSEND: B in two nibbles, each echoed back (BIOS COSEND, but taking
                                ; received bytes while the echo is awaited). Z = sent.
F5A7  78                        TSEND:  LD A,B
F5A8  E6 0F                             AND 0Fh
F5AA  5F                                LD E,A
F5AB  78                                LD A,B
F5AC  0F                                RRCA
F5AD  0F                                RRCA
F5AE  0F                                RRCA
F5AF  0F                                RRCA
F5B0  E6 0F                             AND 0Fh
F5B2  57                                LD D,A
F5B3  CD D8 F3                  TS1:    CALL RXPOLL
F5B6  3E 0A                             LD A,0Ah                ; ask to send
F5B8  D3 2F                             OUT (2Fh),A
F5BA  DB 2F                             IN A,(2Fh)
F5BC  E6 5F                             AND 5Fh
F5BE  FE 0F                             CP 0Fh                  ; terminal ready
F5C0  20 F1                             JR NZ,TS1
F5C2  7B                                LD A,E
F5C3  F6 10                             OR 10h
F5C5  D3 2F                             OUT (2Fh),A
F5C7  47                                LD B,A
F5C8  0E 00                             LD C,0
F5CA  CD D8 F3                  TS2:    CALL RXPOLL
F5CD  DB 2F                             IN A,(2Fh)
F5CF  0D                                DEC C
F5D0  28 20                             JR Z,TS4
F5D2  E6 5F                             AND 5Fh
F5D4  B8                                CP B
F5D5  20 F3                             JR NZ,TS2
F5D7  7A                                LD A,D
F5D8  F6 40                             OR 40h
F5DA  D3 2F                             OUT (2Fh),A
F5DC  47                                LD B,A
F5DD  0E 00                             LD C,0
F5DF  CD D8 F3                  TS3:    CALL RXPOLL
F5E2  DB 2F                             IN A,(2Fh)
F5E4  0D                                DEC C
F5E5  28 0B                             JR Z,TS4
F5E7  E6 5F                             AND 5Fh
F5E9  B8                                CP B
F5EA  20 F3                             JR NZ,TS3
F5EC  3E 50                             LD A,50h                ; done
F5EE  D3 2F                             OUT (2Fh),A
F5F0  AF                                XOR A
F5F1  C9                                RET
F5F2  3E 07                     TS4:    LD A,07h                ; abort
F5F4  D3 2F                             OUT (2Fh),A
F5F6  A7                                AND A
F5F7  C9                                RET
                                
                                ; TESC: ESC, then A
F5F8  F5                        TESC:   PUSH AF
F5F9  3E 1B                             LD A,1Bh
F5FB  CD 89 F5                          CALL TOUT
F5FE  F1                                POP AF
F5FF  18 88                             JR TOUT
                                
                                ; TGOTO: the terminal's cursor to row D, column E. Uses A.
F601  3A 88 FE                  TGOTO:  LD A,(TROW)
F604  BA                                CP D
F605  20 05                             JR NZ,TG1
F607  3A 89 FE                          LD A,(TCOL)
F60A  BB                                CP E
F60B  C8                                RET Z
F60C  3E 59                     TG1:    LD A,'Y'
F60E  CD F8 F5                          CALL TESC
F611  7A                                LD A,D
F612  C6 20                             ADD A,32
F614  CD 89 F5                          CALL TOUT
F617  7B                                LD A,E
F618  C6 20                             ADD A,32
F61A  CD 89 F5                          CALL TOUT
F61D  7A                                LD A,D
F61E  32 88 FE                          LD (TROW),A
F621  7B                                LD A,E
F622  32 89 FE                          LD (TCOL),A
F625  C9                                RET
                                
                                ; TSYNC: the terminal's cursor to the screen's
F626  3A 70 FE                  TSYNC:  LD A,(CROW)
F629  57                                LD D,A
F62A  3A 71 FE                          LD A,(CCOL)
F62D  5F                                LD E,A
F62E  18 D1                             JR TGOTO
                                
                                ; TSETA: the terminal's attribute to A (0 normal, 80h inverse). Uses A.
F630  E5                        TSETA:  PUSH HL
F631  21 8A FE                          LD HL,TATTR
F634  BE                                CP (HL)
F635  28 0B                             JR Z,TSA2
F637  77                                LD (HL),A
F638  B7                                OR A
F639  3E 4D                             LD A,'M'
F63B  28 02                             JR Z,TSA1
F63D  3E 4C                             LD A,'L'
F63F  CD F8 F5                  TSA1:   CALL TESC
F642  E1                        TSA2:   POP HL
F643  C9                                RET
                                
                                ; TPUT: cell A (character, bit 7 inverse) at row D, column E on the
                                ; terminal; not the bottom right one. Uses A.
F644  F5                        TPUT:   PUSH AF
F645  3A 63 FE                          LD A,(ROWS)
F648  3D                                DEC A
F649  BA                                CP D
F64A  20 09                             JR NZ,TP1
F64C  3A 62 FE                          LD A,(COLS)
F64F  3D                                DEC A
F650  BB                                CP E
F651  20 02                             JR NZ,TP1
F653  F1                                POP AF
F654  C9                                RET
F655  CD 01 F6                  TP1:    CALL TGOTO
F658  F1                                POP AF
F659  F5                                PUSH AF
F65A  E6 80                             AND 80h
F65C  CD 30 F6                          CALL TSETA
F65F  F1                                POP AF
F660  E6 7F                             AND 7Fh
F662  CD 89 F5                          CALL TOUT
F665  3A 89 FE                          LD A,(TCOL)
F668  3C                                INC A
F669  32 89 FE                          LD (TCOL),A
F66C  E5                                PUSH HL
F66D  21 62 FE                          LD HL,COLS
F670  BE                                CP (HL)
F671  E1                                POP HL
F672  C0                                RET NZ
F673  AF                                XOR A                   ; the terminal wrapped
F674  32 89 FE                          LD (TCOL),A
F677  3A 88 FE                          LD A,(TROW)
F67A  3C                                INC A
F67B  32 88 FE                          LD (TROW),A
F67E  C9                                RET
                                
                                ; CLRK: from row D, column E to the end of the line on the terminal
F67F  CD 01 F6                  CLRK:   CALL TGOTO
F682  AF                                XOR A
F683  CD 30 F6                          CALL TSETA
F686  3E 4B                             LD A,'K'
F688  C3 F8 F5                          JR TESC
                                
                                ; DRAWR: row D from column E on the terminal, from the shadow. Uses all.
F68B  CD D8 F3                  DRAWR:  CALL RXPOLL             ; (a row may follow a row, or a scroll)
F68E  3A 62 FE                          LD A,(COLS)
F691  3D                                DEC A
F692  4F                                LD C,A                  ; C = the last column to draw
F693  3A 63 FE                          LD A,(ROWS)
F696  3D                                DEC A
F697  BA                                CP D
F698  20 01                             JR NZ,DR1
F69A  0D                                DEC C
F69B  79                        DR1:    LD A,C
F69C  BB                                CP E
F69D  38 E0                             JR C,CLRK
F69F  D5                                PUSH DE
F6A0  59                                LD E,C
F6A1  CD F7 F6                          CALL CELLP
F6A4  D1                                POP DE
F6A5  41                                LD B,C
F6A6  7E                        DR2:    LD A,(HL)               ; the last cell that is not blank
F6A7  FE 20                             CP ' '
F6A9  20 0D                             JR NZ,DR3
F6AB  78                                LD A,B
F6AC  BB                                CP E
F6AD  28 D0                             JR Z,CLRK               ; all blank
F6AF  E6 07                             AND 7                   ; every 8 cells (a blank cell: 75 T)
F6B1  CC D8 F3                          CALL Z,RXPOLL
F6B4  2B                                DEC HL
F6B5  05                                DEC B
F6B6  18 EE                             JR DR2
F6B8  C5                        DR3:    PUSH BC
F6B9  CD F7 F6                          CALL CELLP
F6BC  C1                                POP BC
F6BD  7E                        DR4:    LD A,(HL)
F6BE  CD 44 F6                          CALL TPUT
F6C1  23                                INC HL
F6C2  7B                                LD A,E
F6C3  1C                                INC E
F6C4  B8                                CP B
F6C5  20 F6                             JR NZ,DR4
F6C7  79                                LD A,C
F6C8  BB                                CP E
F6C9  D8                                RET C
F6CA  18 B3                             JR CLRK
                                
                                ; REDR: rows B to C on the terminal, from the shadow. Uses all.
F6CC  50                        REDR:   LD D,B
F6CD  C5                        QRD1:   PUSH BC
F6CE  D5                                PUSH DE
F6CF  1E 00                             LD E,0
F6D1  CD 8B F6                          CALL DRAWR
F6D4  D1                                POP DE
F6D5  C1                                POP BC
F6D6  7A                                LD A,D
F6D7  B9                                CP C
F6D8  C8                                RET Z
F6D9  14                                INC D
F6DA  18 F1                             JR QRD1
                                
                                ; ---------------------------------------------------------------- the shadow
                                ; ROWP: HL = row A. CELLP: HL = row D, column E. Use A.
F6DC  D5                        ROWP:   PUSH DE                 ; COLS is 64 or 80: A x 64 (+ A x 16)
F6DD  6F                                LD L,A
F6DE  26 00                             LD H,0
F6E0  29                                ADD HL,HL
F6E1  29                                ADD HL,HL
F6E2  29                                ADD HL,HL
F6E3  29                                ADD HL,HL
F6E4  54                                LD D,H
F6E5  5D                                LD E,L
F6E6  29                                ADD HL,HL
F6E7  29                                ADD HL,HL
F6E8  3A 62 FE                          LD A,(COLS)
F6EB  FE 40                             CP 64
F6ED  28 01                             JR Z,RP1
F6EF  19                                ADD HL,DE
F6F0  ED 5B 66 FE               RP1:    LD DE,(SCR)
F6F4  19                                ADD HL,DE
F6F5  D1                                POP DE
F6F6  C9                                RET
F6F7  7A                        CELLP:  LD A,D
F6F8  CD DC F6                          CALL ROWP
F6FB  7B                                LD A,E
F6FC  85                        ADDHLA: ADD A,L
F6FD  6F                                LD L,A
F6FE  D0                                RET NC
F6FF  24                                INC H
F700  C9                                RET
F701  D5                        SUBHLA: PUSH DE
F702  5F                                LD E,A
F703  16 00                             LD D,0
F705  B7                                OR A
F706  ED 52                             SBC HL,DE
F708  D1                                POP DE
F709  C9                                RET
                                
