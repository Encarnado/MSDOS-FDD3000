                                ; ENSURE: the host let go and the RTS line on, for a transfer
F3BB  AF                        ENSURE: XOR A
F3BC  32 95 FE                          LD (HOLDF),A
F3BF  3A 94 FE                          LD A,(STOPF)
F3C2  B7                                OR A
