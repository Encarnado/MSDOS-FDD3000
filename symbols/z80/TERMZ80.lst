F74F  CD 57 F7                          CALL MVSUB
F752  18 EB                             JR MVB
F754  ED B8                     MVB2:   LDDR
F756  C9                                RET
F757  79                        MVSUB:  LD A,C
F758  D6 20                             SUB 32
F75A  4F                                LD C,A
F75B  30 01                             JR NC,MVS1
F75D  05                                DEC B
F75E  C3 E8 F3                  MVS1:   JP RXPOLL
                                
