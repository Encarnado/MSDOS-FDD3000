F4D6  0D                        QSP2:   DEC C
F4D7  ED 59                             OUT (C),E
F4D9  B7                                OR A
F4DA  E1                        SP3:    POP HL
F4DB  D1                                POP DE
F4DC  C1                                POP BC
F4DD  C9                                RET
                                
                                ; SENDS: the 0-terminated string at HL to the channel
F4DE  7E                        SENDS:  LD A,(HL)
