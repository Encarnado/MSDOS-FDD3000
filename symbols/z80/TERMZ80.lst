F2F1  E6 38                     FR5:    AND 38h
F2F3  28 07                             JR Z,FR51
F2F5  3A A4 FE                          LD A,(CMDV)
F2F8  F6 10                             OR 10h
F2FA  ED 79                             OUT (C),A
F2FC  0D                        FR51:   DEC C
F2FD  ED 78                             IN A,(C)
F2FF  21 64 00                  FR6:    LD HL,100
F302  22 B4 FE                          LD (TMO),HL
F305  2A B2 FE                          LD HL,(RCNT)
F308  E5                                PUSH HL
F309  ED 5B 0E D0                       LD DE,(R_DI)
F30D  19                                ADD HL,DE
F30E  77                                LD (HL),A
F30F  E1                                POP HL
F310  23                                INC HL
F311  22 B2 FE                          LD (RCNT),HL
