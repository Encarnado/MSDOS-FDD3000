F372  3A 74 FE                  F_MODE: LD A,(FLAGS)
F375  E6 E7                             AND 0E7h
F377  47                                LD B,A
F378  3A 04 D0                          LD A,(R_DL)
F37B  E6 18                             AND 18h
F37D  B0                                OR B
F37E  32 74 FE                          LD (FLAGS),A
