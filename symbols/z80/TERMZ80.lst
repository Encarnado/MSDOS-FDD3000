F721  01 20 00                          LD BC,32
F724  ED B0                             LDIR
F726  C1                                POP BC
F727  CD 47 F7                          CALL MVSUB
F72A  18 EB                             JR MVF
F72C  ED B0                     MVF2:   LDIR
F72E  C9                                RET
F72F  78                        MVB:    LD A,B
F730  B7                                OR A
F731  20 05                             JR NZ,MVB1
F733  79                                LD A,C
F734  FE 21                             CP 33
F736  38 0C                             JR C,MVB2
F738  C5                        MVB1:   PUSH BC
F739  01 20 00                          LD BC,32
F73C  ED B8                             LDDR
F73E  C1                                POP BC
F73F  CD 47 F7                          CALL MVSUB
F742  18 EB                             JR MVB
F744  ED B8                     MVB2:   LDDR
F746  C9                                RET
F747  79                        MVSUB:  LD A,C
F748  D6 20                             SUB 32
F74A  4F                                LD C,A
F74B  30 01                             JR NC,MVS1
F74D  05                                DEC B
F74E  C3 D8 F3                  MVS1:   JP RXPOLL
                                
                                ; FILL: BC cells at HL blank. Uses A, BC, DE, HL.
F751  78                        FILL:   LD A,B
F752  B1                                OR C
F753  C8                                RET Z
F754  36 20                             LD (HL),' '
F756  0B                                DEC BC
F757  78                                LD A,B
F758  B1                                OR C
F759  C8                                RET Z
F75A  54                                LD D,H
F75B  5D                                LD E,L
F75C  13                                INC DE
F75D  CD 17 F7                          CALL MVF
F760  C9                                RET
                                
                                ; SHUP / SHDN: rows RT to RB of the shadow one up / down; the row that
                                ; comes in is blank. Use all.
F761  CD D8 F3                  SHUP:   CALL RXPOLL             ; a byte may have come since the last
F764  3A 8E FE                          LD A,(RT)
F767  CD DC F6                          CALL ROWP
F76A  EB                                EX DE,HL
F76B  CD AF F7                          CALL RCOUNT
F76E  3A 62 FE                          LD A,(COLS)
F771  6F                                LD L,A
F772  26 00                             LD H,0
F774  19                                ADD HL,DE
F775  78                                LD A,B
F776  B1                                OR C
F777  28 03                             JR Z,SHU1
F779  CD 17 F7                          CALL MVF
F77C  EB                        SHU1:   EX DE,HL
F77D  18 28                             JR FILLRW
F77F  CD D8 F3                  SHDN:   CALL RXPOLL
F782  CD AF F7                          CALL RCOUNT
F785  3A 8F FE                          LD A,(RB)
F788  CD DC F6                          CALL ROWP
F78B  3A 62 FE                          LD A,(COLS)
F78E  3D                                DEC A
F78F  CD FC F6                          CALL ADDHLA
F792  54                                LD D,H
F793  5D                                LD E,L
F794  3A 62 FE                          LD A,(COLS)
F797  CD 01 F7                          CALL SUBHLA
F79A  78                                LD A,B
F79B  B1                                OR C
F79C  28 03                             JR Z,SHD1
F79E  CD 2F F7                          CALL MVB
