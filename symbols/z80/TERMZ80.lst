                                ; ---------------------------------------------------------------- the channel
                                ; RXPOLL: a received byte, if there is one, to the ring; a queued XON /
                                ; XOFF out when the transmitter is free. Changes nothing but the flags.
F3D8  F5                        RXPOLL: PUSH AF
F3D9  D9                                EXX
F3DA  3A 61 FE                          LD A,(CTL)
F3DD  4F                                LD C,A
F3DE  ED 40                             IN B,(C)
F3E0  3A 93 FE                          LD A,(TXQ)
F3E3  B7                                OR A
F3E4  28 10                             JR Z,RXP1
F3E6  5F                                LD E,A
F3E7  78                                LD A,B
F3E8  E6 81                             AND 81h                 ; TxRDY, CTS
F3EA  FE 81                             CP 81h
F3EC  20 08                             JR NZ,RXP1
F3EE  0D                                DEC C
F3EF  ED 59                             OUT (C),E
F3F1  0C                                INC C
F3F2  AF                                XOR A
F3F3  32 93 FE                          LD (TXQ),A
F3F6  CB 48                     RXP1:   BIT 1,B                 ; RxRDY
F3F8  28 48                             JR Z,RXP9
F3FA  78                                LD A,B
F3FB  E6 38                             AND 38h                 ; framing, overrun, parity
F3FD  28 12                             JR Z,RXP3
F3FF  E6 10                             AND 10h
F401  28 07                             JR Z,RXP2
F403  2A 9D FE                          LD HL,(LOST)            ; overrun: at least one byte lost
F406  23                                INC HL
F407  22 9D FE                          LD (LOST),HL
F40A  3A 92 FE                  RXP2:   LD A,(CMDV)
F40D  F6 10                             OR 10h                  ; error reset
F40F  ED 79                             OUT (C),A
F411  0D                        RXP3:   DEC C
F412  ED 58                             IN E,(C)
F414  2A 99 FE                          LD HL,(RHEAD)
F417  E5                                PUSH HL
F418  ED 4B 68 FE                       LD BC,(RING)
F41C  09                                ADD HL,BC
F41D  73                                LD (HL),E
F41E  E1                                POP HL
F41F  23                                INC HL
F420  7C                                LD A,H
F421  E6 07                             AND RINGM
F423  67                                LD H,A
F424  ED 4B 9B FE                       LD BC,(RTAIL)
F428  B7                                OR A
F429  ED 42                             SBC HL,BC
F42B  28 0E                             JR Z,RXP4               ; full: the byte is lost
F42D  7C                                LD A,H                  ; the level with this byte, x 256
F42E  09                                ADD HL,BC
F42F  22 99 FE                          LD (RHEAD),HL
F432  E6 07                             AND RINGM
F434  FE 04                             CP HIWAT
F436  D4 73 F4                          CALL NC,STOP
F439  18 07                             JR RXP9
F43B  2A 9D FE                  RXP4:   LD HL,(LOST)
