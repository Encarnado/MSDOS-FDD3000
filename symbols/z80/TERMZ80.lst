F7A4  CD DC F6                          CALL ROWP
F7A7  3A 62 FE                  FILLRW: LD A,(COLS)
F7AA  4F                                LD C,A
F7AB  06 00                             LD B,0
F7AD  18 A2                             JR FILL
F7AF  3A 8F FE                  RCOUNT: LD A,(RB)
F7B2  21 8E FE                          LD HL,RT
F7B5  96                                SUB (HL)
F7B6  C3 0A F7                          JR NROWS
                                
