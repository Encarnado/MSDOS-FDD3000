                                ; ENSURE: the host let go and the RTS line on, for a transfer
F3CB  AF                        ENSURE: XOR A
F3CC  32 A7 FE                          LD (HOLDF),A
F3CF  3A A6 FE                          LD A,(STOPF)
F3D2  B7                                OR A
F3D3  C8                                RET Z
F3D4  CD A2 F4                          CALL RESUME
F3D7  21 00 00                          LD HL,0
F3DA  CD E8 F3                  EN1:    CALL RXPOLL             ; until the XON has gone
F3DD  3A A5 FE                          LD A,(TXQ)
F3E0  B7                                OR A
F3E1  C8                                RET Z
F3E2  2B                                DEC HL
F3E3  7C                                LD A,H
F3E4  B5                                OR L
F3E5  20 F3                             JR NZ,EN1
F3E7  C9                                RET
                                
                                ; ---------------------------------------------------------------- the channel
                                ; RXPOLL: a received byte, if there is one, to the ring; a queued XON /
                                ; XOFF out when the transmitter is free. Changes nothing but the flags.
F3E8  F5                        RXPOLL: PUSH AF
F3E9  D9                                EXX
F3EA  3A 71 FE                          LD A,(CTL)
F3ED  4F                                LD C,A
F3EE  ED 40                             IN B,(C)
F3F0  3A A5 FE                          LD A,(TXQ)
F3F3  B7                                OR A
F3F4  28 10                             JR Z,RXP1
F3F6  5F                                LD E,A
F3F7  78                                LD A,B
F3F8  E6 81                             AND 81h                 ; TxRDY, CTS
F3FA  FE 81                             CP 81h
F3FC  20 08                             JR NZ,RXP1
F3FE  0D                                DEC C
F3FF  ED 59                             OUT (C),E
F401  0C                                INC C
F402  AF                                XOR A
F403  32 A5 FE                          LD (TXQ),A
F406  CB 48                     RXP1:   BIT 1,B                 ; RxRDY
F408  28 48                             JR Z,RXP9
F40A  78                                LD A,B
F40B  E6 38                             AND 38h                 ; framing, overrun, parity
F40D  28 12                             JR Z,RXP3
F40F  E6 10                             AND 10h
F411  28 07                             JR Z,RXP2
F413  2A AF FE                          LD HL,(LOST)            ; overrun: at least one byte lost
F416  23                                INC HL
F417  22 AF FE                          LD (LOST),HL
F41A  3A A4 FE                  RXP2:   LD A,(CMDV)
F41D  F6 10                             OR 10h                  ; error reset
F41F  ED 79                             OUT (C),A
F421  0D                        RXP3:   DEC C
F422  ED 58                             IN E,(C)
F424  2A AB FE                          LD HL,(RHEAD)
F427  E5                                PUSH HL
F428  ED 4B 78 FE                       LD BC,(RING)
F42C  09                                ADD HL,BC
F42D  73                                LD (HL),E
F42E  E1                                POP HL
F42F  23                                INC HL
F430  7C                                LD A,H
F431  E6 07                             AND RINGM
F433  67                                LD H,A
F434  ED 4B AD FE                       LD BC,(RTAIL)
F438  B7                                OR A
F439  ED 42                             SBC HL,BC
F43B  28 0E                             JR Z,RXP4               ; full: the byte is lost
F43D  7C                                LD A,H                  ; the level, less one
F43E  09                                ADD HL,BC
F43F  22 AB FE                          LD (RHEAD),HL
F442  E6 07                             AND RINGM
F444  FE 04                             CP HIWAT
F446  D4 83 F4                          CALL NC,STOP
F449  18 07                             JR RXP9
F44B  2A AF FE                  RXP4:   LD HL,(LOST)
F44E  23                                INC HL
F44F  22 AF FE                          LD (LOST),HL
F452  D9                        RXP9:   EXX
F453  F1                                POP AF
F454  C9                                RET
                                
                                ; RGET: CF=1 and A = the next byte in the ring; CF=0: none. Uses DE, HL.
F455  2A AD FE                  RGET:   LD HL,(RTAIL)
F458  ED 5B AB FE                       LD DE,(RHEAD)
F45C  B7                                OR A
F45D  ED 52                             SBC HL,DE
F45F  C8                                RET Z
F460  19                                ADD HL,DE
F461  EB                                EX DE,HL
F462  2A 78 FE                          LD HL,(RING)
F465  19                                ADD HL,DE
F466  7E                                LD A,(HL)
F467  13                                INC DE
F468  F5                                PUSH AF
F469  7A                                LD A,D
F46A  E6 07                             AND RINGM
F46C  57                                LD D,A
F46D  ED 53 AD FE                       LD (RTAIL),DE
F471  F1                                POP AF
F472  37                                SCF
F473  C9                                RET
                                
                                ; LEVEL: HL = bytes in the ring. Uses DE.
F474  2A AB FE                  LEVEL:  LD HL,(RHEAD)
F477  ED 5B AD FE                       LD DE,(RTAIL)
F47B  B7                                OR A
F47C  ED 52                             SBC HL,DE
F47E  7C                                LD A,H
F47F  E6 07                             AND RINGM
F481  67                                LD H,A
F482  C9                                RET
                                
                                ; STOP / RESUME: ask the host to stop / go on (XOFF / XON, RTS)
F483  3A A6 FE                  STOP:   LD A,(STOPF)
F486  B7                                OR A
F487  C0                                RET NZ
F488  3C                                INC A
F489  32 A6 FE                          LD (STOPF),A
F48C                            FLOWOFF:
F48C  3A 74 FE                          LD A,(FLAGS)
F48F  CB 4F                             BIT 1,A
F491  28 05                             JR Z,ST1
F493  3E 13                             LD A,13h                ; XOFF
F495  32 A5 FE                          LD (TXQ),A
F498  3A 74 FE                  ST1:    LD A,(FLAGS)
F49B  CB 57                             BIT 2,A
F49D  C8                                RET Z
F49E  3E 07                             LD A,07h                ; RTS off
F4A0  18 16                             JR CMDSET
F4A2  3A A7 FE                  RESUME: LD A,(HOLDF)
F4A5  B7                                OR A
F4A6  C0                                RET NZ
F4A7  32 A6 FE                          LD (STOPF),A
F4AA  3A 74 FE                          LD A,(FLAGS)
F4AD  CB 4F                             BIT 1,A
F4AF  28 05                             JR Z,RS1
F4B1  3E 11                             LD A,11h                ; XON
F4B3  32 A5 FE                          LD (TXQ),A
F4B6  3E 27                     RS1:    LD A,27h
F4B8  32 A4 FE                  CMDSET: LD (CMDV),A
F4BB  3A A4 FE                  CMDOUT: LD A,(CMDV)
F4BE  C5                        CMDA:   PUSH BC
F4BF  47                                LD B,A
F4C0  3A 71 FE                          LD A,(CTL)
F4C3  4F                                LD C,A
F4C4  ED 41                             OUT (C),B
F4C6  C1                                POP BC
F4C7  C9                                RET
                                
                                ; SERPUT: A to the channel, when it is free and CTS on (status bit 7: the
                                ; WD2123 has no DSR), taking received bytes meanwhile. CF=1: CTS stayed
                                ; off for about 2 s and the byte was dropped.
F4C8  C5                        SERPUT: PUSH BC
F4C9  D5                                PUSH DE
F4CA  E5                                PUSH HL
F4CB  5F                                LD E,A
F4CC  21 00 00                          LD HL,0
F4CF  CD E8 F3                  QSP1:   CALL RXPOLL
F4D2  3A 71 FE                          LD A,(CTL)
F4D5  4F                                LD C,A
F4D6  ED 78                             IN A,(C)
F4D8  E6 81                             AND 81h
F4DA  FE 81                             CP 81h
F4DC  28 11                             JR Z,QSP2
F4DE  2B                                DEC HL
F4DF  7C                                LD A,H
F4E0  B5                                OR L
F4E1  20 EC                             JR NZ,QSP1
F4E3  3A B1 FE                          LD A,(DROPS)
F4E6  3C                                INC A
F4E7  28 03                             JR Z,SP0
F4E9  32 B1 FE                          LD (DROPS),A
F4EC  37                        SP0:    SCF
F4ED  18 04                             JR SP3
F4EF  0D                        QSP2:   DEC C
F4F0  ED 59                             OUT (C),E
F4F2  B7                                OR A
F4F3  E1                        SP3:    POP HL
F4F4  D1                                POP DE
F4F5  C1                                POP BC
F4F6  C9                                RET
                                
                                ; SENDS: the 0-terminated string at HL to the channel
F4F7  7E                        SENDS:  LD A,(HL)
F4F8  B7                                OR A
F4F9  C8                                RET Z
F4FA  CD C8 F4                          CALL SERPUT
F4FD  23                                INC HL
F4FE  18 F7                             JR SENDS
                                
                                ; SENDN: A (1-255) in decimal to the channel
F500  0E 00                     SENDN:  LD C,0
F502  06 64                             LD B,100
F504  CD 10 F5                          CALL SN1
F507  06 0A                             LD B,10
F509  CD 10 F5                          CALL SN1
F50C  C6 30                             ADD A,'0'
F50E  18 B8                             JR SERPUT
F510  16 2F                     SN1:    LD D,'0'-1
F512  14                        SN2:    INC D
F513  90                                SUB B
F514  30 FC                             JR NC,SN2
F516  80                                ADD A,B
F517  5F                                LD E,A
F518  7A                                LD A,D
F519  FE 30                             CP '0'
F51B  20 04                             JR NZ,SN3
F51D  79                                LD A,C                  ; no leading zeros
F51E  B7                                OR A
F51F  7B                                LD A,E
F520  C8                                RET Z
F521  7A                        SN3:    LD A,D
F522  CD C8 F4                          CALL SERPUT
F525  0E 01                             LD C,1
F527  7B                                LD A,E
F528  C9                                RET
                                
                                ; ---------------------------------------------------------------- keys
                                ; KEYOUT: a key to the channel. For a VT100 host the arrow keys (the
                                ; terminal sends ESC A-D) become ESC [ A-D (ESC O A-D in cursor key mode);
                                ; an ESC not followed at once by A-D goes alone. With local echo (flag 8)
                                ; a key also goes to the screen, CR as CR LF; not ESC, the arrows, nor
                                ; (VT52 host) the key after an ESC.
F529  32 9E FE                  KEYOUT: LD (KCH),A
F52C  3A 74 FE                          LD A,(FLAGS)
F52F  0F                                RRCA
F530  38 19                             JR C,KO2
F532  3A 9E FE                          LD A,(KCH)
F535  FE 1B                             CP 1Bh
F537  20 12                             JR NZ,KO2
F539  21 20 03                          LD HL,800               ; about 40 ms
F53C  CD E8 F3                  KO1:    CALL RXPOLL
F53F  E5                                PUSH HL
F540  CD F6 EB                          CALL PEEKEY
F543  E1                                POP HL
F544  38 38                             JR C,KO3
F546  2B                                DEC HL
F547  7C                                LD A,H
F548  B5                                OR L
F549  20 F1                             JR NZ,KO1
F54B  3A 9E FE                  KO2:    LD A,(KCH)
F54E  CD C8 F4                          CALL SERPUT
F551  21 9F FE                          LD HL,KLAST
F554  46                                LD B,(HL)               ; the key before
F555  3A 9E FE                          LD A,(KCH)
F558  77                                LD (HL),A
F559  3A 74 FE                          LD A,(FLAGS)
F55C  CB 5F                             BIT 3,A
F55E  C8                                RET Z
F55F  0F                                RRCA
F560  30 04                             JR NC,KO5
F562  78                                LD A,B
F563  FE 1B                             CP 1Bh
F565  C8                                RET Z
F566  3A 9E FE                  KO5:    LD A,(KCH)
F569  FE 1B                             CP 1Bh
F56B  C8                                RET Z
F56C  FE 0D                             CP 0Dh
F56E  20 0B                             JR NZ,KO6
F570  CD DA F9                          CALL EMUL               ; (with flag 10h it has added the LF)
F573  3A 74 FE                          LD A,(FLAGS)
F576  E6 10                             AND 10h
F578  C0                                RET NZ
F579  3E 0A                             LD A,0Ah
F57B  C3 DA F9                  KO6:    JP EMUL
F57E  D6 41                     KO3:    SUB 'A'
F580  FE 04                             CP 4
F582  30 C7                             JR NC,KO2               ; not an arrow: it stays for SESS
F584  CD 13 EC                          CALL GETKEY
F587  32 9E FE                          LD (KCH),A
F58A  3E 1B                             LD A,1Bh
F58C  CD C8 F4                          CALL SERPUT
F58F  3A 8A FE                          LD A,(CKM)
F592  B7                                OR A
F593  3E 5B                             LD A,'['
F595  28 02                             JR Z,KO4
F597  3E 4F                             LD A,'O'
F599  CD C8 F4                  KO4:    CALL SERPUT
F59C  3A 9E FE                          LD A,(KCH)
F59F  C3 C8 F4                          JP SERPUT
                                
                                ; ---------------------------------------------------------------- the terminal
                                ; TOUT: A to the terminal, as the BIOS's CONOUT, but taking received
                                ; bytes while the terminal is busy. Keeps BC, DE, HL.
F5A2  C5                        TOUT:   PUSH BC
F5A3  D5                                PUSH DE
F5A4  32 9D FE                          LD (TOCH),A
F5A7  3A 9D FE                  TO1:    LD A,(TOCH)
F5AA  47                                LD B,A
F5AB  CD C0 F5                          CALL TSEND
F5AE  28 0D                             JR Z,TO3
F5B0  CD E8 F3                  TO2:    CALL RXPOLL             ; timed out: wait for the terminal's abort
F5B3  DB 2F                             IN A,(2Fh)
F5B5  E6 5F                             AND 5Fh
F5B7  FE 07                             CP 07h
F5B9  20 F5                             JR NZ,TO2
F5BB  18 EA                             JR TO1
F5BD  D1                        TO3:    POP DE
F5BE  C1                                POP BC
F5BF  C9                                RET
                                
                                ; TSEND: B in two nibbles, each echoed back (BIOS COSEND). Z = sent.
F5C0  78                        TSEND:  LD A,B
F5C1  E6 0F                             AND 0Fh
F5C3  5F                                LD E,A
F5C4  78                                LD A,B
F5C5  0F                                RRCA
F5C6  0F                                RRCA
F5C7  0F                                RRCA
F5C8  0F                                RRCA
F5C9  E6 0F                             AND 0Fh
F5CB  57                                LD D,A
F5CC  CD E8 F3                  TS1:    CALL RXPOLL
F5CF  3E 0A                             LD A,0Ah                ; ask to send
F5D1  D3 2F                             OUT (2Fh),A
F5D3  DB 2F                             IN A,(2Fh)
F5D5  E6 5F                             AND 5Fh
F5D7  FE 0F                             CP 0Fh                  ; terminal ready
F5D9  20 F1                             JR NZ,TS1
F5DB  7B                                LD A,E
F5DC  F6 10                             OR 10h
F5DE  D3 2F                             OUT (2Fh),A
F5E0  47                                LD B,A
F5E1  0E 00                             LD C,0
F5E3  DB 2F                     TS2:    IN A,(2Fh)
F5E5  0D                                DEC C
F5E6  28 1D                             JR Z,TS4
F5E8  E6 5F                             AND 5Fh
F5EA  B8                                CP B
F5EB  20 F6                             JR NZ,TS2
F5ED  7A                                LD A,D
F5EE  F6 40                             OR 40h
F5F0  D3 2F                             OUT (2Fh),A
F5F2  47                                LD B,A
F5F3  0E 00                             LD C,0
F5F5  DB 2F                     TS3:    IN A,(2Fh)
F5F7  0D                                DEC C
F5F8  28 0B                             JR Z,TS4
F5FA  E6 5F                             AND 5Fh
F5FC  B8                                CP B
F5FD  20 F6                             JR NZ,TS3
F5FF  3E 50                             LD A,50h                ; done
F601  D3 2F                             OUT (2Fh),A
F603  AF                                XOR A
F604  C9                                RET
F605  3E 07                     TS4:    LD A,07h                ; abort
F607  D3 2F                             OUT (2Fh),A
F609  A7                                AND A
F60A  C9                                RET
                                
                                ; TESC: ESC, then A
F60B  F5                        TESC:   PUSH AF
F60C  3E 1B                             LD A,1Bh
F60E  CD A2 F5                          CALL TOUT
F611  F1                                POP AF
F612  18 8E                             JR TOUT
                                
                                ; TGOTO: the terminal's cursor to row D, column E. Uses A.
F614  3A 9A FE                  TGOTO:  LD A,(TROW)
F617  BA                                CP D
F618  20 05                             JR NZ,TG1
F61A  3A 9B FE                          LD A,(TCOL)
F61D  BB                                CP E
F61E  C8                                RET Z
F61F  3E 59                     TG1:    LD A,'Y'
F621  CD 0B F6                          CALL TESC
F624  7A                                LD A,D
F625  C6 20                             ADD A,32
F627  CD A2 F5                          CALL TOUT
F62A  7B                                LD A,E
F62B  C6 20                             ADD A,32
F62D  CD A2 F5                          CALL TOUT
F630  7A                                LD A,D
F631  32 9A FE                          LD (TROW),A
F634  7B                                LD A,E
F635  32 9B FE                          LD (TCOL),A
F638  C9                                RET
                                
                                ; TSYNC: the terminal's cursor to the screen's
F639  3A 82 FE                  TSYNC:  LD A,(CROW)
F63C  57                                LD D,A
F63D  3A 83 FE                          LD A,(CCOL)
F640  5F                                LD E,A
F641  18 D1                             JR TGOTO
                                
                                ; TSETA: the terminal's attribute to A (0 normal, 80h inverse). Uses A.
F643  E5                        TSETA:  PUSH HL
F644  21 9C FE                          LD HL,TATTR
F647  BE                                CP (HL)
F648  28 0B                             JR Z,TSA2
F64A  77                                LD (HL),A
F64B  B7                                OR A
F64C  3E 4D                             LD A,'M'
F64E  28 02                             JR Z,TSA1
F650  3E 4C                             LD A,'L'
F652  CD 0B F6                  TSA1:   CALL TESC
F655  E1                        TSA2:   POP HL
F656  C9                                RET
                                
                                ; TPUT: cell A (character, bit 7 inverse) at row D, column E on the
                                ; terminal; not the bottom right one. Uses A.
F657  F5                        TPUT:   PUSH AF
F658  3A 73 FE                          LD A,(ROWS)
F65B  3D                                DEC A
F65C  BA                                CP D
F65D  20 09                             JR NZ,TP1
F65F  3A 72 FE                          LD A,(COLS)
F662  3D                                DEC A
F663  BB                                CP E
F664  20 02                             JR NZ,TP1
F666  F1                                POP AF
F667  C9                                RET
F668  CD 14 F6                  TP1:    CALL TGOTO
F66B  F1                                POP AF
F66C  F5                                PUSH AF
F66D  E6 80                             AND 80h
F66F  CD 43 F6                          CALL TSETA
F672  F1                                POP AF
F673  E6 7F                             AND 7Fh
F675  CD A2 F5                          CALL TOUT
F678  3A 9B FE                          LD A,(TCOL)
F67B  3C                                INC A
F67C  32 9B FE                          LD (TCOL),A
F67F  E5                                PUSH HL
F680  21 72 FE                          LD HL,COLS
F683  BE                                CP (HL)
F684  E1                                POP HL
F685  C0                                RET NZ
F686  AF                                XOR A                   ; the terminal wrapped
F687  32 9B FE                          LD (TCOL),A
F68A  3A 9A FE                          LD A,(TROW)
F68D  3C                                INC A
F68E  32 9A FE                          LD (TROW),A
F691  C9                                RET
                                
                                ; CLRK: from row D, column E to the end of the line on the terminal
F692  CD 14 F6                  CLRK:   CALL TGOTO
F695  AF                                XOR A
F696  CD 43 F6                          CALL TSETA
F699  3E 4B                             LD A,'K'
F69B  C3 0B F6                          JR TESC
                                
                                ; DRAWR: row D from column E on the terminal, from the shadow. Uses all.
F69E  3A 72 FE                  DRAWR:  LD A,(COLS)
F6A1  3D                                DEC A
F6A2  4F                                LD C,A                  ; C = the last column to draw
F6A3  3A 73 FE                          LD A,(ROWS)
F6A6  3D                                DEC A
F6A7  BA                                CP D
F6A8  20 01                             JR NZ,DR1
F6AA  0D                                DEC C
F6AB  79                        DR1:    LD A,C
F6AC  BB                                CP E
F6AD  38 E3                             JR C,CLRK
F6AF  D5                                PUSH DE
F6B0  59                                LD E,C
F6B1  CD 07 F7                          CALL CELLP
F6B4  D1                                POP DE
F6B5  41                                LD B,C
F6B6  7E                        DR2:    LD A,(HL)               ; the last cell that is not blank
F6B7  FE 20                             CP ' '
F6B9  20 0D                             JR NZ,DR3
F6BB  78                                LD A,B
F6BC  BB                                CP E
F6BD  28 D3                             JR Z,CLRK               ; all blank
F6BF  E6 0F                             AND 15
F6C1  CC E8 F3                          CALL Z,RXPOLL
F6C4  2B                                DEC HL
F6C5  05                                DEC B
F6C6  18 EE                             JR DR2
F6C8  C5                        DR3:    PUSH BC
F6C9  CD 07 F7                          CALL CELLP
F6CC  C1                                POP BC
F6CD  7E                        DR4:    LD A,(HL)
F6CE  CD 57 F6                          CALL TPUT
F6D1  23                                INC HL
F6D2  7B                                LD A,E
F6D3  1C                                INC E
F6D4  B8                                CP B
F6D5  20 F6                             JR NZ,DR4
F6D7  79                                LD A,C
F6D8  BB                                CP E
F6D9  D8                                RET C
F6DA  18 B6                             JR CLRK
                                
                                ; REDR: rows B to C on the terminal, from the shadow. Uses all.
F6DC  50                        REDR:   LD D,B
F6DD  C5                        QRD1:   PUSH BC
F6DE  D5                                PUSH DE
F6DF  1E 00                             LD E,0
F6E1  CD 9E F6                          CALL DRAWR
F6E4  D1                                POP DE
F6E5  C1                                POP BC
F6E6  7A                                LD A,D
F6E7  B9                                CP C
F6E8  C8                                RET Z
F6E9  14                                INC D
F6EA  18 F1                             JR QRD1
                                
                                ; ---------------------------------------------------------------- the shadow
                                ; ROWP: HL = row A. CELLP: HL = row D, column E. Use A.
F6EC  D5                        ROWP:   PUSH DE                 ; COLS is 64 or 80: A x 64 (+ A x 16)
F6ED  6F                                LD L,A
F6EE  26 00                             LD H,0
F6F0  29                                ADD HL,HL
F6F1  29                                ADD HL,HL
F6F2  29                                ADD HL,HL
F6F3  29                                ADD HL,HL
F6F4  54                                LD D,H
F6F5  5D                                LD E,L
F6F6  29                                ADD HL,HL
F6F7  29                                ADD HL,HL
F6F8  3A 72 FE                          LD A,(COLS)
F6FB  FE 40                             CP 64
F6FD  28 01                             JR Z,RP1
F6FF  19                                ADD HL,DE
F700  ED 5B 76 FE               RP1:    LD DE,(SCR)
F704  19                                ADD HL,DE
F705  D1                                POP DE
F706  C9                                RET
F707  7A                        CELLP:  LD A,D
F708  CD EC F6                          CALL ROWP
F70B  7B                                LD A,E
F70C  85                        ADDHLA: ADD A,L
F70D  6F                                LD L,A
F70E  D0                                RET NC
F70F  24                                INC H
F710  C9                                RET
F711  D5                        SUBHLA: PUSH DE
F712  5F                                LD E,A
F713  16 00                             LD D,0
F715  B7                                OR A
F716  ED 52                             SBC HL,DE
F718  D1                                POP DE
F719  C9                                RET
                                
