F7F3  3D                                DEC A
F7F4  57                                LD D,A
F7F5  3A 9B FE                          LD A,(TROW)
F7F8  BA                                CP D
F7F9  28 05                             JR Z,SU1
F7FB  1E 00                             LD E,0
F7FD  CD 15 F6                          CALL TGOTO
