F70A  CD DC F6                  NROWS:  CALL ROWP
F70D  ED 4B 66 FE                       LD BC,(SCR)
F711  B7                                OR A
F712  ED 42                             SBC HL,BC
F714  44                                LD B,H
F715  4D                                LD C,L
F716  C9                                RET
                                
                                ; MVF / MVB: LDIR / LDDR (BC > 0) in pieces of 32 bytes, with RXPOLL
                                ; between them: at 19200 baud a byte comes every 2100 T-states.
F717  78                        MVF:    LD A,B
F718  B7                                OR A
F719  20 05                             JR NZ,MVF1
F71B  79                                LD A,C
F71C  FE 21                             CP 33
F71E  38 0C                             JR C,MVF2
