F43F  22 9D FE                          LD (LOST),HL
F442  D9                        RXP9:   EXX
F443  F1                                POP AF
F444  C9                                RET
                                
                                ; RGET: CF=1 and A = the next byte in the ring; CF=0: none. Uses DE, HL.
F445  2A 9B FE                  RGET:   LD HL,(RTAIL)
F448  ED 5B 99 FE                       LD DE,(RHEAD)
F44C  B7                                OR A
F44D  ED 52                             SBC HL,DE
F44F  C8                                RET Z
F450  19                                ADD HL,DE
F451  EB                                EX DE,HL
F452  2A 68 FE                          LD HL,(RING)
F455  19                                ADD HL,DE
F456  7E                                LD A,(HL)
F457  13                                INC DE
F458  F5                                PUSH AF
F459  7A                                LD A,D
F45A  E6 07                             AND RINGM
F45C  57                                LD D,A
F45D  ED 53 9B FE                       LD (RTAIL),DE
F461  F1                                POP AF
F462  37                                SCF
F463  C9                                RET
                                
                                ; LEVEL: HL = bytes in the ring. Uses DE.
F464  2A 99 FE                  LEVEL:  LD HL,(RHEAD)
F467  ED 5B 9B FE                       LD DE,(RTAIL)
F46B  B7                                OR A
F46C  ED 52                             SBC HL,DE
F46E  7C                                LD A,H
F46F  E6 07                             AND RINGM
F471  67                                LD H,A
F472  C9                                RET
                                
                                ; STOP / RESUME: ask the host to stop / go on (XOFF / XON, RTS)
F473  3A 94 FE                  STOP:   LD A,(STOPF)
F476  B7                                OR A
F477  C0                                RET NZ
F478  3C                                INC A
F479  32 94 FE                          LD (STOPF),A
F47C                            FLOWOFF:
F47C  3A 64 FE                          LD A,(FLAGS)
F47F  CB 4F                             BIT 1,A
F481  28 05                             JR Z,ST1
F483  3E 13                             LD A,13h                ; XOFF
F485  32 93 FE                          LD (TXQ),A
F488  3A 64 FE                  ST1:    LD A,(FLAGS)
F48B  CB 57                             BIT 2,A
F48D  C8                                RET Z
F48E  3E 07                             LD A,07h                ; RTS off
F490  18 16                             JR CMDSET
F492  3A 95 FE                  RESUME: LD A,(HOLDF)
F495  B7                                OR A
F496  C0                                RET NZ
F497  32 94 FE                          LD (STOPF),A
F49A  3A 64 FE                          LD A,(FLAGS)
F49D  CB 4F                             BIT 1,A
F49F  28 05                             JR Z,RS1
F4A1  3E 11                             LD A,11h                ; XON
F4A3  32 93 FE                          LD (TXQ),A
F4A6  3E 27                     RS1:    LD A,27h
F4A8  32 92 FE                  CMDSET: LD (CMDV),A
F4AB  3A 92 FE                  CMDOUT: LD A,(CMDV)
F4AE  C5                        CMDA:   PUSH BC
F4AF  47                                LD B,A
F4B0  3A 61 FE                          LD A,(CTL)
F4B3  4F                                LD C,A
F4B4  ED 41                             OUT (C),B
F4B6  C1                                POP BC
F4B7  C9                                RET
                                
                                ; SERPUT: A to the channel, when it is free and CTS on (status bit 7: the
                                ; WD2123 has no DSR), taking received bytes meanwhile. CF=1: CTS stayed
                                ; off for about 3.4 s and the byte was dropped.
F4B8  C5                        SERPUT: PUSH BC
F4B9  D5                                PUSH DE
F4BA  E5                                PUSH HL
F4BB  5F                                LD E,A
F4BC  21 00 00                          LD HL,0
F4BF  CD D8 F3                  QSP1:   CALL RXPOLL
F4C2  3A 61 FE                          LD A,(CTL)
F4C5  4F                                LD C,A
F4C6  ED 78                             IN A,(C)
F4C8  E6 81                             AND 81h
F4CA  FE 81                             CP 81h
F4CC  28 08                             JR Z,QSP2
