F3E8  C9                                RET
                                
                                ; ---------------------------------------------------------------- the channel
                                ; RXPOLL: a received byte, if there is one, to the ring; a queued XON /
                                ; XOFF out when the transmitter is free. Changes nothing but the flags.
F3E9  F5                        RXPOLL: PUSH AF
F3EA  D9                                EXX
F3EB  3A 72 FE                          LD A,(CTL)
F3EE  4F                                LD C,A
F3EF  ED 40                             IN B,(C)
F3F1  3A A6 FE                          LD A,(TXQ)
F3F4  B7                                OR A
F3F5  28 10                             JR Z,RXP1
F3F7  5F                                LD E,A
F3F8  78                                LD A,B
F3F9  E6 81                             AND 81h                 ; TxRDY, CTS
F3FB  FE 81                             CP 81h
F3FD  20 08                             JR NZ,RXP1
F3FF  0D                                DEC C
F400  ED 59                             OUT (C),E
F402  0C                                INC C
F403  AF                                XOR A
F404  32 A6 FE                          LD (TXQ),A
F407  CB 48                     RXP1:   BIT 1,B                 ; RxRDY
F409  28 48                             JR Z,RXP9
F40B  78                                LD A,B
F40C  E6 38                             AND 38h                 ; framing, overrun, parity
F40E  28 12                             JR Z,RXP3
F410  E6 10                             AND 10h
F412  28 07                             JR Z,RXP2
F414  2A B0 FE                          LD HL,(LOST)            ; overrun: at least one byte lost
F417  23                                INC HL
F418  22 B0 FE                          LD (LOST),HL
F41B  3A A5 FE                  RXP2:   LD A,(CMDV)
F41E  F6 10                             OR 10h                  ; error reset
F420  ED 79                             OUT (C),A
F422  0D                        RXP3:   DEC C
F423  ED 58                             IN E,(C)
F425  2A AC FE                          LD HL,(RHEAD)
F428  E5                                PUSH HL
F429  ED 4B 79 FE                       LD BC,(RING)
F42D  09                                ADD HL,BC
F42E  73                                LD (HL),E
F42F  E1                                POP HL
F430  23                                INC HL
F431  7C                                LD A,H
F432  E6 07                             AND RINGM
F434  67                                LD H,A
F435  ED 4B AE FE                       LD BC,(RTAIL)
F439  B7                                OR A
F43A  ED 42                             SBC HL,BC
F43C  28 0E                             JR Z,RXP4               ; full: the byte is lost
F43E  7C                                LD A,H                  ; the level, less one
F43F  09                                ADD HL,BC
F440  22 AC FE                          LD (RHEAD),HL
F443  E6 07                             AND RINGM
F445  FE 04                             CP HIWAT
F447  D4 84 F4                          CALL NC,STOP
F44A  18 07                             JR RXP9
F44C  2A B0 FE                  RXP4:   LD HL,(LOST)
F44F  23                                INC HL
F450  22 B0 FE                          LD (LOST),HL
F453  D9                        RXP9:   EXX
F454  F1                                POP AF
F455  C9                                RET
                                
                                ; RGET: CF=1 and A = the next byte in the ring; CF=0: none. Uses DE, HL.
F456  2A AE FE                  RGET:   LD HL,(RTAIL)
F459  ED 5B AC FE                       LD DE,(RHEAD)
F45D  B7                                OR A
F45E  ED 52                             SBC HL,DE
F460  C8                                RET Z
F461  19                                ADD HL,DE
F462  EB                                EX DE,HL
F463  2A 79 FE                          LD HL,(RING)
F466  19                                ADD HL,DE
F467  7E                                LD A,(HL)
F468  13                                INC DE
F469  F5                                PUSH AF
F46A  7A                                LD A,D
F46B  E6 07                             AND RINGM
F46D  57                                LD D,A
F46E  ED 53 AE FE                       LD (RTAIL),DE
F472  F1                                POP AF
F473  37                                SCF
F474  C9                                RET
                                
                                ; LEVEL: HL = bytes in the ring. Uses DE.
F475  2A AC FE                  LEVEL:  LD HL,(RHEAD)
F478  ED 5B AE FE                       LD DE,(RTAIL)
F47C  B7                                OR A
F47D  ED 52                             SBC HL,DE
F47F  7C                                LD A,H
F480  E6 07                             AND RINGM
F482  67                                LD H,A
F483  C9                                RET
                                
                                ; STOP / RESUME: ask the host to stop / go on (XOFF / XON, RTS)
F484  3A A7 FE                  STOP:   LD A,(STOPF)
F487  B7                                OR A
F488  C0                                RET NZ
F489  3C                                INC A
F48A  32 A7 FE                          LD (STOPF),A
F48D                            FLOWOFF:
F48D  3A 75 FE                          LD A,(FLAGS)
F490  CB 4F                             BIT 1,A
F492  28 05                             JR Z,ST1
F494  3E 13                             LD A,13h                ; XOFF
F496  32 A6 FE                          LD (TXQ),A
F499  3A 75 FE                  ST1:    LD A,(FLAGS)
F49C  CB 57                             BIT 2,A
F49E  C8                                RET Z
F49F  3E 07                             LD A,07h                ; RTS off
F4A1  18 16                             JR CMDSET
F4A3  3A A8 FE                  RESUME: LD A,(HOLDF)
F4A6  B7                                OR A
F4A7  C0                                RET NZ
F4A8  32 A7 FE                          LD (STOPF),A
F4AB  3A 75 FE                          LD A,(FLAGS)
F4AE  CB 4F                             BIT 1,A
F4B0  28 05                             JR Z,RS1
F4B2  3E 11                             LD A,11h                ; XON
F4B4  32 A6 FE                          LD (TXQ),A
F4B7  3E 27                     RS1:    LD A,27h
F4B9  32 A5 FE                  CMDSET: LD (CMDV),A
F4BC  3A A5 FE                  CMDOUT: LD A,(CMDV)
F4BF  C5                        CMDA:   PUSH BC
F4C0  47                                LD B,A
F4C1  3A 72 FE                          LD A,(CTL)
F4C4  4F                                LD C,A
F4C5  ED 41                             OUT (C),B
F4C7  C1                                POP BC
F4C8  C9                                RET
                                
                                ; SERPUT: A to the channel, when it is free and CTS on (status bit 7: the
                                ; WD2123 has no DSR), taking received bytes meanwhile. CF=1: CTS stayed
                                ; off for about 2 s and the byte was dropped.
F4C9  C5                        SERPUT: PUSH BC
F4CA  D5                                PUSH DE
F4CB  E5                                PUSH HL
F4CC  5F                                LD E,A
F4CD  21 00 00                          LD HL,0
F4D0  CD E9 F3                  QSP1:   CALL RXPOLL
F4D3  3A 72 FE                          LD A,(CTL)
F4D6  4F                                LD C,A
F4D7  ED 78                             IN A,(C)
F4D9  E6 81                             AND 81h
F4DB  FE 81                             CP 81h
F4DD  28 11                             JR Z,QSP2
F4DF  2B                                DEC HL
F4E0  7C                                LD A,H
F4E1  B5                                OR L
F4E2  20 EC                             JR NZ,QSP1
F4E4  3A B2 FE                          LD A,(DROPS)
F4E7  3C                                INC A
F4E8  28 03                             JR Z,SP0
F4EA  32 B2 FE                          LD (DROPS),A
F4ED  37                        SP0:    SCF
F4EE  18 04                             JR SP3
F4F0  0D                        QSP2:   DEC C
F4F1  ED 59                             OUT (C),E
F4F3  B7                                OR A
F4F4  E1                        SP3:    POP HL
F4F5  D1                                POP DE
F4F6  C1                                POP BC
F4F7  C9                                RET
                                
                                ; SENDS: the 0-terminated string at HL to the channel
F4F8  7E                        SENDS:  LD A,(HL)
F4F9  B7                                OR A
F4FA  C8                                RET Z
F4FB  CD C9 F4                          CALL SERPUT
F4FE  23                                INC HL
F4FF  18 F7                             JR SENDS
                                
                                ; SENDN: A (1-255) in decimal to the channel
F501  0E 00                     SENDN:  LD C,0
F503  06 64                             LD B,100
F505  CD 11 F5                          CALL SN1
F508  06 0A                             LD B,10
F50A  CD 11 F5                          CALL SN1
F50D  C6 30                             ADD A,'0'
F50F  18 B8                             JR SERPUT
F511  16 2F                     SN1:    LD D,'0'-1
F513  14                        SN2:    INC D
F514  90                                SUB B
F515  30 FC                             JR NC,SN2
F517  80                                ADD A,B
F518  5F                                LD E,A
F519  7A                                LD A,D
F51A  FE 30                             CP '0'
F51C  20 04                             JR NZ,SN3
F51E  79                                LD A,C                  ; no leading zeros
F51F  B7                                OR A
F520  7B                                LD A,E
F521  C8                                RET Z
F522  7A                        SN3:    LD A,D
F523  CD C9 F4                          CALL SERPUT
F526  0E 01                             LD C,1
F528  7B                                LD A,E
F529  C9                                RET
                                
                                ; ---------------------------------------------------------------- keys
                                ; KEYOUT: a key to the channel. For a VT100 host the arrow keys (the
                                ; terminal sends ESC A-D) become ESC [ A-D (ESC O A-D in cursor key mode);
                                ; an ESC not followed at once by A-D goes alone. With local echo (flag 8)
                                ; a key also goes to the screen, CR as CR LF; not ESC, the arrows, nor
                                ; (VT52 host) the key after an ESC.
F52A  32 9F FE                  KEYOUT: LD (KCH),A
F52D  3A 75 FE                          LD A,(FLAGS)
F530  0F                                RRCA
F531  38 19                             JR C,KO2
F533  3A 9F FE                          LD A,(KCH)
F536  FE 1B                             CP 1Bh
F538  20 12                             JR NZ,KO2
F53A  21 20 03                          LD HL,800               ; about 40 ms
F53D  CD E9 F3                  KO1:    CALL RXPOLL
F540  E5                                PUSH HL
F541  CD E3 EB                          CALL PEEKEY
F544  E1                                POP HL
F545  38 38                             JR C,KO3
F547  2B                                DEC HL
F548  7C                                LD A,H
F549  B5                                OR L
F54A  20 F1                             JR NZ,KO1
F54C  3A 9F FE                  KO2:    LD A,(KCH)
F54F  CD C9 F4                          CALL SERPUT
F552  21 A0 FE                          LD HL,KLAST
F555  46                                LD B,(HL)               ; the key before
F556  3A 9F FE                          LD A,(KCH)
F559  77                                LD (HL),A
F55A  3A 75 FE                          LD A,(FLAGS)
F55D  CB 5F                             BIT 3,A
F55F  C8                                RET Z
F560  0F                                RRCA
F561  30 04                             JR NC,KO5
F563  78                                LD A,B
F564  FE 1B                             CP 1Bh
F566  C8                                RET Z
F567  3A 9F FE                  KO5:    LD A,(KCH)
F56A  FE 1B                             CP 1Bh
F56C  C8                                RET Z
F56D  FE 0D                             CP 0Dh
F56F  20 0B                             JR NZ,KO6
F571  CD DB F9                          CALL EMUL               ; (with flag 10h it has added the LF)
F574  3A 75 FE                          LD A,(FLAGS)
F577  E6 10                             AND 10h
F579  C0                                RET NZ
F57A  3E 0A                             LD A,0Ah
F57C  C3 DB F9                  KO6:    JP EMUL
F57F  D6 41                     KO3:    SUB 'A'
F581  FE 04                             CP 4
F583  30 C7                             JR NC,KO2               ; not an arrow: it stays for SESS
F585  CD 00 EC                          CALL GETKEY
F588  32 9F FE                          LD (KCH),A
F58B  3E 1B                             LD A,1Bh
F58D  CD C9 F4                          CALL SERPUT
F590  3A 8B FE                          LD A,(CKM)
F593  B7                                OR A
F594  3E 5B                             LD A,'['
F596  28 02                             JR Z,KO4
F598  3E 4F                             LD A,'O'
F59A  CD C9 F4                  KO4:    CALL SERPUT
F59D  3A 9F FE                          LD A,(KCH)
F5A0  C3 C9 F4                          JP SERPUT
                                
                                ; ---------------------------------------------------------------- the terminal
                                ; TOUT: A to the terminal, as the BIOS's CONOUT, but taking received
                                ; bytes while the terminal is busy. Keeps BC, DE, HL.
F5A3  C5                        TOUT:   PUSH BC
F5A4  D5                                PUSH DE
F5A5  32 9E FE                          LD (TOCH),A
F5A8  3A 9E FE                  TO1:    LD A,(TOCH)
F5AB  47                                LD B,A
F5AC  CD C1 F5                          CALL TSEND
F5AF  28 0D                             JR Z,TO3
F5B1  CD E9 F3                  TO2:    CALL RXPOLL             ; timed out: wait for the terminal's abort
F5B4  DB 2F                             IN A,(2Fh)
F5B6  E6 5F                             AND 5Fh
F5B8  FE 07                             CP 07h
F5BA  20 F5                             JR NZ,TO2
F5BC  18 EA                             JR TO1
F5BE  D1                        TO3:    POP DE
F5BF  C1                                POP BC
F5C0  C9                                RET
                                
                                ; TSEND: B in two nibbles, each echoed back (BIOS COSEND). Z = sent.
F5C1  78                        TSEND:  LD A,B
F5C2  E6 0F                             AND 0Fh
F5C4  5F                                LD E,A
F5C5  78                                LD A,B
F5C6  0F                                RRCA
F5C7  0F                                RRCA
F5C8  0F                                RRCA
F5C9  0F                                RRCA
F5CA  E6 0F                             AND 0Fh
F5CC  57                                LD D,A
F5CD  CD E9 F3                  TS1:    CALL RXPOLL
F5D0  3E 0A                             LD A,0Ah                ; ask to send
F5D2  D3 2F                             OUT (2Fh),A
F5D4  DB 2F                             IN A,(2Fh)
F5D6  E6 5F                             AND 5Fh
F5D8  FE 0F                             CP 0Fh                  ; terminal ready
F5DA  20 F1                             JR NZ,TS1
F5DC  7B                                LD A,E
F5DD  F6 10                             OR 10h
F5DF  D3 2F                             OUT (2Fh),A
F5E1  47                                LD B,A
F5E2  0E 00                             LD C,0
F5E4  DB 2F                     TS2:    IN A,(2Fh)
F5E6  0D                                DEC C
F5E7  28 1D                             JR Z,TS4
F5E9  E6 5F                             AND 5Fh
F5EB  B8                                CP B
F5EC  20 F6                             JR NZ,TS2
F5EE  7A                                LD A,D
F5EF  F6 40                             OR 40h
F5F1  D3 2F                             OUT (2Fh),A
F5F3  47                                LD B,A
F5F4  0E 00                             LD C,0
F5F6  DB 2F                     TS3:    IN A,(2Fh)
F5F8  0D                                DEC C
F5F9  28 0B                             JR Z,TS4
F5FB  E6 5F                             AND 5Fh
F5FD  B8                                CP B
F5FE  20 F6                             JR NZ,TS3
F600  3E 50                             LD A,50h                ; done
F602  D3 2F                             OUT (2Fh),A
F604  AF                                XOR A
F605  C9                                RET
F606  3E 07                     TS4:    LD A,07h                ; abort
F608  D3 2F                             OUT (2Fh),A
F60A  A7                                AND A
F60B  C9                                RET
                                
                                ; TESC: ESC, then A
F60C  F5                        TESC:   PUSH AF
F60D  3E 1B                             LD A,1Bh
F60F  CD A3 F5                          CALL TOUT
F612  F1                                POP AF
F613  18 8E                             JR TOUT
                                
                                ; TGOTO: the terminal's cursor to row D, column E. Uses A.
F615  3A 9B FE                  TGOTO:  LD A,(TROW)
F618  BA                                CP D
F619  20 05                             JR NZ,TG1
F61B  3A 9C FE                          LD A,(TCOL)
F61E  BB                                CP E
F61F  C8                                RET Z
F620  3E 59                     TG1:    LD A,'Y'
F622  CD 0C F6                          CALL TESC
F625  7A                                LD A,D
F626  C6 20                             ADD A,32
F628  CD A3 F5                          CALL TOUT
F62B  7B                                LD A,E
F62C  C6 20                             ADD A,32
F62E  CD A3 F5                          CALL TOUT
F631  7A                                LD A,D
F632  32 9B FE                          LD (TROW),A
F635  7B                                LD A,E
F636  32 9C FE                          LD (TCOL),A
F639  C9                                RET
                                
                                ; TSYNC: the terminal's cursor to the screen's
F63A  3A 83 FE                  TSYNC:  LD A,(CROW)
F63D  57                                LD D,A
F63E  3A 84 FE                          LD A,(CCOL)
F641  5F                                LD E,A
F642  18 D1                             JR TGOTO
                                
                                ; TSETA: the terminal's attribute to A (0 normal, 80h inverse). Uses A.
F644  E5                        TSETA:  PUSH HL
F645  21 9D FE                          LD HL,TATTR
F648  BE                                CP (HL)
F649  28 0B                             JR Z,TSA2
F64B  77                                LD (HL),A
F64C  B7                                OR A
F64D  3E 4D                             LD A,'M'
F64F  28 02                             JR Z,TSA1
F651  3E 4C                             LD A,'L'
F653  CD 0C F6                  TSA1:   CALL TESC
F656  E1                        TSA2:   POP HL
F657  C9                                RET
                                
                                ; TPUT: cell A (character, bit 7 inverse) at row D, column E on the
                                ; terminal; not the bottom right one. Uses A.
F658  F5                        TPUT:   PUSH AF
F659  3A 74 FE                          LD A,(ROWS)
F65C  3D                                DEC A
F65D  BA                                CP D
F65E  20 09                             JR NZ,TP1
F660  3A 73 FE                          LD A,(COLS)
F663  3D                                DEC A
F664  BB                                CP E
F665  20 02                             JR NZ,TP1
F667  F1                                POP AF
F668  C9                                RET
F669  CD 15 F6                  TP1:    CALL TGOTO
F66C  F1                                POP AF
F66D  F5                                PUSH AF
F66E  E6 80                             AND 80h
F670  CD 44 F6                          CALL TSETA
F673  F1                                POP AF
F674  E6 7F                             AND 7Fh
F676  CD A3 F5                          CALL TOUT
F679  3A 9C FE                          LD A,(TCOL)
F67C  3C                                INC A
F67D  32 9C FE                          LD (TCOL),A
F680  E5                                PUSH HL
F681  21 73 FE                          LD HL,COLS
F684  BE                                CP (HL)
F685  E1                                POP HL
F686  C0                                RET NZ
F687  AF                                XOR A                   ; the terminal wrapped
F688  32 9C FE                          LD (TCOL),A
F68B  3A 9B FE                          LD A,(TROW)
F68E  3C                                INC A
F68F  32 9B FE                          LD (TROW),A
F692  C9                                RET
                                
                                ; CLRK: from row D, column E to the end of the line on the terminal
F693  CD 15 F6                  CLRK:   CALL TGOTO
F696  AF                                XOR A
F697  CD 44 F6                          CALL TSETA
F69A  3E 4B                             LD A,'K'
F69C  C3 0C F6                          JR TESC
                                
                                ; DRAWR: row D from column E on the terminal, from the shadow. Uses all.
F69F  3A 73 FE                  DRAWR:  LD A,(COLS)
F6A2  3D                                DEC A
F6A3  4F                                LD C,A                  ; C = the last column to draw
F6A4  3A 74 FE                          LD A,(ROWS)
F6A7  3D                                DEC A
F6A8  BA                                CP D
F6A9  20 01                             JR NZ,DR1
F6AB  0D                                DEC C
F6AC  79                        DR1:    LD A,C
F6AD  BB                                CP E
F6AE  38 E3                             JR C,CLRK
F6B0  D5                                PUSH DE
F6B1  59                                LD E,C
F6B2  CD 08 F7                          CALL CELLP
F6B5  D1                                POP DE
F6B6  41                                LD B,C
F6B7  7E                        DR2:    LD A,(HL)               ; the last cell that is not blank
F6B8  FE 20                             CP ' '
F6BA  20 0D                             JR NZ,DR3
F6BC  78                                LD A,B
F6BD  BB                                CP E
F6BE  28 D3                             JR Z,CLRK               ; all blank
F6C0  E6 0F                             AND 15
F6C2  CC E9 F3                          CALL Z,RXPOLL
F6C5  2B                                DEC HL
F6C6  05                                DEC B
F6C7  18 EE                             JR DR2
F6C9  C5                        DR3:    PUSH BC
F6CA  CD 08 F7                          CALL CELLP
F6CD  C1                                POP BC
F6CE  7E                        DR4:    LD A,(HL)
F6CF  CD 58 F6                          CALL TPUT
F6D2  23                                INC HL
F6D3  7B                                LD A,E
F6D4  1C                                INC E
F6D5  B8                                CP B
F6D6  20 F6                             JR NZ,DR4
F6D8  79                                LD A,C
F6D9  BB                                CP E
F6DA  D8                                RET C
F6DB  18 B6                             JR CLRK
                                
                                ; REDR: rows B to C on the terminal, from the shadow. Uses all.
F6DD  50                        REDR:   LD D,B
F6DE  C5                        QRD1:   PUSH BC
F6DF  D5                                PUSH DE
F6E0  1E 00                             LD E,0
F6E2  CD 9F F6                          CALL DRAWR
F6E5  D1                                POP DE
F6E6  C1                                POP BC
F6E7  7A                                LD A,D
F6E8  B9                                CP C
F6E9  C8                                RET Z
F6EA  14                                INC D
F6EB  18 F1                             JR QRD1
                                
                                ; ---------------------------------------------------------------- the shadow
                                ; ROWP: HL = row A. CELLP: HL = row D, column E. Use A.
F6ED  D5                        ROWP:   PUSH DE                 ; COLS is 64 or 80: A x 64 (+ A x 16)
F6EE  6F                                LD L,A
F6EF  26 00                             LD H,0
F6F1  29                                ADD HL,HL
F6F2  29                                ADD HL,HL
F6F3  29                                ADD HL,HL
F6F4  29                                ADD HL,HL
F6F5  54                                LD D,H
F6F6  5D                                LD E,L
F6F7  29                                ADD HL,HL
F6F8  29                                ADD HL,HL
F6F9  3A 73 FE                          LD A,(COLS)
F6FC  FE 40                             CP 64
F6FE  28 01                             JR Z,RP1
F700  19                                ADD HL,DE
F701  ED 5B 77 FE               RP1:    LD DE,(SCR)
F705  19                                ADD HL,DE
F706  D1                                POP DE
F707  C9                                RET
F708  7A                        CELLP:  LD A,D
F709  CD ED F6                          CALL ROWP
F70C  7B                                LD A,E
F70D  85                        ADDHLA: ADD A,L
F70E  6F                                LD L,A
F70F  D0                                RET NC
F710  24                                INC H
F711  C9                                RET
F712  D5                        SUBHLA: PUSH DE
F713  5F                                LD E,A
F714  16 00                             LD D,0
F716  B7                                OR A
F717  ED 52                             SBC HL,DE
F719  D1                                POP DE
F71A  C9                                RET
                                
                                ; NROWS: BC = A rows' bytes. Uses A, HL.
F71B  CD ED F6                  NROWS:  CALL ROWP
F71E  ED 4B 77 FE                       LD BC,(SCR)
F722  B7                                OR A
F723  ED 42                             SBC HL,BC
F725  44                                LD B,H
F726  4D                                LD C,L
F727  C9                                RET
                                
                                ; MVF / MVB: LDIR / LDDR (BC > 0) in pieces of 32 bytes, with RXPOLL
                                ; between them: at 19200 baud a byte comes every 2100 T-states.
F728  78                        MVF:    LD A,B
F729  B7                                OR A
F72A  20 05                             JR NZ,MVF1
F72C  79                                LD A,C
F72D  FE 21                             CP 33
F72F  38 0C                             JR C,MVF2
F731  C5                        MVF1:   PUSH BC
F732  01 20 00                          LD BC,32
F735  ED B0                             LDIR
F737  C1                                POP BC
F738  CD 58 F7                          CALL MVSUB
F73B  18 EB                             JR MVF
F73D  ED B0                     MVF2:   LDIR
F73F  C9                                RET
F740  78                        MVB:    LD A,B
F741  B7                                OR A
F742  20 05                             JR NZ,MVB1
F744  79                                LD A,C
F745  FE 21                             CP 33
F747  38 0C                             JR C,MVB2
F749  C5                        MVB1:   PUSH BC
F74A  01 20 00                          LD BC,32
F74D  ED B8                             LDDR
F74F  C1                                POP BC
F750  CD 58 F7                          CALL MVSUB
F753  18 EB                             JR MVB
F755  ED B8                     MVB2:   LDDR
F757  C9                                RET
F758  79                        MVSUB:  LD A,C
F759  D6 20                             SUB 32
F75B  4F                                LD C,A
F75C  30 01                             JR NC,MVS1
F75E  05                                DEC B
F75F  C3 E9 F3                  MVS1:   JP RXPOLL
                                
                                ; FILL: BC cells at HL blank. Uses A, BC, DE, HL.
F762  78                        FILL:   LD A,B
F763  B1                                OR C
F764  C8                                RET Z
F765  36 20                             LD (HL),' '
F767  0B                                DEC BC
F768  78                                LD A,B
F769  B1                                OR C
F76A  C8                                RET Z
F76B  54                                LD D,H
F76C  5D                                LD E,L
F76D  13                                INC DE
F76E  CD 28 F7                          CALL MVF
F771  C9                                RET
                                
                                ; SHUP / SHDN: rows RT to RB of the shadow one up / down; the row that
                                ; comes in is blank. Use all.
F772  CD E9 F3                  SHUP:   CALL RXPOLL             ; a byte may have come since the last
F775  3A A1 FE                          LD A,(RT)
F778  CD ED F6                          CALL ROWP
F77B  EB                                EX DE,HL
F77C  CD C0 F7                          CALL RCOUNT
F77F  3A 73 FE                          LD A,(COLS)
F782  6F                                LD L,A
F783  26 00                             LD H,0
F785  19                                ADD HL,DE
F786  78                                LD A,B
F787  B1                                OR C
F788  28 03                             JR Z,SHU1
F78A  CD 28 F7                          CALL MVF
F78D  EB                        SHU1:   EX DE,HL
F78E  18 28                             JR FILLRW
F790  CD E9 F3                  SHDN:   CALL RXPOLL
F793  CD C0 F7                          CALL RCOUNT
F796  3A A2 FE                          LD A,(RB)
F799  CD ED F6                          CALL ROWP
F79C  3A 73 FE                          LD A,(COLS)
F79F  3D                                DEC A
F7A0  CD 0D F7                          CALL ADDHLA
F7A3  54                                LD D,H
F7A4  5D                                LD E,L
F7A5  3A 73 FE                          LD A,(COLS)
F7A8  CD 12 F7                          CALL SUBHLA
F7AB  78                                LD A,B
F7AC  B1                                OR C
F7AD  28 03                             JR Z,SHD1
F7AF  CD 40 F7                          CALL MVB
F7B2  3A A1 FE                  SHD1:   LD A,(RT)
F7B5  CD ED F6                          CALL ROWP
F7B8  3A 73 FE                  FILLRW: LD A,(COLS)
F7BB  4F                                LD C,A
F7BC  06 00                             LD B,0
F7BE  18 A2                             JR FILL
F7C0  3A A2 FE                  RCOUNT: LD A,(RB)
F7C3  21 A1 FE                          LD HL,RT
F7C6  96                                SUB (HL)
F7C7  C3 1B F7                          JR NROWS
                                
                                ; SETRG: RT, RB = the scrolling region
F7CA  3A 87 FE                  SETRG:  LD A,(TOP)
F7CD  32 A1 FE                          LD (RT),A
F7D0  3A 88 FE                          LD A,(BOT)
F7D3  32 A2 FE                          LD (RB),A
F7D6  C9                                RET
                                
                                ; FULLSC: Z if the region is the whole screen. Uses A, HL.
F7D7  3A 87 FE                  FULLSC: LD A,(TOP)
F7DA  B7                                OR A
F7DB  C0                                RET NZ
