FA78  00 00                     PAGE:   DW 0                    ; the P area
FA7A  00 00                     SEGP:   DW 0                    ; its segment
FA7C  00 00                     SAVE:   DW 0                    ; where DOS goes while the program runs
FA7E  00 00                     SWLEN:  DW 0                    ; bytes exchanged
FA80  00 00                     PLEN:   DW 0
