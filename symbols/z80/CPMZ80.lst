FA8F  00                        CPFN:   DB 0
FA90  00                        FRES:   DB 0
FA91  00 00                     DOSLEN: DW 0                    ; bytes exchanged for a DOS call
FA93  00                        BMODE:  DB 0                    ; BUF: 0 empty, 1 read ahead, 2 to write
FA94  00 00                     BFCB:   DW 0
FA96  00 00                     BPOS:   DW 0
FA98  00                        BCNT:   DB 0
FA99  00                        BEOF:   DB 0
FA9A  00                        BIDX:   DB 0
FA9B  00 00                     RPOS:   DW 0
