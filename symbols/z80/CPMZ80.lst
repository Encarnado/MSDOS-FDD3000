F912  23                                INC HL
F913  56                                LD D,(HL)
F914  01 13 00                          LD BC,32-13
F917  09                                ADD HL,BC
F918  7E                                LD A,(HL)
F919  EB                                EX DE,HL
F91A  29                                ADD HL,HL
F91B  29                                ADD HL,HL
F91C  29                                ADD HL,HL
F91D  29                                ADD HL,HL
F91E  29                                ADD HL,HL
F91F  29                                ADD HL,HL
F920  29                                ADD HL,HL
F921  5F                                LD E,A
F922  16 00                             LD D,0
F924  19                                ADD HL,DE
F925  C9                                RET
                                
                                ; FNEXT: the program's FCB to the next record
F926  2A 8C FA                  FNEXT:  LD HL,(UFCB)
F929  11 20 00                          LD DE,32
F92C  19                                ADD HL,DE
F92D  34                                INC (HL)
F92E  7E                                LD A,(HL)
F92F  FE 80                             CP 128
F931  C0                                RET NZ
F932  36 00                             LD (HL),0
F934  2A 8C FA                          LD HL,(UFCB)
F937  11 0C 00                          LD DE,12
F93A  19                                ADD HL,DE
F93B  34                                INC (HL)
F93C  C0                                RET NZ
F93D  23                                INC HL
F93E  34                                INC (HL)
F93F  C9                                RET
                                
                                ; BUFREC: HL = record A of BUF
F940  67                        BUFREC: LD H,A
F941  2E 00                             LD L,0
F943  CB 3C                             SRL H
F945  CB 1D                             RR L
F947  11 F6 FA                          LD DE,BUF
F94A  19                                ADD HL,DE
F94B  C9                                RET
                                
                                ; RECS: HL = (A:HL + 127) / 128, records of a file of A:HL bytes
F94C  11 7F 00                  RECS:   LD DE,127
F94F  19                                ADD HL,DE
F950  CE 00                             ADC A,0
F952  CB 25                             SLA L
F954  CB 14                             RL H
F956  CB 17                             RL A
F958  6C                                LD L,H
F959  67                                LD H,A
F95A  C9                                RET
                                
                                ; MAX128: A = HL, at most 128
F95B  7C                        MAX128: LD A,H
F95C  B7                                OR A
F95D  3E 80                             LD A,128
F95F  C0                                RET NZ
F960  7D                                LD A,L
F961  FE 81                             CP 129
F963  D8                                RET C
F964  3E 80                             LD A,128
F966  C9                                RET
                                
                                ; 17 / 18: search first / next. DOS puts the drive and the directory
                                ; entry at the DTA; CP/M wants a directory record at the DMA, entry 0.
F967  C5                        F_SRCH: PUSH BC
F968  D5                                PUSH DE
F969  CD A9 F7                          CALL FLUSH
F96C  D1                                POP DE
F96D  C1                                POP BC
F96E  79                                LD A,C
F96F  FE 12                             CP 18
F971  3E 12                             LD A,12h
F973  28 1A                             JR Z,FS1
F975  2A 78 FA                          LD HL,(PAGE)
F978  01 38 00                          LD BC,PSRCH
F97B  09                                ADD HL,BC
F97C  EB                                EX DE,HL
F97D  D5                                PUSH DE
F97E  01 24 00                          LD BC,36
F981  ED B0                             LDIR
F983  AF                                XOR A
F984  12                                LD (DE),A
F985  E1                                POP HL
F986  7E                                LD A,(HL)
F987  FE 3F                             CP '?'                  ; all user numbers: the default drive
F989  20 02                             JR NZ,FS0
F98B  36 00                             LD (HL),0
F98D  3E 11                     FS0:    LD A,11h
F98F  11 38 00                  FS1:    LD DE,PSRCH
F992  CD EE F2                          CALL DOSX
F995  FE FF                             CP 0FFh
F997  CA 78 F3                          JP Z,RETA
F99A  2A 78 FA                          LD HL,(PAGE)            ; RC from the size
F99D  01 7D 00                          LD BC,PDTA+29
F9A0  09                                ADD HL,BC
F9A1  5E                                LD E,(HL)
F9A2  23                                INC HL
F9A3  56                                LD D,(HL)
F9A4  23                                INC HL
F9A5  7E                                LD A,(HL)
F9A6  EB                                EX DE,HL
F9A7  CD 4C F9                          CALL RECS
F9AA  CD 5B F9                          CALL MAX128
F9AD  2A 78 FA                          LD HL,(PAGE)
F9B0  01 61 00                          LD BC,PDTA+1
F9B3  09                                ADD HL,BC
F9B4  CD BA F9                          CALL DIRENT
F9B7  C3 77 F3                          JP F_ZERO
                                
                                ; DIRENT: a CP/M directory record at the DMA, as CP/M's BDOS leaves it
                                ; after a search or an open: entry 0 is user 0, the name at HL, RC = A,
                                ; no allocation; entries 1-3 unused (E5h)
F9BA  F5                        DIRENT: PUSH AF
F9BB  E5                                PUSH HL
F9BC  2A 84 FA                          LD HL,(DMAADR)
F9BF  54                                LD D,H
F9C0  5D                                LD E,L
F9C1  13                                INC DE
F9C2  36 E5                             LD (HL),0E5h
F9C4  01 7F 00                          LD BC,127
F9C7  ED B0                             LDIR
F9C9  ED 5B 84 FA                       LD DE,(DMAADR)
F9CD  AF                                XOR A
F9CE  12                                LD (DE),A
F9CF  13                                INC DE
F9D0  E1                                POP HL
F9D1  01 0B 00                          LD BC,11
F9D4  ED B0                             LDIR
F9D6  06 14                             LD B,20                 ; EX S1 S2 RC, allocation: 0
F9D8  12                        FS2:    LD (DE),A
F9D9  13                                INC DE
F9DA  10 FC                             DJNZ FS2
F9DC  F1                                POP AF
F9DD  2A 84 FA                          LD HL,(DMAADR)
F9E0  11 0F 00                          LD DE,15
F9E3  19                                ADD HL,DE
F9E4  77                                LD (HL),A
F9E5  C9                                RET
                                
                                ; ---- BIOS entries, (0001h) - 3
F9E6  37 F2 37 F2 08 FA 17 FA   BIOSV:  DW CPEXIT, CPEXIT, B_CONST, B_CONIN     ; BOOT WBOOT CONST CONIN
F9EE  1F FA 28 FA 2E FA 34 FA           DW B_CONOUT, B_LIST, B_PUN, B_RDR       ; CONOUT LIST PUNCH READER
F9F6  16 FA 48 FA 16 FA 16 FA           DW B_RET, B_SELD, B_RET, B_RET          ; HOME SELDSK SETTRK SETSEC
F9FE  16 FA 4C FA 4C FA 3A FA           DW B_RET, B_RW, B_RW, B_LSTS            ; SETDMA READ WRITE LISTST
FA06  4F FA                             DW B_STRN                               ; SECTRAN
                                
FA08                            B_CONST:
FA08  C5                                PUSH BC
FA09  D5                                PUSH DE
FA0A  E5                                PUSH HL
FA0B  CD E3 EB                          CALL PEEKEY
FA0E  3E 00                             LD A,0
FA10  30 01                             JR NC,BC1
FA12  3D                                DEC A
FA13  E1                        BC1:    POP HL
FA14  D1                                POP DE
FA15  C1                                POP BC
FA16  C9                        B_RET:  RET
FA17                            B_CONIN:
FA17  C5                                PUSH BC
FA18  D5                                PUSH DE
FA19  E5                                PUSH HL
FA1A  CD 00 EC                          CALL GETKEY
FA1D  18 F4                             JR BC1
FA1F                            B_CONOUT:
FA1F  C5                                PUSH BC
FA20  D5                                PUSH DE
FA21  E5                                PUSH HL
FA22  79                                LD A,C
FA23  CD 0E EC                          CALL CONOUT
FA26  18 EB                             JR BC1
FA28  E5                        B_LIST: PUSH HL                 ; LIST, PUNCH, READER, LISTST: the serial
FA29  21 3E D0                          LD HL,SPRN              ;   routines (I86.ASM), with C the byte;
FA2C  18 10                             JR BSER                 ;   BC, DE and HL kept
FA2E  E5                        B_PUN:  PUSH HL
FA2F  21 42 D0                          LD HL,SAUXO
FA32  18 0A                             JR BSER
FA34  E5                        B_RDR:  PUSH HL
FA35  21 62 D0                          LD HL,SAUXI
FA38  18 04                             JR BSER
FA3A  E5                        B_LSTS: PUSH HL
FA3B  21 85 D0                          LD HL,SLSTS
