FA41  CD 4D EB                          CALL JPHL
FA44  C1                                POP BC
FA45  D1                                POP DE
FA46  E1                                POP HL
FA47  C9                                RET
FA48  21 00 00                  B_SELD: LD HL,0                 ; no CP/M disks
FA4B  C9                                RET
FA4C  3E 01                     B_RW:   LD A,1
FA4E  C9                                RET
FA4F  60                        B_STRN: LD H,B
FA50  69                                LD L,C
FA51  C9                                RET
                                
                                ; what STAT sees: the disk as CP/M would have it (1 KB blocks)
FA52  48 00                     DPB:    DW 72                   ; SPT: 128-byte records per track
FA54  03 07 00                          DB 3,7,0                ; BSH BLM EXM
FA57  AF 00 3F 00                       DW 175,63               ; DSM DRM
FA5B  C0 00                             DB 0C0h,0               ; AL0 AL1
FA5D  10 00 00 00                       DW 16,0                 ; CKS OFF
