FA77  00 00                     PAGE:   DW 0                    ; the P area
FA79  00 00                     SEGP:   DW 0                    ; its segment
FA7B  00 00                     SAVE:   DW 0                    ; where DOS goes while the program runs
FA7D  00 00                     SWLEN:  DW 0                    ; bytes exchanged
