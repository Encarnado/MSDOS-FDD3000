F911  23                                INC HL
F912  56                                LD D,(HL)
F913  01 13 00                          LD BC,32-13
F916  09                                ADD HL,BC
F917  7E                                LD A,(HL)
F918  EB                                EX DE,HL
F919  29                                ADD HL,HL
F91A  29                                ADD HL,HL
F91B  29                                ADD HL,HL
F91C  29                                ADD HL,HL
F91D  29                                ADD HL,HL
F91E  29                                ADD HL,HL
F91F  29                                ADD HL,HL
F920  5F                                LD E,A
F921  16 00                             LD D,0
F923  19                                ADD HL,DE
F924  C9                                RET
                                
                                ; FNEXT: the program's FCB to the next record
F925  2A 8B FA                  FNEXT:  LD HL,(UFCB)
F928  11 20 00                          LD DE,32
F92B  19                                ADD HL,DE
F92C  34                                INC (HL)
F92D  7E                                LD A,(HL)
F92E  FE 80                             CP 128
F930  C0                                RET NZ
F931  36 00                             LD (HL),0
F933  2A 8B FA                          LD HL,(UFCB)
F936  11 0C 00                          LD DE,12
F939  19                                ADD HL,DE
F93A  34                                INC (HL)
F93B  C0                                RET NZ
F93C  23                                INC HL
F93D  34                                INC (HL)
F93E  C9                                RET
                                
                                ; BUFREC: HL = record A of BUF
F93F  67                        BUFREC: LD H,A
F940  2E 00                             LD L,0
F942  CB 3C                             SRL H
F944  CB 1D                             RR L
F946  11 F5 FA                          LD DE,BUF
F949  19                                ADD HL,DE
F94A  C9                                RET
                                
                                ; RECS: HL = (A:HL + 127) / 128, records of a file of A:HL bytes
F94B  11 7F 00                  RECS:   LD DE,127
F94E  19                                ADD HL,DE
F94F  CE 00                             ADC A,0
F951  CB 25                             SLA L
F953  CB 14                             RL H
F955  CB 17                             RL A
F957  6C                                LD L,H
F958  67                                LD H,A
F959  C9                                RET
                                
                                ; MAX128: A = HL, at most 128
F95A  7C                        MAX128: LD A,H
F95B  B7                                OR A
F95C  3E 80                             LD A,128
F95E  C0                                RET NZ
F95F  7D                                LD A,L
F960  FE 81                             CP 129
F962  D8                                RET C
F963  3E 80                             LD A,128
F965  C9                                RET
                                
                                ; 17 / 18: search first / next. DOS puts the drive and the directory
                                ; entry at the DTA; CP/M wants a directory record at the DMA, entry 0.
F966  C5                        F_SRCH: PUSH BC
F967  D5                                PUSH DE
F968  CD A8 F7                          CALL FLUSH
F96B  D1                                POP DE
F96C  C1                                POP BC
F96D  79                                LD A,C
F96E  FE 12                             CP 18
F970  3E 12                             LD A,12h
F972  28 1A                             JR Z,FS1
F974  2A 77 FA                          LD HL,(PAGE)
F977  01 38 00                          LD BC,PSRCH
F97A  09                                ADD HL,BC
F97B  EB                                EX DE,HL
F97C  D5                                PUSH DE
F97D  01 24 00                          LD BC,36
F980  ED B0                             LDIR
F982  AF                                XOR A
F983  12                                LD (DE),A
F984  E1                                POP HL
F985  7E                                LD A,(HL)
F986  FE 3F                             CP '?'                  ; all user numbers: the default drive
F988  20 02                             JR NZ,FS0
F98A  36 00                             LD (HL),0
F98C  3E 11                     FS0:    LD A,11h
F98E  11 38 00                  FS1:    LD DE,PSRCH
F991  CD ED F2                          CALL DOSX
F994  FE FF                             CP 0FFh
F996  CA 77 F3                          JP Z,RETA
F999  2A 77 FA                          LD HL,(PAGE)            ; RC from the size
F99C  01 7D 00                          LD BC,PDTA+29
F99F  09                                ADD HL,BC
F9A0  5E                                LD E,(HL)
F9A1  23                                INC HL
F9A2  56                                LD D,(HL)
F9A3  23                                INC HL
F9A4  7E                                LD A,(HL)
F9A5  EB                                EX DE,HL
F9A6  CD 4B F9                          CALL RECS
F9A9  CD 5A F9                          CALL MAX128
F9AC  2A 77 FA                          LD HL,(PAGE)
F9AF  01 61 00                          LD BC,PDTA+1
F9B2  09                                ADD HL,BC
F9B3  CD B9 F9                          CALL DIRENT
F9B6  C3 76 F3                          JP F_ZERO
                                
                                ; DIRENT: a CP/M directory record at the DMA, as CP/M's BDOS leaves it
                                ; after a search or an open: entry 0 is user 0, the name at HL, RC = A,
                                ; no allocation; entries 1-3 unused (E5h)
F9B9  F5                        DIRENT: PUSH AF
F9BA  E5                                PUSH HL
F9BB  2A 83 FA                          LD HL,(DMAADR)
F9BE  54                                LD D,H
F9BF  5D                                LD E,L
F9C0  13                                INC DE
F9C1  36 E5                             LD (HL),0E5h
F9C3  01 7F 00                          LD BC,127
F9C6  ED B0                             LDIR
F9C8  ED 5B 83 FA                       LD DE,(DMAADR)
F9CC  AF                                XOR A
F9CD  12                                LD (DE),A
F9CE  13                                INC DE
F9CF  E1                                POP HL
F9D0  01 0B 00                          LD BC,11
F9D3  ED B0                             LDIR
F9D5  06 14                             LD B,20                 ; EX S1 S2 RC, allocation: 0
F9D7  12                        FS2:    LD (DE),A
F9D8  13                                INC DE
F9D9  10 FC                             DJNZ FS2
F9DB  F1                                POP AF
F9DC  2A 83 FA                          LD HL,(DMAADR)
F9DF  11 0F 00                          LD DE,15
F9E2  19                                ADD HL,DE
F9E3  77                                LD (HL),A
F9E4  C9                                RET
                                
                                ; ---- BIOS entries, (0001h) - 3
F9E5  36 F2 36 F2 07 FA 16 FA   BIOSV:  DW CPEXIT, CPEXIT, B_CONST, B_CONIN     ; BOOT WBOOT CONST CONIN
F9ED  1E FA 27 FA 2D FA 33 FA           DW B_CONOUT, B_LIST, B_PUN, B_RDR       ; CONOUT LIST PUNCH READER
F9F5  15 FA 47 FA 15 FA 15 FA           DW B_RET, B_SELD, B_RET, B_RET          ; HOME SELDSK SETTRK SETSEC
F9FD  15 FA 4B FA 4B FA 39 FA           DW B_RET, B_RW, B_RW, B_LSTS            ; SETDMA READ WRITE LISTST
FA05  4E FA                             DW B_STRN                               ; SECTRAN
                                
FA07                            B_CONST:
FA07  C5                                PUSH BC
FA08  D5                                PUSH DE
FA09  E5                                PUSH HL
FA0A  CD F6 EB                          CALL PEEKEY
FA0D  3E 00                             LD A,0
FA0F  30 01                             JR NC,BC1
FA11  3D                                DEC A
FA12  E1                        BC1:    POP HL
FA13  D1                                POP DE
FA14  C1                                POP BC
FA15  C9                        B_RET:  RET
FA16                            B_CONIN:
FA16  C5                                PUSH BC
FA17  D5                                PUSH DE
FA18  E5                                PUSH HL
FA19  CD 13 EC                          CALL GETKEY
FA1C  18 F4                             JR BC1
FA1E                            B_CONOUT:
FA1E  C5                                PUSH BC
FA1F  D5                                PUSH DE
FA20  E5                                PUSH HL
FA21  79                                LD A,C
FA22  CD 21 EC                          CALL CONOUT
FA25  18 EB                             JR BC1
FA27  E5                        B_LIST: PUSH HL                 ; LIST, PUNCH, READER, LISTST: the serial
FA28  21 3E D0                          LD HL,SPRN              ;   routines (I86.ASM), with C the byte;
FA2B  18 10                             JR BSER                 ;   BC, DE and HL kept
FA2D  E5                        B_PUN:  PUSH HL
FA2E  21 42 D0                          LD HL,SAUXO
FA31  18 0A                             JR BSER
FA33  E5                        B_RDR:  PUSH HL
FA34  21 62 D0                          LD HL,SAUXI
FA37  18 04                             JR BSER
FA39  E5                        B_LSTS: PUSH HL
FA3A  21 85 D0                          LD HL,SLSTS
FA3D  D5                        BSER:   PUSH DE
FA3E  C5                                PUSH BC
FA3F  79                                LD A,C
FA40  CD 60 EB                          CALL JPHL
FA43  C1                                POP BC
FA44  D1                                POP DE
FA45  E1                                POP HL
FA46  C9                                RET
FA47  21 00 00                  B_SELD: LD HL,0                 ; no CP/M disks
FA4A  C9                                RET
FA4B  3E 01                     B_RW:   LD A,1
FA4D  C9                                RET
FA4E  60                        B_STRN: LD H,B
FA4F  69                                LD L,C
FA50  C9                                RET
                                
                                ; what STAT sees: the disk as CP/M would have it (1 KB blocks)
FA51  48 00                     DPB:    DW 72                   ; SPT: 128-byte records per track
FA53  03 07 00                          DB 3,7,0                ; BSH BLM EXM
FA56  AF 00 3F 00                       DW 175,63               ; DSM DRM
FA5A  C0 00                             DB 0C0h,0               ; AL0 AL1
