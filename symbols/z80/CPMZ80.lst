FA94  00                        BMODE:  DB 0                    ; BUF: 0 empty, 1 read ahead, 2 to write
FA95  00 00                     BFCB:   DW 0
FA97  00 00                     BPOS:   DW 0
FA99  00                        BCNT:   DB 0
FA9A  00                        BEOF:   DB 0
