D5BD  0F                                RRCA
D5BE  F6 40                             OR 40h
D5C0  B2                                OR D
D5C1  57                                LD D,A
D5C2  3A 03 D0                          LD A,(R_CH)
D5C5  E6 03                             AND 3
D5C7  18 1C                             JR I14SET
D5C9  3A 00 D0                  I14INI: LD A,(R_AL)             ; 0: AL = baud (bits 7-5: 110 ... 9600),
D5CC  5F                                LD E,A                  ;   parity (4-3: x0 none, 01 odd, 11 even),
D5CD  E6 18                             AND 18h                 ;   stop bits (2: 1 or 2), data bits (1-0)
D5CF  87                                ADD A,A
D5D0  57                                LD D,A
D5D1  CB 53                             BIT 2,E
D5D3  3E 40                             LD A,40h
D5D5  28 02                             JR Z,I14I1
D5D7  3E C0                             LD A,0C0h
D5D9  B2                        I14I1:  OR D
D5DA  57                                LD D,A
D5DB  7B                                LD A,E
D5DC  07                                RLCA
D5DD  07                                RLCA
D5DE  07                                RLCA
D5DF  E6 07                             AND 7
D5E1  47                                LD B,A
D5E2  7B                                LD A,E
D5E3  E6 03                             AND 3
