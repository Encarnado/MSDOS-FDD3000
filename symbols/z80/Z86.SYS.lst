                                ; XFER: one sector at HL, command A (80h read / A0h write), the transfer
                                ; instruction at XFI patched by SECTIO (INI / OUTI).  CBIOS A1.1's loop
                                ; (F8ECh / F934h): it ends when INTRQ goes through 0038h to FDCINT, A =
                                ; status AND 5Ch.  Only the wait for the first byte is timed (4 x 65536
                                ; turns of 48 T: ~3.1 s): once data flows, the sector ends by itself.
                                ; Lives in the free end of the EALO page (BIOS code, z86.py ;@SLACK).
D3C0  0E C3                     XFER:   LD C,0C3h
D3C2  ED 56                             IM 1
D3C4  FB                                EI
D3C5  D3 C0                             OUT (0C0h),A
D3C7  06 04                             LD B,4
D3C9  11 00 00                          LD DE,0
D3CC  DB 2F                     XFW:    IN A,(2Fh)              ; bit 7 = DRQ: the first byte is there
D3CE  17                                RLA
D3CF  38 0F                             JR C,XFI
D3D1  1B                                DEC DE
D3D2  7A                                LD A,D
D3D3  B3                                OR E
D3D4  20 F6                             JR NZ,XFW
D3D6  10 F4                             DJNZ XFW
D3D8  C3 E4 D4                          JP FDTOUT
D3DB  DB 2F                     XF1:    IN A,(2Fh)              ; bit 7 = DRQ
D3DD  17                                RLA
D3DE  30 FB                             JR NC,XF1
D3E0  ED A2                     XFI:    INI                     ; patched: INI (read) or OUTI (write)
D3E2  18 F7                             JR XF1
D3E4                            EALOEND:
D3E4  00 00 00 00 00 00 00 00           DS EALO+256-$
D3E4  00 00 00 00 00 00 00 00   
D3E4  00 00 00 00 00 00 00 00   
D3E4  00 00 00 00               
