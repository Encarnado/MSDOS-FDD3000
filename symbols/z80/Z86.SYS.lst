D8D2  6F                                LD L,A
D8D3  7B                                LD A,E
D8D4  0F                                RRCA
D8D5  0F                                RRCA
D8D6  E6 0E                             AND 0Eh
D8D8  5F                                LD E,A
D8D9  26 D0                             LD H,REGS>>8
