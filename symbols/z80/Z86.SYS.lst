                                ; MWSLOW: REP MOVSW one word at a time.  Stack: R_MOVSW's saved BC.
D3C0  DD E5                     MWSLOW: PUSH IX                 ; NEXT, or RESTORE after a segment override
D3C2  DD 21 C9 D3                       LD IX,MWS1
D3C6  C3 2B E1                  MWS0:   JP O_MOVSW              ; one exact MOVSW; its JP (IX) comes back
D3C9  2A 02 D0                  MWS1:   LD HL,(R_CX)
D3CC  2B                                DEC HL
D3CD  22 02 D0                          LD (R_CX),HL
D3D0  7C                                LD A,H
D3D1  B5                                OR L
D3D2  20 F2                             JR NZ,MWS0
D3D4  DD E1                             POP IX
D3D6  C1                                POP BC                  ; the 8086 code pointer
D3D7  DD E9                             JP (IX)
                                ; XFER: one sector at HL, command A (80h read / A0h write), the transfer
                                ; instruction at XFI patched by SECTIO (INI / OUTI).  CBIOS A1.1's loop
                                ; (F8ECh / F934h): it ends when INTRQ goes through 0038h to FDCINT, A =
                                ; status AND 5Ch.  Only the wait for the first byte is timed (4 x 65536
                                ; turns of 48 T: ~3.1 s): once data flows, the sector ends by itself.
                                ; Lives in the free end of the EALO page (BIOS code, z86.py ;@SLACK).
D3D9  0E C3                     XFER:   LD C,0C3h
D3DB  ED 56                             IM 1
D3DD  FB                                EI
D3DE  D3 C0                             OUT (0C0h),A
D3E0  06 04                             LD B,4
D3E2  11 00 00                          LD DE,0
D3E5  DB 2F                     XFW:    IN A,(2Fh)              ; bit 7 = DRQ: the first byte is there
D3E7  17                                RLA
D3E8  38 0F                             JR C,XFI
D3EA  1B                                DEC DE
D3EB  7A                                LD A,D
D3EC  B3                                OR E
D3ED  20 F6                             JR NZ,XFW
D3EF  10 F4                             DJNZ XFW
D3F1  C3 06 D5                          JP FDTOUT
D3F4  DB 2F                     XF1:    IN A,(2Fh)              ; bit 7 = DRQ
D3F6  17                                RLA
D3F7  30 FB                             JR NC,XF1
D3F9  ED A2                     XFI:    INI                     ; patched: INI (read) or OUTI (write)
D3FB  18 F7                             JR XF1
D3FD                            EALOEND:
D3FD  00 00 00                          DS EALO+256-$
