                                ; last set by SSET (the WD2123 can't be read back).  C = control port.
D6EB  21 19 D5                  I14RD:  LD HL,SAVED+1
D6EE  CB 79                             BIT 7,C                 ; channel A: SAVED, B: SAVED+1
D6F0  28 01                             JR Z,I14R1
D6F2  2D                                DEC L
