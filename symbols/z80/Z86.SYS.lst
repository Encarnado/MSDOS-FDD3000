F09A  2A 26 F1                          LD HL,(TICKS)
F09D  22 04 D0                          LD (R_DX),HL
F0A0  23                                INC HL
F0A1  22 26 F1                          LD (TICKS),HL
F0A4  7C                                LD A,H
F0A5  B5                                OR L
F0A6  C0                                RET NZ
F0A7  2A 28 F1                          LD HL,(TICKS+2)
F0AA  23                                INC HL
F0AB  22 28 F1                          LD (TICKS+2),HL
F0AE  C9                                RET
                                
                                ; ---------------------------------------------------------------- CP/M
                                ; 1Ch: CPM.COM's Z80 part (CPMZ80.ASM), which runs CP/M programs. BP =
                                ; its linear address: a length word, the BIOS addresses it was assembled
                                ; with (CPMSYM), then the code, for ENDBIOS. It is copied there; a
                                ; CPM.COM made for another build of Z86.SYS gets CF=1 instead. BP = 0:
                                ; run it (T_CPM, at ENDBIOS).
F0AF  2A 0A D0                  T_CPML: LD HL,(R_BP)
F0B2  7C                                LD A,H
F0B3  B5                                OR L
F0B4  CA 2C F1                          JP Z,ENDBIOS
F0B7  4E                                LD C,(HL)
F0B8  23                                INC HL
F0B9  46                                LD B,(HL)
F0BA  23                                INC HL
F0BB  C5                                PUSH BC
F0BC  11 E4 F0                          LD DE,CPMSYM
F0BF  06 0E                             LD B,CPMSYE-CPMSYM
F0C1  1A                        TL1:    LD A,(DE)
F0C2  BE                                CP (HL)
F0C3  20 0D                             JR NZ,TL2
F0C5  13                                INC DE
F0C6  23                                INC HL
F0C7  10 F8                             DJNZ TL1
F0C9  C1                                POP BC
F0CA  11 2C F1                          LD DE,ENDBIOS
F0CD  ED B0                             LDIR
F0CF  C3 99 EB                          JP CF0
F0D2  C1                        TL2:    POP BC
F0D3  C3 94 EB                          JP CF1
                                
                                ; 1Dh: the end of an INT 21h that CPMZ80's DOSCALL started: back to
                                ; DOSCALL's caller, on the Z80 stack it had
F0D6  2A 2A F1                  T_RET:  LD HL,(DCSP)
F0D9  7C                                LD A,H
F0DA  B5                                OR L
F0DB  C8                                RET Z
F0DC  F9                                LD SP,HL
F0DD  21 00 00                          LD HL,0
F0E0  22 2A F1                          LD (DCSP),HL
F0E3  C9                                RET
                                
F0E4  3B D8 4D EB E3 EB 00 EC   CPMSYM: DW NEXT, JPHL, PEEKEY, GETKEY, CONOUT, DCSP, ENDBIOS
F0E4  0E EC 2A F1 2C F1         
F0F2                            CPMSYE:
                                
                                ; Free bytes.  SKEW, the variables and ENDBIOS stay where the 2026-11-07
                                ; build had them (SKEW at F0F8h): CPM.COM's Z80 part, assembled for those
                                ; addresses and checked by trap 1Ch, then needs no rebuild.  z86.py
                                ; asserts this padding never goes negative.
F0F2                            SKEWAT  EQU 0F0F8h
F0F2  00 00 00 00 00 00                 DS SKEWAT-$
                                
                                ; ---------------------------------------------------------------- data
F0F8  00 02 04 06 08 0A 0C 0E   SKEW:   DB 0,2,4,6,8,10,12,14,16,1,3,5,7,9,11,13,15,17
F0F8  10 01 03 05 07 09 0B 0D   
F0F8  0F 11                     
F10A  05                        RESCMD: DB 05h                  ; FHOME's restore: verify (FORMAT: 01h)
F10B  00                        KFLAG:  DB 0                    ; 1: KBUF holds a key
F10C  00                        KBUF:   DB 0
F10D  00                        COCHR:  DB 0
F10E  FF                        CURDRV: DB 0FFh                 ; drive selected last (FFh none yet)
F10F  FF FF FF FF               TRKTAB: DB 0FFh,0FFh,0FFh,0FFh  ; head position per drive (FFh unknown)
F113  FF                        LATCH:  DB 0FFh
F114  00                        DWRITE: DB 0
F115  00                        DDRIVE: DB 0
F116  00                        DTRK:   DB 0
F117  00                        DSEC:   DB 0
F118  00                        DTRY:   DB 0
F119  00                        STRY:   DB 0
F11A  00                        DSTAT:  DB 0
F11B  00 00                     DADDR:  DW 0
F11D  00 00 00                  SAV38:  DB 0,0,0
F120  00 00                     DAYS:   DW 0
F122  00 00                     CLKCX:  DW 0
F124  00 00                     CLKDX:  DW 0
F126  00 00 00 00               TICKS:  DW 0,0
F12A  00 00                     DCSP:   DW 0                    ; CPMZ80: Z80 SP in DOSCALL (0: none)
                                
                                ; ENDBIOS: CPM.COM's Z80 part (CPMZ80.ASM) is copied here, over COLD, which
                                ; is needed only at boot.
F12C                            ENDBIOS:
                                ; ---------------------------------------------------------------- cold boot
                                ; COLD: from the boot sector (BOOT.ASM) through D0FDh, with this image
                                ; (Z86.SYS) at D000h and the boot ROM paged out. Clears the 8086 vectors,
                                ; reads the first directory sector, then IO.SYS (entry 1) to 0040:0000
                                ; and MSDOS.SYS (entry 2) to 0060:0000 through READ - each contiguous
                                ; from its first cluster, as FORMAT /S and mkfat write them - and starts
                                ; the 8086 at 0040:0000 with CS = DS = 0040h, as fddos.boot does. A read
                                ; error or a missing file prints a message and stops.
F12C                            DIRBUF  EQU 0C000h              ; in the 8086's memory, free at boot
F12C  F3                        COLD:   DI
F12D  31 00 00                          LD SP,0
F130  0E 81                             LD C,81h                ; both serial channels as CBIOS A1.1 sets
F132  11 08 8E                          LD DE,8E08h             ;   them: 8 bits, no parity, 1.5 stop bits,
F135  CD A2 D0                          CALL SSET               ;   1200 baud (code 8)
F138  0E 41                             LD C,41h
F13A  CD A2 D0                          CALL SSET
F13D  21 00 00                          LD HL,0
F140  11 01 00                          LD DE,1
F143  01 FF 03                          LD BC,3FFh
F146  75                                LD (HL),L
F147  ED B0                             LDIR
F149  21 00 C0                          LD HL,DIRBUF
F14C  11 01 00                          LD DE,1
F14F  01 05 00                          LD BC,FIRDIR
F152  CD C7 F1                          CALL CLOAD
F155  21 20 C0                          LD HL,DIRBUF+32
F158  11 0B F2                          LD DE,IONAM
F15B  01 00 04                          LD BC,0400h
F15E  3E 03                             LD A,3                  ; under 3 sectors: MSDOS.SYS is at 0600h
F160  CD 97 F1                          CALL CFILE
F163  21 40 C0                          LD HL,DIRBUF+64
F166  11 16 F2                          LD DE,DOSNAM
F169  01 00 06                          LD BC,0600h
F16C  3E 29                             LD A,41                 ; 10 KB at most
F16E  CD 97 F1                          CALL CFILE
F171  21 00 D0                          LD HL,R_AX              ; AX-DI and the segment registers: 0
F174  06 18                             LD B,24
F176  36 00                     CB1:    LD (HL),0
F178  23                                INC HL
F179  10 FB                             DJNZ CB1
F17B  21 40 00                          LD HL,40h
F17E  22 12 D0                          LD (R_CS),HL
F181  22 16 D0                          LD (R_DS),HL
F184  21 00 00                          LD HL,0
F187  22 2A D0                          LD (TMP),HL             ; IP
F18A  AF                                XOR A
F18B  32 24 D0                          LD (FLAGHI),A
F18E  21 00 01                          LD HL,0100h             ; F' = 0, A' = 1 (odd: PF = 0)
F191  E5                                PUSH HL
F192  F1                                POP AF
F193  08                                EX AF,AF'
F194  C3 00 D8                          JP START
                                
                                ; CFILE: directory entry HL, which must be named as at DE, to 0000:BC;
                                ; fewer than A sectors
F197  C5                        CFILE:  PUSH BC
F198  F5                                PUSH AF
F199  E5                                PUSH HL
F19A  06 0B                             LD B,11
F19C  1A                        CFL1:   LD A,(DE)
F19D  BE                                CP (HL)
F19E  20 44                             JR NZ,CBAD
F1A0  13                                INC DE
F1A1  23                                INC HL
F1A2  10 F8                             DJNZ CFL1
F1A4  E1                                POP HL
F1A5  11 1A 00                          LD DE,26
F1A8  19                                ADD HL,DE
F1A9  5E                                LD E,(HL)               ; DE = first cluster
F1AA  23                                INC HL
F1AB  56                                LD D,(HL)
F1AC  23                                INC HL
F1AD  7E                                LD A,(HL)               ; size -> sectors
F1AE  23                                INC HL
F1AF  B7                                OR A
F1B0  7E                                LD A,(HL)
F1B1  28 01                             JR Z,CFL2
F1B3  3C                                INC A
F1B4  C1                        CFL2:   POP BC                  ; B = the limit
F1B5  B8                                CP B
F1B6  30 2C                             JR NC,CBAD
F1B8  EB                                EX DE,HL
F1B9  2B                                DEC HL                  ; logical sector = FIRREC + 4 (cluster - 2)
F1BA  2B                                DEC HL
F1BB  29                                ADD HL,HL
F1BC  29                                ADD HL,HL
F1BD  01 0D 00                          LD BC,FIRREC
F1C0  09                                ADD HL,BC
F1C1  44                                LD B,H
F1C2  4D                                LD C,L
F1C3  5F                                LD E,A
F1C4  16 00                             LD D,0
F1C6  E1                                POP HL
                                ; CLOAD: DE sectors from logical sector BC of drive A to 0000:HL
F1C7  22 06 D0                  CLOAD:  LD (R_BX),HL
F1CA  ED 53 02 D0                       LD (R_CX),DE
F1CE  ED 43 04 D0                       LD (R_DX),BC
F1D2  AF                                XOR A
F1D3  32 00 D0                          LD (R_AL),A
F1D6  67                                LD H,A
F1D7  6F                                LD L,A
F1D8  22 1E D0                          LD (B_DS),HL
F1DB  CD C9 EC                          CALL T_READ
F1DE  2A 02 D0                          LD HL,(R_CX)
F1E1  7C                                LD A,H
F1E2  B5                                OR L
F1E3  C8                                RET Z
F1E4  21 F5 F1                  CBAD:   LD HL,BOOTMSG
F1E7  7E                        CB2:    LD A,(HL)
F1E8  B7                                OR A
F1E9  28 08                             JR Z,CB3
F1EB  E5                                PUSH HL
F1EC  CD 0E EC                          CALL CONOUT
F1EF  E1                                POP HL
F1F0  23                                INC HL
F1F1  18 F4                             JR CB2
F1F3  F3                        CB3:    DI
F1F4  76                                HALT
                                
F1F5                            BOOTMSG:
F1F5  0D 0A 44 69 73 6B 20 62           DB 13,10,'Disk boot failure',13,10,0
F1F5  6F 6F 74 20 66 61 69 6C   
F1F5  75 72 65 0D 0A 00         
F20B  49 4F 20 20 20 20 20 20   IONAM:  DB 'IO      SYS'
F20B  53 59 53                  
F216  4D 53 44 4F 53 20 20 20   DOSNAM: DB 'MSDOS   SYS'
F216  53 59 53                  
F221                            BIOSEND:                        ; the end of Z86.SYS
                                ; CPMZ80.ASM - the Z80 part of CPM.COM: CP/M 2.2 programs on the FDD3000's
                                ; Z80, under MS-DOS 1.25.
                                ;
                                ; Assembled by z86.py after I86.ASM and BIOS.ASM, with their symbols, at
                                ; ENDBIOS: over the BIOS's COLD, which only the boot needs (the ORG below
                                ; moves the address, not the output). build.py puts it in CPM.COM
                                ; (CPMZ80.INC). BIOS trap 1Ch copies it to ENDBIOS; trap 1Ch with BP = 0 then jumps to T_CPM, with
                                ; CPM.COM's registers:
                                ;   BX = SWLEN: CPM.COM's end, linear; DOS, COMMAND and CPM.COM are below
                                ;   DX = P: the page above the program's memory (TPA = 0100h to P)
                                ;   CX = program bytes, staged at linear SWLEN
                                ;   SI = linear address of FCB1 (16), FCB2 (16), command tail (128)
                                ;   DI = DOSLEN: CPM.COM's PSP + 256, linear
                                ;   AL = current drive
                                ; The 8086's memory is 0000h-CFFFh, DOS at the bottom where a CP/M
                                ; program must run. So 0000h-SWLEN is exchanged with SAVE (P+200h, up
                                ; to the top that DOS gave CPM.COM, below COMMAND), the program moved to
                                ; 0100h, and it runs. Console calls go to the BIOS's console code. For a
                                ; file call the BDOS copies the FCB (and a record being written) to the
                                ; P area, exchanges DOS (0000h-DOSLEN) back in, runs the 8086
                                ; interpreter on INT 21h there (DOSCALL; trap 1Dh returns), and
                                ; exchanges it out again: DOS 1.25's FCB calls are CP/M's, record size
                                ; 128. Sequential reads and writes go through BUF, so one exchange moves
                                ; up to NBUF records. The program ends (warm boot) with DOS exchanged
                                ; back and a return from the trap to CPM.COM.
                                ;
                                ; P area (in the 8086's memory, above the program's):
F221                            PBDOS   EQU 06h                 ; JP BDOSE: (0006h) points here
F221                            PSTUB   EQU 09h                 ; 8086: INT 21h, TRAP 1Dh
F221                            PFCB    EQU 10h                 ; the FCB of a call (37 bytes)
F221                            PSRCH   EQU 38h                 ; the FCB of search first / next
F221                            PDTA    EQU 60h                 ; DOS's DTA (128 bytes)
F221                            PBIOS   EQU 100h                ; BIOS jump table, (0001h) = P+103h
F221                            PSTK    EQU 200h                ; 8086 stack (DOS uses about 26 bytes)
F221                            PSIZE   EQU 200h
F221                            NBUF    EQU 8                   ; records in BUF
                                
                                
                                        END
                                
