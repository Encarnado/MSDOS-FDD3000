D836  29                        SHL4:   ADD HL,HL
D837  29                                ADD HL,HL
D838  29                                ADD HL,HL
D839  29                                ADD HL,HL
D83A  C9                                RET
                                
D83B  0A                        NEXT:   LD A,(BC)
D83C  03                                INC BC
D83D  6F                                LD L,A
D83E  26 D1                             LD H,OPLO>>8
D840  5E                                LD E,(HL)
D841  24                                INC H
D842  56                                LD D,(HL)
D843  EB                                EX DE,HL
D844  E9                                JP (HL)                 ; handler gets A = opcode
                                
                                ; After a prefix: the next byte.
D845  0A                        NEXT2:  LD A,(BC)
D846  03                                INC BC
D847  6F                        DISPA:  LD L,A
D848  26 D1                             LD H,OPLO>>8
D84A  5E                                LD E,(HL)
D84B  24                                INC H
D84C  56                                LD D,(HL)
D84D  EB                                EX DE,HL
D84E  E9                                JP (HL)
                                
                                ; 26 2E 36 3E: segment override. The operand bases become the segment's
                                ; and IX points at RESTORE for one instruction, which puts them back.
D84F                            O_SEG_ES:
D84F  2A 18 D0                          LD HL,(B_ES)
D852  22 20 D0                          LD (EADS),HL
D855  22 22 D0                          LD (EASS),HL
D858  DD 21 A8 D8                       LD IX,RESTORE
D85C  C3 45 D8                          JP NEXT2
