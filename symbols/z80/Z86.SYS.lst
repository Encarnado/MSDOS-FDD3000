D190  BF F8 F8 F8 F8 F8 F8 F8           DB O_NOP&0FFh, O_XCHGA&0FFh, O_XCHGA&0FFh, O_XCHGA&0FFh, O_XCHGA&0FFh, O_XCHGA&0FFh, O_XCHGA&0FFh, O_XCHGA&0FFh
D198  10 1A 27 BF 47 50 59 65           DB O_CBW&0FFh, O_CWD&0FFh, O_CALLF&0FFh, O_NOP&0FFh, O_PUSHF&0FFh, O_POPF&0FFh, O_SAHF&0FFh, O_LAHF&0FFh
D1A0  72 83 97 A8 19 2B 59 78           DB O_MOVA0&0FFh, O_MOVA1&0FFh, O_MOVA2&0FFh, O_MOVA3&0FFh, O_MOVSB&0FFh, O_MOVSW&0FFh, O_CMPSB&0FFh, O_CMPSW&0FFh
D1A8  BC C8 7D 89 98 A4 CA E0           DB O_TESTA8&0FFh, O_TESTA9&0FFh, O_STOSB&0FFh, O_STOSW&0FFh, O_LODSB&0FFh, O_LODSW&0FFh, O_SCASB&0FFh, O_SCASW&0FFh
D1B0  17 1E 25 2C 33 3A 41 48           DB O_MOVI_AL&0FFh, O_MOVI_CL&0FFh, O_MOVI_DL&0FFh, O_MOVI_BL&0FFh, O_MOVI_AH&0FFh, O_MOVI_CH&0FFh, O_MOVI_DH&0FFh, O_MOVI_BH&0FFh
D1B8  4F 5B 67 73 7F 8B 97 A3           DB O_MOVI_AX&0FFh, O_MOVI_CX&0FFh, O_MOVI_DX&0FFh, O_MOVI_BX&0FFh, O_MOVI_SP&0FFh, O_MOVI_BP&0FFh, O_MOVI_SI&0FFh, O_MOVI_DI&0FFh
D1C0  AF C6 AF C6 E4 E7 FD 07           DB O_RETN&0FFh, O_RET&0FFh, O_RETN&0FFh, O_RET&0FFh, O_LES&0FFh, O_LDS&0FFh, O_MOVC6&0FFh, O_MOVC7&0FFh
D1C8  15 2E 15 2E 3A 3E 6E 7D           DB O_RETFN&0FFh, O_RETF&0FFh, O_RETFN&0FFh, O_RETF&0FFh, O_INT3&0FFh, O_INTN&0FFh, O_INTO&0FFh, O_IRET&0FFh
D1D0  91 C2 95 07 13 39 57 61           DB O_SHD0&0FFh, O_SHD1&0FFh, O_SHD2&0FFh, O_SHD3&0FFh, O_AAM&0FFh, O_AAD&0FFh, O_SALC&0FFh, O_XLAT&0FFh
D1D8  77 77 77 77 77 77 77 77           DB O_ESC&0FFh, O_ESC&0FFh, O_ESC&0FFh, O_ESC&0FFh, O_ESC&0FFh, O_ESC&0FFh, O_ESC&0FFh, O_ESC&0FFh
D1E0  7E 90 A5 B4 BF C7 D0 D0           DB O_LOOPNZ&0FFh, O_LOOPZ&0FFh, O_LOOP&0FFh, O_JCXZ&0FFh, O_INB&0FFh, O_INW&0FFh, O_OUTI&0FFh, O_OUTI&0FFh
D1E8  D3 EB F8 48 C0 C8 BF BF           DB O_CALLN&0FFh, O_JMPN&0FFh, O_JMPF&0FFh, O_JREL8&0FFh, O_INDXB&0FFh, O_INDXW&0FFh, O_NOP&0FFh, O_NOP&0FFh
D1F0  45 BA E5 E5 BD 06 42 18           DB O_LOCK&0FFh, O_BAD&0FFh, O_REP&0FFh, O_REP&0FFh, O_HLT&0FFh, O_CMC&0FFh, O_GRP3B&0FFh, O_GRP3W&0FFh
D1F8  0F 16 20 27 2E 38 A4 C0           DB O_CLC&0FFh, O_STC&0FFh, O_CLI&0FFh, O_STI&0FFh, O_CLD&0FFh, O_STD&0FFh, O_GRP4&0FFh, O_GRP5&0FFh
D200                            OPHI:
D200  DB DB DB DB DB DB DB DB           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_PUSH_ES>>8, O_POP_ES>>8
D208  DB DB DB DB DB DB DB D8           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_PUSH_CS>>8, O_TRAP>>8
D210  DB DB DB DB DB DB DB DB           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_PUSH_SS>>8, O_POP_SS>>8
D218  DB DB DB DB DB DB DB DB           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_PUSH_DS>>8, O_POP_DS>>8
D220  DB DB DB DB DB DB D8 DB           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_SEG_ES>>8, O_DAA>>8
D228  DB DB DB DB DB DB D8 DB           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_SEG_CS>>8, O_DAS>>8
D230  DB DB DB DB DB DB D8 DC           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_ALU4>>8, O_ALU5>>8, O_SEG_SS>>8, O_AAA>>8
D238  DB DB DB DB DB DB D8 DC           DB O_ALU0>>8, O_ALU1>>8, O_ALU2>>8, O_ALU3>>8, O_CMPAL>>8, O_ALU5>>8, O_SEG_DS>>8, O_AAS>>8
D240  DC DC DC DC DD DD DD DD           DB O_INC_AX>>8, O_INC_CX>>8, O_INC_DX>>8, O_INC_BX>>8, O_INC_SP>>8, O_INC_BP>>8, O_INC_SI>>8, O_INC_DI>>8
