D468  D9 D9 D9 D9 D9 D9 D9 D9           DB EA10>>8, EA11>>8, EA12>>8, EA13>>8, EA14>>8, EA15>>8, EA16>>8, EA17>>8
D470  D9 D9 D9 D9 D9 D9 D9 D9           DB EA10>>8, EA11>>8, EA12>>8, EA13>>8, EA14>>8, EA15>>8, EA16>>8, EA17>>8
D478  D9 D9 D9 D9 D9 D9 D9 D9           DB EA10>>8, EA11>>8, EA12>>8, EA13>>8, EA14>>8, EA15>>8, EA16>>8, EA17>>8
D480  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D488  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D490  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D498  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D4A0  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D4A8  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D4B0  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
D4B8  D9 D9 D9 D9 D9 D9 DA DA           DB EA20>>8, EA21>>8, EA22>>8, EA23>>8, EA24>>8, EA25>>8, EA26>>8, EA27>>8
                                ; MWCHK: HL = source, DE = destination (host), BC = bytes. Returns A =
                                ; (STEP1+1) as R_MOVSW expects, or goes to MWSLOW instead.
D4C0  E5                        MWCHK:  PUSH HL
D4C1  B7                                OR A
D4C2  ED 52                             SBC HL,DE               ; source - destination
D4C4  3A 27 D0                          LD A,(STEP1+1)          ; 00h: DF = 0, FFh: DF = 1
D4C7  B7                                OR A
D4C8  28 02                             JR Z,MWC1
D4CA  2B                                DEC HL                  ; DF = 1: overlap if source - dest = +1
D4CB  2B                                DEC HL
D4CC  23                        MWC1:   INC HL                  ; DF = 0: overlap if source - dest = -1
D4CD  7C                                LD A,H
D4CE  B5                                OR L
D4CF  E1                                POP HL
D4D0  3A 27 D0                          LD A,(STEP1+1)
D4D3  C0                                RET NZ                  ; no overlap: R_MOVSW's LDIR / LDDR
D4D4  D1                                POP DE                  ; overlap: drop the return address
D4D5  C3 C0 D3                          JP MWSLOW
                                ; FHOME: restore to track 0, polled (CBIOS F7B5h). NZ: seek error, the
                                ; drive never showed track 0 (A = 10h), or the restore timed out (A =
                                ; 20h, ~3.1 s).  Keeps BC; corrupts DE.  In the EAHI page's free end.
D4D8  3A 0A F1                  FHOME:  LD A,(RESCMD)
D4DB  D3 C0                             OUT (0C0h),A
D4DD  C5                                PUSH BC
D4DE  06 12                             LD B,12h                ; let the FDC raise BUSY
D4E0  10 FE                     FH0:    DJNZ FH0
D4E2  06 04                             LD B,4
D4E4  11 00 00                          LD DE,0
D4E7  DB C0                     FH1:    IN A,(0C0h)
D4E9  1F                                RRA
D4EA  30 0B                             JR NC,FH2
D4EC  1B                                DEC DE
D4ED  7A                                LD A,D
D4EE  B3                                OR E
D4EF  20 F6                             JR NZ,FH1
D4F1  10 F4                             DJNZ FH1
D4F3  C1                                POP BC
D4F4  C3 06 D5                          JP FDTOUT
D4F7  C1                        FH2:    POP BC
D4F8  17                                RLA
D4F9  E6 10                             AND 10h
D4FB  C9                                RET
                                
D4FC                            EAHIEND:
D4FC  00 00 00 00                       DS EAHI+256-$
                                ;; ---- INT 14h's FDD3000 calls, AH = F0h / F1h (BIOS.ASM's T_I14 falls into
                                ; I14X).  Their reader I14RD and the copy of the settings, SAVED, sit in
                                ; free slot ends of the ALU blocks: the EALO / EAHI page ends are taken by
                                ; the floppy and REP MOVSW code (;@SLACK, z86.py).
                                
                                ; ------------------------------------------------- ALU cores, 16-byte slots
                                ; In: HL = destination operand, E = source. Index: (op >> 3) & 7.
D500                            BCORE:
D500  7E                                LD A,(HL)               ; 0 ADD
D501  83                                ADD A,E
D502  77                                LD (HL),A
D503  08                                EX AF,AF'
D504  DD E9                             JP (IX)
                                ; FDTOUT: a floppy wait timed out.  Stop the command (Force Interrupt with
                                ; no condition raises no INTRQ) and return NZ, A = 20h ("not ready").
                                ; Reached by JP from the waits, so its RET goes to their caller.
D506  F3                        FDTOUT: DI
D507  3E D0                             LD A,0D0h
D509  D3 C0                             OUT (0C0h),A
D50B  3E 20                             LD A,20h
D50D  B7                                OR A
D50E  C9                                RET
D50F  00                                DS BCORE+16-$
D510  7E                                LD A,(HL)               ; 1 OR
D511  B3                                OR E
D512  C6 00                             ADD A,0                 ; OF = CF = AF = 0
D514  77                                LD (HL),A
D515  08                                EX AF,AF'
D516  DD E9                             JP (IX)
D518  00 00 00 00               SAVED:  DS 4                    ; mode bytes for A, B, then baud codes (SSET);
                                                                ; SSET indexes it from SAVED-10h: its low
                                                                ; byte must be 10h-FCh (asserted in z86.py)
D51C  00 00 00 00                       DS BCORE+32-$
D520  08                                EX AF,AF'               ; 2 ADC
D521  7E                                LD A,(HL)
D522  8B                                ADC A,E
D523  77                                LD (HL),A
D524  08                                EX AF,AF'
D525  DD E9                             JP (IX)
D527  00 00 00 00 00 00 00 00           DS BCORE+48-$
D527  00                        
D530  08                                EX AF,AF'               ; 3 SBB
D531  7E                                LD A,(HL)
D532  9B                                SBC A,E
D533  77                                LD (HL),A
D534  08                                EX AF,AF'
D535  DD E9                             JP (IX)
D537  00 00 00 00 00 00 00 00           DS BCORE+64-$
D537  00                        
D540  7E                                LD A,(HL)               ; 4 AND
D541  A3                                AND E
D542  C6 00                             ADD A,0
D544  77                                LD (HL),A
D545  08                                EX AF,AF'
D546  DD E9                             JP (IX)
D548  00 00 00 00 00 00 00 00           DS BCORE+80-$
D550  7E                                LD A,(HL)               ; 5 SUB
D551  93                                SUB E
D552  77                                LD (HL),A
D553  08                                EX AF,AF'
D554  DD E9                             JP (IX)
D556  00 00 00 00 00 00 00 00           DS BCORE+96-$
D556  00 00                     
D560  7E                                LD A,(HL)               ; 6 XOR
D561  AB                                XOR E
D562  C6 00                             ADD A,0
D564  77                                LD (HL),A
D565  08                                EX AF,AF'
D566  DD E9                             JP (IX)
D568  00 00 00 00 00 00 00 00           DS BCORE+112-$
D570  7E                                LD A,(HL)               ; 7 CMP
D571  93                                SUB E
D572  08                                EX AF,AF'
D573  DD E9                             JP (IX)
D575  00 00 00 00 00 00 00 00           DS BCORE+128-$
D575  00 00 00                  
                                
                                ; In: HL = 16-bit operand -> HL + 1, flags as INC (CF kept).
D580  08                        INC16:  EX AF,AF'
D581  9F                                SBC A,A                 ; A = CF ? FFh : 0
D582  11 00 00                          LD DE,0
D585  37                                SCF
D586  ED 5A                             ADC HL,DE
D588  1F                                RRA                     ; CF back, S Z V untouched
D589  7D                                LD A,L
D58A  08                                EX AF,AF'
D58B  C9                                RET
                                
D58C  08                        DEC16:  EX AF,AF'
D58D  9F                                SBC A,A
D58E  11 00 00                          LD DE,0
D591  37                                SCF
D592  ED 52                             SBC HL,DE
D594  1F                                RRA
D595  7D                                LD A,L
D596  08                                EX AF,AF'
D597  C9                                RET
                                
                                ; DE = result of a 16-bit AND/OR/XOR/TEST: S Z PF from it, OF = CF = AF = 0.
D598  EB                        LOGF16: EX DE,HL
D599  AF                                XOR A
