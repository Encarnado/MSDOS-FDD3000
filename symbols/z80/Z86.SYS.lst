EECE  CB 6F                             BIT 5,A                 ; the seek timed out (no disk): not ready.
EED0  C2 4B ED                          JP NZ,DFAIL             ; (The write track itself is not timed: a
EED3  2A 1B F1                          LD HL,(DADDR)           ; disk pulled with the motor running hangs it)
EED6  11 78 17                          LD DE,FMTLEN
EED9  0E C3                             LD C,0C3h
EEDB  3E FE                             LD A,0FEh               ; write track, as FORMAT 2.0
EEDD  D3 C0                             OUT (0C0h),A
EEDF  DB 2F                     FT1:    IN A,(2Fh)              ; bit 7 = DRQ
EEE1  87                                ADD A,A
EEE2  30 19                             JR NC,FT3
EEE4  ED A3                             OUTI
EEE6  1B                                DEC DE
EEE7  7A                                LD A,D
EEE8  B3                                OR E
EEE9  20 F4                             JR NZ,FT1
EEEB  DB 2F                     FT2:    IN A,(2Fh)              ; gap 4Eh until the index pulse ends it
EEED  87                                ADD A,A
EEEE  30 06                             JR NC,FT4
EEF0  3E 4E                             LD A,4Eh
EEF2  D3 C3                             OUT (0C3h),A
EEF4  18 F5                             JR FT2
EEF6  DB C0                     FT4:    IN A,(0C0h)
EEF8  1F                                RRA
EEF9  38 F0                             JR C,FT2
EEFB  18 05                             JR FT5
EEFD  DB C0                     FT3:    IN A,(0C0h)
EEFF  1F                                RRA
EF00  38 DD                             JR C,FT1
EF02  DB C0                     FT5:    IN A,(0C0h)
