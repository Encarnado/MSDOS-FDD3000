EAC1  03                                INC BC
EAC2  F5                                PUSH AF
EAC3  CD 0E D9                          CALL EAW
EAC6  F1                                POP AF
EAC7  E6 38                             AND 38h
EAC9  0F                                RRCA
EACA  0F                                RRCA
EACB  11 D1 EA                          LD DE,G5T
EACE  C3 0B DA                          JP JTAB
EAD1  E1 EA F0 EA FA EA 0D EB   G5T:    DW G5_INC, G5_DEC, G5_CALL, G5_CALLF, G5_JMP, G5_JMPF, G5_PUSH, G5_PUSH
EAD1  28 EB 33 EB 3E EB 3E EB   
                                
EAE1  E5                        G5_INC: PUSH HL
EAE2  7E                                LD A,(HL)
EAE3  23                                INC HL
EAE4  66                                LD H,(HL)
EAE5  6F                                LD L,A
EAE6  CD 80 D5                          CALL INC16
EAE9  EB                        G5ST:   EX DE,HL
EAEA  E1                                POP HL
EAEB  73                                LD (HL),E
EAEC  23                                INC HL
EAED  72                                LD (HL),D
EAEE  DD E9                             JP (IX)
EAF0  E5                        G5_DEC: PUSH HL
EAF1  7E                                LD A,(HL)
EAF2  23                                INC HL
EAF3  66                                LD H,(HL)
EAF4  6F                                LD L,A
EAF5  CD 8C D5                          CALL DEC16
EAF8  18 EF                             JR G5ST
EAFA                            G5_CALL:
EAFA  5E                                LD E,(HL)
EAFB  23                                INC HL
EAFC  56                                LD D,(HL)
EAFD  D5                                PUSH DE
EAFE  CD 18 DA                          CALL GETIP
EB01  CD 31 DA                          CALL PUSHDE
EB04  D1                                POP DE
EB05  2A 1A D0                          LD HL,(B_CS)
EB08  19                                ADD HL,DE
EB09  44                                LD B,H
EB0A  4D                                LD C,L
EB0B  DD E9                             JP (IX)
EB0D                            G5_CALLF:
EB0D  5E                                LD E,(HL)
EB0E  23                                INC HL
EB0F  56                                LD D,(HL)
EB10  23                                INC HL
EB11  D5                                PUSH DE
EB12  5E                                LD E,(HL)
EB13  23                                INC HL
EB14  56                                LD D,(HL)
EB15  D5                                PUSH DE
EB16  ED 5B 12 D0                       LD DE,(R_CS)
EB1A  CD 31 DA                          CALL PUSHDE
EB1D  CD 18 DA                          CALL GETIP
EB20  CD 31 DA                          CALL PUSHDE
EB23  E1                                POP HL
EB24  D1                                POP DE
EB25  C3 22 DA                          JP FARJ
EB28  5E                        G5_JMP: LD E,(HL)
EB29  23                                INC HL
EB2A  56                                LD D,(HL)
EB2B  2A 1A D0                          LD HL,(B_CS)
EB2E  19                                ADD HL,DE
EB2F  44                                LD B,H
EB30  4D                                LD C,L
EB31  DD E9                             JP (IX)
EB33                            G5_JMPF:
EB33  5E                                LD E,(HL)
EB34  23                                INC HL
EB35  56                                LD D,(HL)
EB36  23                                INC HL
EB37  7E                                LD A,(HL)
EB38  23                                INC HL
EB39  66                                LD H,(HL)
EB3A  6F                                LD L,A
EB3B  C3 22 DA                          JP FARJ
EB3E                            G5_PUSH:
EB3E  5E                                LD E,(HL)
EB3F  23                                INC HL
EB40  56                                LD D,(HL)
EB41  CD 31 DA                          CALL PUSHDE
EB44  DD E9                             JP (IX)
                                
EB46                            ENDCODE:
                                ; BIOS.ASM - the BIOS traps of IOFDD.SYS in Z80 code, for the FDD3000.
                                ;
                                ; Assembled after I86.ASM (z86.build(bios=True)). The 8086 opcode 0F nn
                                ; calls TRAP with A = nn. A handler reads and writes the 8086 registers in
                                ; REGS and sets ZF / CF in AF' (the 8086 flags); TRAP keeps BC (the 8086
                                ; code pointer) and IX (the dispatcher).
                                ;
                                ; The hardware code is CBIOS A1.1's, which runs on real FDD3000s:
                                ;   console  the nibble protocol to the terminal on port 2Fh (CBIOS FAA8h
                                ;            send, FB0Dh receive, F719h status)
                                ;   disk     WD177x on C0h-C3h, drive latch E0h, DRQ in bit 7 of port 2Fh.
                                ;            A command ends with INTRQ on the Z80 INT line (IM 1, RST 38h):
                                ;            0038h is pointed at FDCINT for the duration of a disk call,
                                ;            which leaves the transfer loop and returns the status (CBIOS
                                ;            FBE2h / FC0Ch).
                                ;
                                ; The FDD3000 has no clock: the date and time are what DOS last set
                                ; (1-1-80 0:00 at boot), and INT 1Ah's tick count goes up by one per call.
                                
EB46                            NDRIVE  EQU 4                   ; drives on the latch
EB46                            SPT     EQU 18                  ; sectors per track, IDs 0-17
EB46                            NTRACK  EQU 40
EB46                            NSECT   EQU NTRACK*SPT          ; 720
EB46                            FIRDIR  EQU 5                   ; the disk layout (mkfat.py): boot sector,
EB46                            FIRREC  EQU 13                  ; 2 FATs of 2 sectors, 8 directory sectors
EB46                            GTOP    EQU 0D000h              ; end of the 8086's memory
EB46                            RETRIES EQU 10
                                
                                ; ---------------------------------------------------------------- dispatch
EB46  C5                        TRAP:   PUSH BC
EB47  DD E5                             PUSH IX
EB49  FE 1E                             CP 1Eh                  ; entries in TTAB
EB4B  30 0F                             JR NC,TRAPX
EB4D  87                                ADD A,A
EB4E  6F                                LD L,A
EB4F  26 00                             LD H,0
EB51  11 61 EB                          LD DE,TTAB
EB54  19                                ADD HL,DE
EB55  5E                                LD E,(HL)
EB56  23                                INC HL
EB57  56                                LD D,(HL)
EB58  EB                                EX DE,HL
EB59  CD 60 EB                          CALL JPHL
EB5C  DD E1                     TRAPX:  POP IX
EB5E  C1                                POP BC
EB5F  C9                        TNONE:  RET
EB60  E9                        JPHL:   JP (HL)
                                
EB61  5F EB BA EB C6 EB CD EB   TTAB:   DW TNONE, T_STAT, T_INP, T_OUTP         ; 0-3
EB69  D3 EB DF EB D9 EB DC EC           DW T_PRINT, T_AUXIN, T_AUXOUT, T_READ   ; 4-7
EB71  DF EC 1F EF 26 EF 2D EF           DW T_WRITE, T_DSKCHG, T_SDATE, T_STIME  ; 8-11
EB79  3A EF E6 EB 5F EB 5F EB           DW T_GTIME, T_FLUSH, TNONE, TNONE       ; 12, 13, 14 MAPDEV, 15
EB81  4D EF DD EF E4 EF 5F EB           DW T_I10, T_I11, T_I12, TNONE           ; 10h-13h: IBM PC ROM BIOS
EB89  12 F0 5F EB EB EF 5E F0           DW T_I14, TNONE, T_I16, T_I17           ; 14h-17h
EB91  5F EB 5F EB 84 F0                 DW TNONE, TNONE, T_I1A                  ; 18h-1Ah
EB97  91 EE A7 F0 CE F0                 DW T_FMT, T_CPML, T_RET                 ; 1Bh: FORMAT.COM, 1Ch-1Dh: CPM.COM
EB9D                            TTEND:
                                
                                ; 8086 flags in F': F' = F' AND D OR E
EB9D  11 40 BF                  ZF1:    LD DE,0BF40h
EBA0  18 0D                             JR FSET
EBA2  11 00 BF                  ZF0:    LD DE,0BF00h
EBA5  18 08                             JR FSET
EBA7  11 01 FE                  CF1:    LD DE,0FE01h
EBAA  18 03                             JR FSET
EBAC  11 00 FE                  CF0:    LD DE,0FE00h
EBAF  08                        FSET:   EX AF,AF'
EBB0  F5                                PUSH AF
EBB1  E1                                POP HL
EBB2  7D                                LD A,L
EBB3  A2                                AND D
EBB4  B3                                OR E
EBB5  6F                                LD L,A
EBB6  E5                                PUSH HL
EBB7  F1                                POP AF
EBB8  08                                EX AF,AF'
EBB9  C9                                RET
                                
                                ; ---------------------------------------------------------------- console
                                ; 1 STATUS: ZF=1 no key; else ZF=0, AL = the key (left for INP)
EBBA  CD F6 EB                  T_STAT: CALL PEEKEY
EBBD  D2 9D EB                          JP NC,ZF1
EBC0  32 00 D0                          LD (R_AL),A
EBC3  C3 A2 EB                          JP ZF0
                                
                                ; 2 INP: AL = key (waits)
EBC6  CD 13 EC                  T_INP:  CALL GETKEY
EBC9  32 00 D0                          LD (R_AL),A
EBCC  C9                                RET
                                
                                ; 3 OUTP: AL to the screen
EBCD  3A 00 D0                  T_OUTP: LD A,(R_AL)
EBD0  C3 21 EC                          JP CONOUT
                                
                                ; 4 PRINT: AL to the printer (WD2123 channel A); 6 AUXOUT: AL to AUX
                                ; (channel B); 5 AUXIN: AL from AUX. They wait as long as it takes, as
                                ; CP/M's LIST, PUNCH and READER do (the serial routines are in I86.ASM's
                                ; register page).
EBD3                            T_PRINT:
EBD3  3A 00 D0                          LD A,(R_AL)
EBD6  C3 3E D0                          JP SPRN
EBD9                            T_AUXOUT:
EBD9  3A 00 D0                          LD A,(R_AL)
EBDC  C3 42 D0                          JP SAUXO
EBDF                            T_AUXIN:
EBDF  CD 62 D0                          CALL SAUXI
EBE2  32 00 D0                          LD (R_AL),A
EBE5  C9                                RET
                                
                                ; 13 FLUSH: drop the keys typed ahead
EBE6                            T_FLUSH:
EBE6  AF                                XOR A
EBE7  32 0B F1                          LD (KFLAG),A
EBEA  DB 2F                     FL1:    IN A,(2Fh)
EBEC  E6 5F                             AND 5Fh
EBEE  FE 04                             CP 04h
EBF0  C0                                RET NZ
EBF1  CD 7E EC                          CALL CONIN
EBF4  18 F4                             JR FL1
                                
                                ; PEEKEY: CF=1 and A = the next key, which stays for GETKEY; CF=0 none.
                                ; The link can't look at a key without taking it, so it is kept here.
EBF6  3A 0B F1                  PEEKEY: LD A,(KFLAG)
EBF9  B7                                OR A
EBFA  20 12                             JR NZ,PK1
EBFC  DB 2F                             IN A,(2Fh)
EBFE  E6 5F                             AND 5Fh
EC00  FE 04                             CP 04h                  ; the terminal has a key
EC02  C0                                RET NZ                  ; (NC)
EC03  CD 7E EC                          CALL CONIN
EC06  32 0C F1                          LD (KBUF),A
EC09  3E 01                             LD A,1
EC0B  32 0B F1                          LD (KFLAG),A
EC0E  3A 0C F1                  PK1:    LD A,(KBUF)
EC11  37                                SCF
EC12  C9                                RET
                                
                                ; GETKEY: A = next key (waits)
EC13  21 0B F1                  GETKEY: LD HL,KFLAG
EC16  7E                                LD A,(HL)
EC17  B7                                OR A
EC18  CA 7E EC                          JP Z,CONIN
EC1B  36 00                             LD (HL),0
EC1D  3A 0C F1                          LD A,(KBUF)
EC20  C9                                RET
                                
                                ; CONOUT: A to the terminal (CBIOS FAA8h). Uses A, BC, DE.
EC21  32 0D F1                  CONOUT: LD (COCHR),A
EC24  3A 0D F1                  CO1:    LD A,(COCHR)
EC27  47                                LD B,A
EC28  CD 36 EC                          CALL COSEND
EC2B  C8                                RET Z
EC2C  DB 2F                     CO2:    IN A,(2Fh)              ; timed out: wait for the terminal's abort
EC2E  E6 5F                             AND 5Fh
EC30  FE 07                             CP 07h
EC32  20 F8                             JR NZ,CO2
EC34  18 EE                             JR CO1
                                
                                ; COSEND: B in two nibbles, each echoed back. Z = sent.
EC36  78                        COSEND: LD A,B
EC37  E6 0F                             AND 0Fh
EC39  5F                                LD E,A
EC3A  78                                LD A,B
EC3B  E6 F0                             AND 0F0h
EC3D  0F                                RRCA
EC3E  0F                                RRCA
EC3F  0F                                RRCA
EC40  0F                                RRCA
EC41  57                                LD D,A
EC42  3E 0A                     COS1:   LD A,0Ah                ; ask to send
EC44  D3 2F                             OUT (2Fh),A
EC46  DB 2F                             IN A,(2Fh)
EC48  E6 5F                             AND 5Fh
EC4A  FE 0F                             CP 0Fh                  ; terminal ready
EC4C  20 F4                             JR NZ,COS1
EC4E  7B                                LD A,E
EC4F  F6 10                             OR 10h                  ; low nibble
EC51  D3 2F                             OUT (2Fh),A
EC53  47                                LD B,A
EC54  0E 00                             LD C,0
EC56  DB 2F                     COS2:   IN A,(2Fh)
EC58  0D                                DEC C
EC59  28 1D                             JR Z,LKFAIL
EC5B  E6 5F                             AND 5Fh
EC5D  B8                                CP B
EC5E  20 F6                             JR NZ,COS2
EC60  7A                                LD A,D
EC61  F6 40                             OR 40h                  ; high nibble
EC63  D3 2F                             OUT (2Fh),A
EC65  47                                LD B,A
EC66  0E 00                             LD C,0
EC68  DB 2F                     COS3:   IN A,(2Fh)
EC6A  0D                                DEC C
EC6B  28 0B                             JR Z,LKFAIL
EC6D  E6 5F                             AND 5Fh
EC6F  B8                                CP B
EC70  20 F6                             JR NZ,COS3
EC72  3E 50                             LD A,50h                ; done
EC74  D3 2F                             OUT (2Fh),A
EC76  AF                                XOR A
EC77  C9                                RET
EC78  3E 07                     LKFAIL: LD A,07h                ; abort
EC7A  D3 2F                             OUT (2Fh),A
EC7C  A7                                AND A
EC7D  C9                                RET
                                
                                ; CONIN: A = key from the terminal, 7 bits (CBIOS FB0Dh). Uses A, BC, DE.
EC7E  CD 8F EC                  CONIN:  CALL CIRECV
EC81  28 0A                             JR Z,CI2
EC83  DB 2F                     CI1:    IN A,(2Fh)
EC85  E6 5F                             AND 5Fh
EC87  FE 07                             CP 07h
EC89  28 F8                             JR Z,CI1
EC8B  18 F1                             JR CONIN
EC8D  78                        CI2:    LD A,B
EC8E  C9                                RET
                                
EC8F  3E 06                     CIRECV: LD A,06h                ; ask for a key
EC91  D3 2F                             OUT (2Fh),A
EC93  DB 2F                             IN A,(2Fh)
EC95  E6 5F                             AND 5Fh
EC97  FE 05                             CP 05h                  ; one is coming
EC99  20 F4                             JR NZ,CIRECV
EC9B  3E 0F                             LD A,0Fh
EC9D  D3 2F                             OUT (2Fh),A
EC9F  0E 00                             LD C,0
ECA1  DB 2F                     CIR1:   IN A,(2Fh)              ; low nibble: 1x
ECA3  0D                                DEC C
ECA4  28 D2                             JR Z,LKFAIL
ECA6  5F                                LD E,A
ECA7  E6 50                             AND 50h
ECA9  FE 10                             CP 10h
ECAB  20 F4                             JR NZ,CIR1
ECAD  7B                                LD A,E
ECAE  D3 2F                             OUT (2Fh),A             ; echo
ECB0  E6 0F                             AND 0Fh
ECB2  5F                                LD E,A
ECB3  0E 00                             LD C,0
ECB5  DB 2F                     CIR2:   IN A,(2Fh)              ; high nibble: 4x
ECB7  0D                                DEC C
ECB8  28 BE                             JR Z,LKFAIL
ECBA  CB 77                             BIT 6,A
ECBC  28 F7                             JR Z,CIR2
ECBE  D3 2F                             OUT (2Fh),A
ECC0  E6 0F                             AND 0Fh
ECC2  07                                RLCA
ECC3  07                                RLCA
ECC4  07                                RLCA
ECC5  07                                RLCA
ECC6  B3                                OR E
ECC7  E6 7F                             AND 7Fh
ECC9  47                                LD B,A
ECCA  DB 2F                     CIR3:   IN A,(2Fh)
ECCC  E6 5F                             AND 5Fh
ECCE  FE 07                             CP 07h
ECD0  28 A6                             JR Z,LKFAIL
ECD2  FE 50                             CP 50h
ECD4  20 F4                             JR NZ,CIR3
ECD6  3E 50                             LD A,50h
ECD8  D3 2F                             OUT (2Fh),A
ECDA  AF                                XOR A
ECDB  C9                                RET
                                
                                ; ---------------------------------------------------------------- disk
                                ; 7 READ / 8 WRITE: AL = drive, DS:BX = buffer, CX = sectors, DX = first
                                ; logical sector. CF=1 on error with AL = DOS error code, CX = sectors left.
ECDC  AF                        T_READ: XOR A
ECDD  18 02                             JR DISKIO
ECDF                            T_WRITE:
ECDF  3E 01                             LD A,1
ECE1  32 14 F1                  DISKIO: LD (DWRITE),A
ECE4  3A 00 D0                          LD A,(R_AL)
ECE7  FE 04                             CP NDRIVE
ECE9  D2 75 ED                          JR NC,DNRDY
ECEC  32 15 F1                          LD (DDRIVE),A
ECEF  2A 1E D0                          LD HL,(B_DS)
ECF2  ED 5B 06 D0                       LD DE,(R_BX)
ECF6  19                                ADD HL,DE
ECF7  22 1B F1                          LD (DADDR),HL
ECFA  CD 63 EE                          CALL HOOK38
ECFD  2A 02 D0                  DLOOP:  LD HL,(R_CX)
ED00  7C                                LD A,H
ED01  B5                                OR L
ED02  28 54                             JR Z,DDONE
ED04  2A 04 D0                          LD HL,(R_DX)
ED07  11 D0 02                          LD DE,NSECT
ED0A  B7                                OR A
ED0B  ED 52                             SBC HL,DE
ED0D  3E 10                             LD A,10h                ; past the last sector: not found
ED0F  30 4D                             JR NC,DFAIL
ED11  2A 1B F1                          LD HL,(DADDR)
ED14  11 01 CF                          LD DE,GTOP-255
ED17  B7                                OR A
ED18  ED 52                             SBC HL,DE
ED1A  3E 01                             LD A,01h                ; buffer beyond the 8086's memory
ED1C  30 40                             JR NC,DFAIL
ED1E  2A 04 D0                          LD HL,(R_DX)            ; track = DX / 18, B; sector = DX MOD 18
ED21  11 EE FF                          LD DE,-SPT
ED24  06 FF                             LD B,0FFh
ED26  04                        DV1:    INC B
ED27  19                                ADD HL,DE
ED28  38 FC                             JR C,DV1
ED2A  78                                LD A,B
ED2B  32 16 F1                          LD (DTRK),A
ED2E  7D                                LD A,L
ED2F  C6 12                             ADD A,SPT
ED31  5F                                LD E,A                  ; sector ID: 2:1 interleave in the track
ED32  16 00                             LD D,0
ED34  21 F8 F0                          LD HL,SKEW
ED37  19                                ADD HL,DE
ED38  7E                                LD A,(HL)
ED39  32 17 F1                          LD (DSEC),A
ED3C  CD 7F ED                          CALL SECTIO
ED3F  20 1D                             JR NZ,DFAIL
ED41  2A 1B F1                          LD HL,(DADDR)
ED44  24                                INC H
ED45  22 1B F1                          LD (DADDR),HL
ED48  2A 04 D0                          LD HL,(R_DX)
ED4B  23                                INC HL
ED4C  22 04 D0                          LD (R_DX),HL
ED4F  2A 02 D0                          LD HL,(R_CX)
ED52  2B                                DEC HL
ED53  22 02 D0                          LD (R_CX),HL
ED56  18 A5                             JR DLOOP
ED58  CD 7A EE                  DDONE:  CALL UNHOOK
ED5B  C3 AC EB                          JP CF0
ED5E  F5                        DFAIL:  PUSH AF
ED5F  CD 7A EE                          CALL UNHOOK
ED62  F1                                POP AF
ED63  21 79 ED                          LD HL,ERRTAB            ; the status's top bit -> DOS error code
ED66  06 05                             LD B,5
ED68  17                        DF1:    RLA
ED69  38 03                             JR C,DF2
ED6B  23                                INC HL
ED6C  10 FA                             DJNZ DF1
ED6E  7E                        DF2:    LD A,(HL)
ED6F  32 00 D0                  DERR:   LD (R_AL),A
ED72  C3 A7 EB                          JP CF1
ED75  3E 02                     DNRDY:  LD A,2                  ; no such drive: not ready
ED77  18 F6                             JR DERR
                                
ED79  06                        ERRTAB: DB 6                    ; 80h seek failed: seek error
ED7A  00                                DB 0                    ; 40h write protect
ED7B  02                                DB 2                    ; 20h no track 0 (no drive): not ready
ED7C  08                                DB 8                    ; 10h record not found
ED7D  04                                DB 4                    ; 08h CRC: data error
ED7E  0C                                DB 0Ch                  ; lost data, bad buffer: general failure
                                
                                ; SECTIO: one sector, DSEC of track DTRK, at DADDR. Z = done; else
                                ; A = status (as ERRTAB).
ED7F  3A 15 F1                  SECTIO: LD A,(DDRIVE)
ED82  CD 12 EE                          CALL SELECT
ED85  C0                                RET NZ
ED86  3E 0A                             LD A,RETRIES
ED88  32 18 F1                          LD (DTRY),A
ED8B  CD E2 ED                  SIO1:   CALL SEEK
ED8E  C0                                RET NZ
ED8F  3A 17 F1                          LD A,(DSEC)
ED92  D3 C2                             OUT (0C2h),A
ED94  2A 1B F1                          LD HL,(DADDR)
ED97  3A 14 F1                          LD A,(DWRITE)           ; XFER's transfer instruction: INI (ED A2)
ED9A  C6 A2                             ADD A,0A2h              ; to read, OUTI (ED A3) to write
ED9C  32 E1 D3                          LD (XFI+1),A
ED9F  3A 14 F1                          LD A,(DWRITE)           ; and the command: 80h read sector,
EDA2  0F                                RRCA                    ; A0h write sector
EDA3  0F                                RRCA
EDA4  0F                                RRCA
EDA5  C6 80                             ADD A,80h
EDA7  CD C0 D3                          CALL XFER
EDAA  B7                                OR A
EDAB  C8                                RET Z
EDAC  CB 77                             BIT 6,A                 ; write protected: no point retrying
EDAE  C0                                RET NZ
EDAF  CB 6F                             BIT 5,A                 ; timed out (no disk, no drive): nor here,
EDB1  C0                                RET NZ                  ; or DOS would wait 10 x 3 s
EDB2  32 1A F1                          LD (DSTAT),A
EDB5  21 18 F1                          LD HL,DTRY
EDB8  35                                DEC (HL)
EDB9  28 08                             JR Z,SIO4
EDBB  7E                                LD A,(HL)               ; half the tries gone: back to track 0, so
EDBC  FE 05                             CP RETRIES/2            ; that SEEK really moves the head again
EDBE  CC C0 D4                          CALL Z,FHOME            ; (it skips a seek to the track it is on)
EDC1  18 C8                             JR SIO1
EDC3  3A 1A F1                  SIO4:   LD A,(DSTAT)
EDC6  B7                                OR A
EDC7  C9                                RET
                                
                                ; Floppy waits time out after about 3 s at 4 MHz: a drive with no disk
                                ; (or no drive) gives the WD177x no index pulses, so a spin-up, a sector
                                ; search or a verify would never end.  FDTOUT then stops the command and
                                ; returns A = 20h (NZ), which DFAIL's ERRTAB turns into DOS's "not ready"
                                ; (error 2).  20h never comes from the FDC itself: its status is ANDed
                                ; with 5Ch on the way out.  The waits that time out: FDCCMD's, FHOME's,
                                ; and XFER's wait for the FIRST data byte; the byte loop itself is CBIOS
                                ; A1.1's, unchanged (the timing that ran on a real FDD3000).
                                
                                ; FDCCMD: command A, wait for INTRQ: A = status AND 5Ch, or A = 20h after
                                ; the timeout.  Corrupts B, DE (8 x 65536 turns of 26 T: ~3.4 s at 4 MHz).
EDC8  ED 56                     FDCCMD: IM 1
EDCA  FB                                EI
EDCB  D3 C0                             OUT (0C0h),A
EDCD  06 08                             LD B,8
EDCF  11 00 00                          LD DE,0
EDD2  1B                        FDCW:   DEC DE                  ; INTRQ ends this through FDCINT
EDD3  7A                                LD A,D
EDD4  B3                                OR E
EDD5  20 FB                             JR NZ,FDCW
EDD7  10 F9                             DJNZ FDCW
EDD9  C3 E4 D4                          JP FDTOUT
                                
EDDC  F1                        FDCINT: POP AF                  ; drop the waiting loop's address
EDDD  DB C0                             IN A,(0C0h)             ; status; clears INTRQ
EDDF  E6 5C                             AND 5Ch
EDE1  C9                                RET                     ; to whoever called the loop (DI stays)
                                
                                ; SEEK: to DTRK with verify (CBIOS FB7Ch). Z = there; NZ, A = 80h failed.
EDE2  3A 16 F1                  SEEK:   LD A,(DTRK)
EDE5  47                                LD B,A
EDE6  DB C1                             IN A,(0C1h)
EDE8  B8                                CP B
EDE9  28 25                             JR Z,SKOK
EDEB  3E 0A                             LD A,RETRIES
EDED  32 19 F1                          LD (STRY),A
EDF0  3A 16 F1                  SK1:    LD A,(DTRK)             ; (from memory: FDCCMD's timer uses B)
EDF3  D3 C3                             OUT (0C3h),A
EDF5  3E 15                             LD A,15h                ; seek, verify
EDF7  CD C8 ED                          CALL FDCCMD
EDFA  CB 6F                             BIT 5,A                 ; timed out: give up at once (A = 20h)
EDFC  C0                                RET NZ
EDFD  E6 18                             AND 18h                 ; seek error, CRC
EDFF  C8                                RET Z
EE00  CD C0 D4                          CALL FHOME
EE03  CB 6F                             BIT 5,A                 ; the restore timed out too
EE05  C0                                RET NZ
EE06  21 19 F1                          LD HL,STRY
EE09  35                                DEC (HL)
EE0A  20 E4                             JR NZ,SK1
EE0C  3E 80                             LD A,80h
EE0E  B7                                OR A
EE0F  C9                                RET
EE10  AF                        SKOK:   XOR A
EE11  C9                                RET
                                
                                
                                
                                ; SELECT: drive A on, head loaded; the FDC track register is set to
                                ; where that drive's head is (CBIOS FA1Eh). A drive not used yet is
                                ; restored first. Z = done; NZ, A = 20h: the restore failed (no drive).
EE12  4F                        SELECT: LD C,A
EE13  3A 0E F1                          LD A,(CURDRV)
EE16  B9                                CP C
EE17  20 05                             JR NZ,SEL0
EE19  CD 49 EE                          CALL LATCHC
EE1C  AF                                XOR A
EE1D  C9                                RET
EE1E  FE 04                     SEL0:   CP NDRIVE
EE20  30 06                             JR NC,SEL1
EE22  CD 5B EE                          CALL TRKPTR             ; keep the old drive's track
EE25  DB C1                             IN A,(0C1h)
EE27  77                                LD (HL),A
EE28  79                        SEL1:   LD A,C
EE29  32 0E F1                          LD (CURDRV),A
EE2C  CD 49 EE                          CALL LATCHC
EE2F  79                                LD A,C
EE30  CD 5B EE                          CALL TRKPTR
EE33  7E                                LD A,(HL)
EE34  FE FF                             CP 0FFh
EE36  28 04                             JR Z,SEL2
EE38  D3 C1                             OUT (0C1h),A
EE3A  AF                                XOR A
EE3B  C9                                RET
EE3C  CD C0 D4                  SEL2:   CALL FHOME
EE3F  C8                                RET Z
EE40  3E FF                             LD A,0FFh               ; restore it again next time
EE42  32 0E F1                          LD (CURDRV),A
EE45  3E 20                             LD A,20h
EE47  B7                                OR A
EE48  C9                                RET
                                
                                ; LATCHC: latch = drive C selected (bits 0-3 low active), side 0 (bit 4
                                ; high), boot ROM off (bit 6 high), head loaded (bit 7 low)
EE49  41                        LATCHC: LD B,C
EE4A  04                                INC B
EE4B  3E FE                             LD A,0FEh
EE4D  05                        LC1:    DEC B
EE4E  28 03                             JR Z,LC2
EE50  07                                RLCA
EE51  18 FA                             JR LC1
EE53  E6 5F                     LC2:    AND 5Fh
EE55  D3 E0                             OUT (0E0h),A
EE57  32 13 F1                          LD (LATCH),A
EE5A  C9                                RET
                                
EE5B  21 0F F1                  TRKPTR: LD HL,TRKTAB
EE5E  85                                ADD A,L
EE5F  6F                                LD L,A
EE60  D0                                RET NC
EE61  24                                INC H
EE62  C9                                RET
                                
                                ; HOOK38 / UNHOOK: point 0038h (the 8086's INT 0Eh vector) at FDCINT for a
                                ; disk call, then put the vector back and unload the head.
EE63  21 38 00                  HOOK38: LD HL,0038h
EE66  11 1D F1                          LD DE,SAV38
EE69  01 03 00                          LD BC,3
EE6C  ED B0                             LDIR
EE6E  3E C3                             LD A,0C3h               ; JP FDCINT
EE70  32 38 00                          LD (0038h),A
EE73  21 DC ED                          LD HL,FDCINT
EE76  22 39 00                          LD (0039h),HL
EE79  C9                                RET
                                
EE7A  F3                        UNHOOK: DI
EE7B  21 1D F1                          LD HL,SAV38
EE7E  11 38 00                          LD DE,0038h
EE81  01 03 00                          LD BC,3
EE84  ED B0                             LDIR
EE86  3A 13 F1                          LD A,(LATCH)
EE89  F6 80                             OR 80h
EE8B  D3 E0                             OUT (0E0h),A
EE8D  32 13 F1                          LD (LATCH),A
EE90  C9                                RET
                                
                                ; 1Bh FORMAT TRACK, for FORMAT.COM: AL = drive, DL = track, DS:BX = the
                                ; track image, FMTLEN bytes as the WD177x write track takes them (F5h =
                                ; sync, F7h = CRC; FORMAT.COM makes it as the CP/M FORMAT 2.0 does). The
                                ; FDC then writes 4Eh until the index pulse. CF=1 on error, AL = DOS error
                                ; code (0 write protect, 2 not ready, 8 no such track, 0Ch buffer).
EE91                            FMTLEN  EQU 32+SPT*332          ; FORMAT.ASM's image
EE91  3A 00 D0                  T_FMT:  LD A,(R_AL)
EE94  FE 04                             CP NDRIVE
EE96  D2 75 ED                          JR NC,DNRDY
EE99  32 15 F1                          LD (DDRIVE),A
EE9C  CD 63 EE                          CALL HOOK38
EE9F  3A 04 D0                          LD A,(R_DL)
EEA2  32 16 F1                          LD (DTRK),A
EEA5  FE 28                             CP NTRACK
EEA7  3E 10                             LD A,10h
EEA9  D2 5E ED                          JP NC,DFAIL
EEAC  2A 1E D0                          LD HL,(B_DS)
EEAF  ED 5B 06 D0                       LD DE,(R_BX)
EEB3  19                                ADD HL,DE
EEB4  22 1B F1                          LD (DADDR),HL
EEB7  11 89 B8                          LD DE,GTOP-FMTLEN+1
EEBA  B7                                OR A
EEBB  ED 52                             SBC HL,DE
EEBD  3E 01                             LD A,01h
EEBF  D2 5E ED                          JP NC,DFAIL
EEC2  3E 01                             LD A,01h                ; restore without verify: no IDs there yet
EEC4  32 0A F1                          LD (RESCMD),A
EEC7  3A 15 F1                          LD A,(DDRIVE)
EECA  CD 12 EE                          CALL SELECT
EECD  47                                LD B,A
EECE  3E 05                             LD A,05h
EED0  32 0A F1                          LD (RESCMD),A
EED3  78                                LD A,B
EED4  C2 5E ED                          JP NZ,DFAIL
EED7  3A 16 F1                          LD A,(DTRK)             ; seek without verify too
EEDA  D3 C3                             OUT (0C3h),A
EEDC  3E 11                             LD A,11h
EEDE  CD C8 ED                          CALL FDCCMD
EEE1  CB 6F                             BIT 5,A                 ; the seek timed out (no disk): not ready.
EEE3  C2 5E ED                          JP NZ,DFAIL             ; (The write track itself is not timed: a
EEE6  2A 1B F1                          LD HL,(DADDR)           ; disk pulled with the motor running hangs it)
EEE9  11 78 17                          LD DE,FMTLEN
EEEC  0E C3                             LD C,0C3h
EEEE  3E FE                             LD A,0FEh               ; write track, as FORMAT 2.0
EEF0  D3 C0                             OUT (0C0h),A
EEF2  DB 2F                     FT1:    IN A,(2Fh)              ; bit 7 = DRQ
EEF4  87                                ADD A,A
EEF5  30 19                             JR NC,FT3
EEF7  ED A3                             OUTI
EEF9  1B                                DEC DE
EEFA  7A                                LD A,D
EEFB  B3                                OR E
EEFC  20 F4                             JR NZ,FT1
EEFE  DB 2F                     FT2:    IN A,(2Fh)              ; gap 4Eh until the index pulse ends it
EF00  87                                ADD A,A
EF01  30 06                             JR NC,FT4
EF03  3E 4E                             LD A,4Eh
EF05  D3 C3                             OUT (0C3h),A
EF07  18 F5                             JR FT2
EF09  DB C0                     FT4:    IN A,(0C0h)
EF0B  1F                                RRA
EF0C  38 F0                             JR C,FT2
EF0E  18 05                             JR FT5
EF10  DB C0                     FT3:    IN A,(0C0h)
EF12  1F                                RRA
EF13  38 DD                             JR C,FT1
EF15  DB C0                     FT5:    IN A,(0C0h)
EF17  E6 40                             AND 40h                 ; write protect
EF19  C2 5E ED                          JP NZ,DFAIL
EF1C  C3 58 ED                          JP DDONE
                                
                                ; 9 DSKCHG: AH=0, don't know
EF1F                            T_DSKCHG:
EF1F  AF                                XOR A
EF20  32 01 D0                          LD (R_AH),A
EF23  C3 AC EB                          JP CF0
                                
                                ; ---------------------------------------------------------------- clock
                                ; 10 SETDATE: AX = days since 1-1-80
EF26                            T_SDATE:
EF26  2A 00 D0                          LD HL,(R_AX)
EF29  22 20 F1                          LD (DAYS),HL
EF2C  C9                                RET
                                
                                ; 11 SETTIME: CH hour, CL minute, DH second, DL 1/100
EF2D                            T_STIME:
EF2D  2A 02 D0                          LD HL,(R_CX)
EF30  22 22 F1                          LD (CLKCX),HL
EF33  2A 04 D0                          LD HL,(R_DX)
EF36  22 24 F1                          LD (CLKDX),HL
EF39  C9                                RET
                                
                                ; 12 GETTIME: AX = days, CX and DX as SETTIME
EF3A                            T_GTIME:
EF3A  2A 20 F1                          LD HL,(DAYS)
EF3D  22 00 D0                          LD (R_AX),HL
EF40  2A 22 F1                          LD HL,(CLKCX)
EF43  22 02 D0                          LD (R_CX),HL
EF46  2A 24 F1                          LD HL,(CLKDX)
EF49  22 04 D0                          LD (R_DX),HL
EF4C  C9                                RET
                                
                                ; ---------------------------------------------------------------- PC ROM BIOS
                                ; The parts PC-DOS programs (IBM's DEBUG, CHKDSK...) use, on the VT52
                                ; terminal: as fddos.rom_bios.
                                
                                ; INT 10h video
EF4D  3A 01 D0                  T_I10:  LD A,(R_AH)
EF50  FE 0E                             CP 0Eh                  ; teletype
EF52  20 06                             JR NZ,I10A
EF54  3A 00 D0                          LD A,(R_AL)
EF57  C3 21 EC                          JP CONOUT
EF5A  FE 0F                     I10A:   CP 0Fh                  ; mode: 80 columns, mono
EF5C  20 0B                             JR NZ,I10B
EF5E  21 07 50                          LD HL,5007h
EF61  22 00 D0                          LD (R_AX),HL
EF64  AF                                XOR A
EF65  32 07 D0                          LD (R_BH),A
EF68  C9                                RET
EF69  FE 02                     I10B:   CP 02h                  ; cursor to DH, DL: ESC Y row col
EF6B  20 26                             JR NZ,I10C
EF6D  3E 1B                             LD A,1Bh
EF6F  CD 21 EC                          CALL CONOUT
EF72  3E 59                             LD A,59h
EF74  CD 21 EC                          CALL CONOUT
EF77  3A 05 D0                          LD A,(R_DH)
EF7A  FE 17                             CP 23
EF7C  38 02                             JR C,I10B1
EF7E  3E 17                             LD A,23
EF80  C6 20                     I10B1:  ADD A,32
EF82  CD 21 EC                          CALL CONOUT
EF85  3A 04 D0                          LD A,(R_DL)
EF88  FE 4F                             CP 79
EF8A  38 02                             JR C,I10B2
EF8C  3E 4F                             LD A,79
EF8E  C6 20                     I10B2:  ADD A,32
EF90  C3 21 EC                          JP CONOUT
EF93  FE 03                     I10C:   CP 03h                  ; read cursor: not tracked
EF95  20 0D                             JR NZ,I10D
EF97  21 00 00                          LD HL,0
EF9A  22 04 D0                          LD (R_DX),HL
EF9D  21 07 06                          LD HL,0607h
EFA0  22 02 D0                          LD (R_CX),HL
EFA3  C9                                RET
EFA4  FE 06                     I10D:   CP 06h                  ; scroll with AL=0: clear the screen
EFA6  28 04                             JR Z,I10D1
EFA8  FE 07                             CP 07h
EFAA  20 19                             JR NZ,I10E
EFAC  3A 00 D0                  I10D1:  LD A,(R_AL)
EFAF  B7                                OR A
EFB0  C0                                RET NZ
EFB1  3E 1B                             LD A,1Bh
EFB3  CD 21 EC                          CALL CONOUT
EFB6  3E 48                             LD A,48h                ; ESC H
EFB8  CD 21 EC                          CALL CONOUT
EFBB  3E 1B                             LD A,1Bh
EFBD  CD 21 EC                          CALL CONOUT
EFC0  3E 4A                             LD A,4Ah                ; ESC J
EFC2  C3 21 EC                          JP CONOUT
EFC5  FE 09                     I10E:   CP 09h                  ; AL, CX times
EFC7  28 03                             JR Z,I10E1
EFC9  FE 0A                             CP 0Ah
EFCB  C0                                RET NZ
EFCC  2A 02 D0                  I10E1:  LD HL,(R_CX)
EFCF  7C                        I10E2:  LD A,H
EFD0  B5                                OR L
EFD1  C8                                RET Z
EFD2  E5                                PUSH HL
EFD3  3A 00 D0                          LD A,(R_AL)
EFD6  CD 21 EC                          CALL CONOUT
EFD9  E1                                POP HL
EFDA  2B                                DEC HL
EFDB  18 F2                             JR I10E2
                                
                                ; INT 11h equipment: 2 floppies, 80x25 mono
EFDD  21 71 00                  T_I11:  LD HL,0071h
EFE0  22 00 D0                          LD (R_AX),HL
EFE3  C9                                RET
                                
                                ; INT 12h memory in KB
EFE4  21 34 00                  T_I12:  LD HL,GTOP/1024
EFE7  22 00 D0                          LD (R_AX),HL
EFEA  C9                                RET
                                
                                ; INT 16h keyboard: AH=0 wait, AH=1 look (ZF=1 none)
EFEB  3A 01 D0                  T_I16:  LD A,(R_AH)
EFEE  B7                                OR A
EFEF  20 0A                             JR NZ,I16A
EFF1  CD 13 EC                          CALL GETKEY
EFF4  6F                                LD L,A
EFF5  26 00                             LD H,0
EFF7  22 00 D0                          LD (R_AX),HL
EFFA  C9                                RET
EFFB  3D                        I16A:   DEC A
EFFC  20 0F                             JR NZ,I16B
EFFE  CD F6 EB                          CALL PEEKEY
F001  D2 9D EB                          JP NC,ZF1
F004  6F                                LD L,A
F005  26 00                             LD H,0
F007  22 00 D0                          LD (R_AX),HL
F00A  C3 A2 EB                          JP ZF0
F00D  AF                        I16B:   XOR A
F00E  32 00 D0                          LD (R_AL),A
F011  C9                                RET
                                
                                ; INT 14h serial: DX = 0 channel A, 1 channel B. AH = 0 set up from AL
                                ; (PC format), 1 send AL, 2 receive into AL, 3 status, 4 set up from BX
                                ; and CX (PS/2 format). Returns AH = line status (bit 7: timed out) and
                                ; AL = modem status (but the byte received, for AH = 2).
F012  2A 04 D0                  T_I14:  LD HL,(R_DX)
F015  0E 81                             LD C,81h
F017  7C                                LD A,H
F018  B7                                OR A
F019  C0                                RET NZ
F01A  B5                                OR L
F01B  28 04                             JR Z,I14A
F01D  3D                                DEC A
F01E  C0                                RET NZ
F01F  0E 41                             LD C,41h
F021  3A 01 D0                  I14A:   LD A,(R_AH)
F024  B7                                OR A
F025  CA C9 D5                          JP Z,I14INI             ; (in I86.ASM)
F028  3D                                DEC A
F029  28 0C                             JR Z,I14PUT
F02B  3D                                DEC A
F02C  28 15                             JR Z,I14GET
F02E  3D                                DEC A
F02F  CA BF D0                          JP Z,SSTAT
F032  3D                                DEC A
F033  C0                                RET NZ
F034  C3 A2 D5                          JP I14EXT               ; 4 (in I86.ASM, with 0)
F037  3A 00 D0                  I14PUT: LD A,(R_AL)
F03A  5F                                LD E,A
F03B  21 FF FF                          LD HL,0FFFFh            ; about 1.5 s
F03E  CD 48 D0                          CALL SPUT
F041  18 07                             JR I14T
F043  21 FF FF                  I14GET: LD HL,0FFFFh
F046  CD 67 D0                          CALL SGET
F049  5F                                LD E,A
F04A  9F                        I14T:   SBC A,A                 ; CF: timed out
F04B  E6 80                             AND 80h
F04D  57                                LD D,A
F04E  D5                                PUSH DE
F04F  CD BF D0                          CALL SSTAT
F052  D1                                POP DE
F053  7B                                LD A,E
F054  32 00 D0                          LD (R_AL),A
F057  21 01 D0                          LD HL,R_AH
F05A  7A                                LD A,D
F05B  B6                                OR (HL)
F05C  77                                LD (HL),A
F05D  C9                                RET
                                
                                ; INT 17h printer (channel A, whatever DX is): AH = 0 print AL, 1 set up
                                ; (nothing to do), 2 status. AH = 90h ready, 10h busy (no DSR), +1 timed out.
F05E  0E 81                     T_I17:  LD C,81h
F060  1E 00                             LD E,0
F062  3A 01 D0                          LD A,(R_AH)
F065  B7                                OR A
F066  20 0E                             JR NZ,I17A
F068  3A 00 D0                          LD A,(R_AL)
F06B  5F                                LD E,A
F06C  21 FF FF                          LD HL,0FFFFh
F06F  CD 48 D0                          CALL SPUT
F072  9F                                SBC A,A
F073  E6 01                             AND 1
F075  5F                                LD E,A
F076  ED 78                     I17A:   IN A,(C)
F078  17                                RLA
F079  3E 10                             LD A,10h
F07B  30 02                             JR NC,I17B
F07D  3E 90                             LD A,90h
F07F  B3                        I17B:   OR E
F080  32 01 D0                          LD (R_AH),A
F083  C9                                RET
                                
                                ; INT 1Ah AH=0: CX:DX = ticks (one more each call), AL = 0
F084  3A 01 D0                  T_I1A:  LD A,(R_AH)
F087  B7                                OR A
F088  C0                                RET NZ
F089  32 00 D0                          LD (R_AL),A
F08C  2A 28 F1                          LD HL,(TICKS+2)
F08F  22 02 D0                          LD (R_CX),HL
F092  2A 26 F1                          LD HL,(TICKS)
F095  22 04 D0                          LD (R_DX),HL
F098  23                                INC HL
F099  22 26 F1                          LD (TICKS),HL
F09C  7C                                LD A,H
F09D  B5                                OR L
F09E  C0                                RET NZ
F09F  2A 28 F1                          LD HL,(TICKS+2)
F0A2  23                                INC HL
F0A3  22 28 F1                          LD (TICKS+2),HL
F0A6  C9                                RET
                                
                                ; ---------------------------------------------------------------- CP/M
                                ; 1Ch: CPM.COM's Z80 part (CPMZ80.ASM), which runs CP/M programs. BP =
                                ; its linear address: a length word, the BIOS addresses it was assembled
                                ; with (CPMSYM), then the code, for ENDBIOS. It is copied there; a
                                ; CPM.COM made for another build of Z86.SYS gets CF=1 instead. BP = 0:
                                ; run it (T_CPM, at ENDBIOS).
F0A7  2A 0A D0                  T_CPML: LD HL,(R_BP)
F0AA  7C                                LD A,H
F0AB  B5                                OR L
F0AC  CA 2C F1                          JP Z,ENDBIOS
F0AF  4E                                LD C,(HL)
F0B0  23                                INC HL
F0B1  46                                LD B,(HL)
F0B2  23                                INC HL
F0B3  C5                                PUSH BC
F0B4  11 DC F0                          LD DE,CPMSYM
F0B7  06 0E                             LD B,CPMSYE-CPMSYM
F0B9  1A                        TL1:    LD A,(DE)
F0BA  BE                                CP (HL)
F0BB  20 0D                             JR NZ,TL2
F0BD  13                                INC DE
F0BE  23                                INC HL
F0BF  10 F8                             DJNZ TL1
F0C1  C1                                POP BC
F0C2  11 2C F1                          LD DE,ENDBIOS
F0C5  ED B0                             LDIR
F0C7  C3 AC EB                          JP CF0
F0CA  C1                        TL2:    POP BC
F0CB  C3 A7 EB                          JP CF1
                                
                                ; 1Dh: the end of an INT 21h that CPMZ80's DOSCALL started: back to
                                ; DOSCALL's caller, on the Z80 stack it had
F0CE  2A 2A F1                  T_RET:  LD HL,(DCSP)
F0D1  7C                                LD A,H
F0D2  B5                                OR L
F0D3  C8                                RET Z
F0D4  F9                                LD SP,HL
F0D5  21 00 00                          LD HL,0
F0D8  22 2A F1                          LD (DCSP),HL
F0DB  C9                                RET
                                
F0DC  3B D8 60 EB F6 EB 13 EC   CPMSYM: DW NEXT, JPHL, PEEKEY, GETKEY, CONOUT, DCSP, ENDBIOS
F0DC  21 EC 2A F1 2C F1         
F0EA                            CPMSYE:
                                
                                ; Free bytes.  SKEW, the variables and ENDBIOS stay where the 2026-11-07
                                ; build had them (SKEW at F0F8h): CPM.COM's Z80 part, assembled for those
                                ; addresses and checked by trap 1Ch, then needs no rebuild.  z86.py
                                ; asserts this padding never goes negative.
F0EA                            SKEWAT  EQU 0F0F8h
F0EA  00 00 00 00 00 00 00 00           DS SKEWAT-$
F0EA  00 00 00 00 00 00         
                                
                                ; ---------------------------------------------------------------- data
F0F8  00 02 04 06 08 0A 0C 0E   SKEW:   DB 0,2,4,6,8,10,12,14,16,1,3,5,7,9,11,13,15,17
F0F8  10 01 03 05 07 09 0B 0D   
F0F8  0F 11                     
F10A  05                        RESCMD: DB 05h                  ; FHOME's restore: verify (FORMAT: 01h)
F10B  00                        KFLAG:  DB 0                    ; 1: KBUF holds a key
F10C  00                        KBUF:   DB 0
F10D  00                        COCHR:  DB 0
F10E  FF                        CURDRV: DB 0FFh                 ; drive selected last (FFh none yet)
F10F  FF FF FF FF               TRKTAB: DB 0FFh,0FFh,0FFh,0FFh  ; head position per drive (FFh unknown)
F113  FF                        LATCH:  DB 0FFh
F114  00                        DWRITE: DB 0
F115  00                        DDRIVE: DB 0
F116  00                        DTRK:   DB 0
F117  00                        DSEC:   DB 0
F118  00                        DTRY:   DB 0
F119  00                        STRY:   DB 0
F11A  00                        DSTAT:  DB 0
F11B  00 00                     DADDR:  DW 0
F11D  00 00 00                  SAV38:  DB 0,0,0
F120  00 00                     DAYS:   DW 0
F122  00 00                     CLKCX:  DW 0
F124  00 00                     CLKDX:  DW 0
F126  00 00 00 00               TICKS:  DW 0,0
F12A  00 00                     DCSP:   DW 0                    ; CPMZ80: Z80 SP in DOSCALL (0: none)
                                
                                ; ENDBIOS: CPM.COM's Z80 part (CPMZ80.ASM) is copied here, over COLD, which
                                ; is needed only at boot.
F12C                            ENDBIOS:
                                ; ---------------------------------------------------------------- cold boot
                                ; COLD: from the boot sector (BOOT.ASM) through D0FDh, with this image
                                ; (Z86.SYS) at D000h and the boot ROM paged out. Clears the 8086 vectors,
                                ; reads the first directory sector, then IO.SYS (entry 1) to 0040:0000
                                ; and MSDOS.SYS (entry 2) to 0060:0000 through READ - each contiguous
                                ; from its first cluster, as FORMAT /S and mkfat write them - and starts
                                ; the 8086 at 0040:0000 with CS = DS = 0040h, as fddos.boot does. A read
                                ; error or a missing file prints a message and stops.
F12C                            DIRBUF  EQU 0C000h              ; in the 8086's memory, free at boot
F12C  F3                        COLD:   DI
F12D  31 00 00                          LD SP,0
F130  0E 81                             LD C,81h                ; both serial channels as CBIOS A1.1 sets
F132  11 08 8E                          LD DE,8E08h             ;   them: 8 bits, no parity, 1.5 stop bits,
F135  CD A2 D0                          CALL SSET               ;   1200 baud (code 8)
F138  0E 41                             LD C,41h
F13A  CD A2 D0                          CALL SSET
F13D  21 00 00                          LD HL,0
F140  11 01 00                          LD DE,1
F143  01 FF 03                          LD BC,3FFh
F146  75                                LD (HL),L
F147  ED B0                             LDIR
F149  21 00 C0                          LD HL,DIRBUF
F14C  11 01 00                          LD DE,1
F14F  01 05 00                          LD BC,FIRDIR
F152  CD C7 F1                          CALL CLOAD
F155  21 20 C0                          LD HL,DIRBUF+32
F158  11 0B F2                          LD DE,IONAM
F15B  01 00 04                          LD BC,0400h
F15E  3E 03                             LD A,3                  ; under 3 sectors: MSDOS.SYS is at 0600h
F160  CD 97 F1                          CALL CFILE
F163  21 40 C0                          LD HL,DIRBUF+64
F166  11 16 F2                          LD DE,DOSNAM
F169  01 00 06                          LD BC,0600h
F16C  3E 29                             LD A,41                 ; 10 KB at most
F16E  CD 97 F1                          CALL CFILE
F171  21 00 D0                          LD HL,R_AX              ; AX-DI and the segment registers: 0
F174  06 18                             LD B,24
F176  36 00                     CB1:    LD (HL),0
F178  23                                INC HL
F179  10 FB                             DJNZ CB1
F17B  21 40 00                          LD HL,40h
F17E  22 12 D0                          LD (R_CS),HL
F181  22 16 D0                          LD (R_DS),HL
F184  21 00 00                          LD HL,0
F187  22 2A D0                          LD (TMP),HL             ; IP
F18A  AF                                XOR A
F18B  32 24 D0                          LD (FLAGHI),A
F18E  21 00 01                          LD HL,0100h             ; F' = 0, A' = 1 (odd: PF = 0)
F191  E5                                PUSH HL
F192  F1                                POP AF
F193  08                                EX AF,AF'
F194  C3 00 D8                          JP START
                                
                                ; CFILE: directory entry HL, which must be named as at DE, to 0000:BC;
                                ; fewer than A sectors
F197  C5                        CFILE:  PUSH BC
F198  F5                                PUSH AF
F199  E5                                PUSH HL
F19A  06 0B                             LD B,11
F19C  1A                        CFL1:   LD A,(DE)
F19D  BE                                CP (HL)
F19E  20 44                             JR NZ,CBAD
F1A0  13                                INC DE
F1A1  23                                INC HL
F1A2  10 F8                             DJNZ CFL1
F1A4  E1                                POP HL
F1A5  11 1A 00                          LD DE,26
F1A8  19                                ADD HL,DE
F1A9  5E                                LD E,(HL)               ; DE = first cluster
F1AA  23                                INC HL
F1AB  56                                LD D,(HL)
F1AC  23                                INC HL
F1AD  7E                                LD A,(HL)               ; size -> sectors
F1AE  23                                INC HL
F1AF  B7                                OR A
F1B0  7E                                LD A,(HL)
F1B1  28 01                             JR Z,CFL2
F1B3  3C                                INC A
F1B4  C1                        CFL2:   POP BC                  ; B = the limit
F1B5  B8                                CP B
F1B6  30 2C                             JR NC,CBAD
F1B8  EB                                EX DE,HL
F1B9  2B                                DEC HL                  ; logical sector = FIRREC + 4 (cluster - 2)
F1BA  2B                                DEC HL
F1BB  29                                ADD HL,HL
F1BC  29                                ADD HL,HL
F1BD  01 0D 00                          LD BC,FIRREC
F1C0  09                                ADD HL,BC
F1C1  44                                LD B,H
F1C2  4D                                LD C,L
F1C3  5F                                LD E,A
F1C4  16 00                             LD D,0
F1C6  E1                                POP HL
                                ; CLOAD: DE sectors from logical sector BC of drive A to 0000:HL
F1C7  22 06 D0                  CLOAD:  LD (R_BX),HL
F1CA  ED 53 02 D0                       LD (R_CX),DE
F1CE  ED 43 04 D0                       LD (R_DX),BC
F1D2  AF                                XOR A
F1D3  32 00 D0                          LD (R_AL),A
F1D6  67                                LD H,A
F1D7  6F                                LD L,A
F1D8  22 1E D0                          LD (B_DS),HL
F1DB  CD DC EC                          CALL T_READ
F1DE  2A 02 D0                          LD HL,(R_CX)
F1E1  7C                                LD A,H
F1E2  B5                                OR L
F1E3  C8                                RET Z
F1E4  21 F5 F1                  CBAD:   LD HL,BOOTMSG
F1E7  7E                        CB2:    LD A,(HL)
F1E8  B7                                OR A
F1E9  28 08                             JR Z,CB3
F1EB  E5                                PUSH HL
F1EC  CD 21 EC                          CALL CONOUT
F1EF  E1                                POP HL
F1F0  23                                INC HL
F1F1  18 F4                             JR CB2
F1F3  F3                        CB3:    DI
F1F4  76                                HALT
                                
F1F5                            BOOTMSG:
F1F5  0D 0A 44 69 73 6B 20 62           DB 13,10,'Disk boot failure',13,10,0
F1F5  6F 6F 74 20 66 61 69 6C   
F1F5  75 72 65 0D 0A 00         
F20B  49 4F 20 20 20 20 20 20   IONAM:  DB 'IO      SYS'
F20B  53 59 53                  
F216  4D 53 44 4F 53 20 20 20   DOSNAM: DB 'MSDOS   SYS'
F216  53 59 53                  
F221                            BIOSEND:                        ; the end of Z86.SYS
                                ; CPMZ80.ASM - the Z80 part of CPM.COM: CP/M 2.2 programs on the FDD3000's
                                ; Z80, under MS-DOS 1.25.
                                ;
                                ; Assembled by z86.py after I86.ASM and BIOS.ASM, with their symbols, at
                                ; ENDBIOS: over the BIOS's COLD, which only the boot needs (the ORG below
                                ; moves the address, not the output). build.py puts it in CPM.COM
                                ; (CPMZ80.INC). BIOS trap 1Ch copies it to ENDBIOS; trap 1Ch with BP = 0 then jumps to T_CPM, with
                                ; CPM.COM's registers:
                                ;   BX = SWLEN: CPM.COM's end, linear; DOS, COMMAND and CPM.COM are below
                                ;   DX = P: the page above the program's memory (TPA = 0100h to P)
                                ;   CX = program bytes, staged at linear SWLEN
                                ;   SI = linear address of FCB1 (16), FCB2 (16), command tail (128)
                                ;   DI = DOSLEN: CPM.COM's PSP + 256, linear
                                ;   AL = current drive
                                ; The 8086's memory is 0000h-CFFFh, DOS at the bottom where a CP/M
                                ; program must run. So 0000h-SWLEN is exchanged with SAVE (P+200h, up
                                ; to the top that DOS gave CPM.COM, below COMMAND), the program moved to
                                ; 0100h, and it runs. Console calls go to the BIOS's console code. For a
                                ; file call the BDOS copies the FCB (and a record being written) to the
                                ; P area, exchanges DOS (0000h-DOSLEN) back in, runs the 8086
                                ; interpreter on INT 21h there (DOSCALL; trap 1Dh returns), and
                                ; exchanges it out again: DOS 1.25's FCB calls are CP/M's, record size
                                ; 128. Sequential reads and writes go through BUF, so one exchange moves
                                ; up to NBUF records. The program ends (warm boot) with DOS exchanged
                                ; back and a return from the trap to CPM.COM.
                                ;
                                ; P area (in the 8086's memory, above the program's):
F221                            PBDOS   EQU 06h                 ; JP BDOSE: (0006h) points here
F221                            PSTUB   EQU 09h                 ; 8086: INT 21h, TRAP 1Dh
F221                            PFCB    EQU 10h                 ; the FCB of a call (37 bytes)
F221                            PSRCH   EQU 38h                 ; the FCB of search first / next
F221                            PDTA    EQU 60h                 ; DOS's DTA (128 bytes)
F221                            PBIOS   EQU 100h                ; BIOS jump table, (0001h) = P+103h
F221                            PSTK    EQU 200h                ; 8086 stack (DOS uses about 26 bytes)
F221                            PSIZE   EQU 200h
F221                            NBUF    EQU 8                   ; records in BUF
                                
                                
                                        END
                                
