F052  9F                        I14T:   SBC A,A                 ; CF: timed out
F053  E6 80                             AND 80h
F055  57                                LD D,A
F056  D5                                PUSH DE
F057  CD C8 D0                          CALL SSTAT
F05A  D1                                POP DE
F05B  7B                                LD A,E
F05C  32 00 D0                          LD (R_AL),A
F05F  21 01 D0                          LD HL,R_AH
