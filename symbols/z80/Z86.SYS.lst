                                ; DIVU: HL:DE / (DIVISOR), A = bits (16, or 8 with the dividend in HL:D)
                                ; HL < divisor. Out: DE = quotient, HL = remainder.
EA34  C5                        DIVU:   PUSH BC
EA35  ED 4B 2E D0                       LD BC,(DIVISOR)
EA39  CB 23                     DIVU1:  SLA E
EA3B  CB 12                             RL D
EA3D  ED 6A                             ADC HL,HL
EA3F  38 07                             JR C,DIVU2              ; 17 bits: certainly >= divisor
EA41  ED 42                             SBC HL,BC
EA43  30 06                             JR NC,DIVU3
EA45  09                                ADD HL,BC
EA46  18 04                             JR DIVU4
EA48  B7                        DIVU2:  OR A
EA49  ED 42                             SBC HL,BC
EA4B  1C                        DIVU3:  INC E
EA4C  3D                        DIVU4:  DEC A
EA4D  20 EA                             JR NZ,DIVU1
EA4F  C1                                POP BC
EA50  C9                                RET
                                
                                ; SDIV: signed HL:DE / (DIVISOR) -> DE = |q|, HL = |r|, QNEG / RNEG bit 7
                                ; = their signs; Z80 C = quotient over 16 bits.
EA51  7C                        SDIV:   LD A,H
EA52  32 3A D0                          LD (RNEG),A
EA55  17                                RLA
EA56  30 0F                             JR NC,SDIV1
EA58  AF                                XOR A                   ; |dividend|
EA59  93                                SUB E
EA5A  5F                                LD E,A
EA5B  3E 00                             LD A,0
EA5D  9A                                SBC A,D
EA5E  57                                LD D,A
EA5F  3E 00                             LD A,0
EA61  9D                                SBC A,L
EA62  6F                                LD L,A
EA63  3E 00                             LD A,0
EA65  9C                                SBC A,H
EA66  67                                LD H,A
EA67  E5                        SDIV1:  PUSH HL
EA68  2A 2E D0                          LD HL,(DIVISOR)
EA6B  3A 3A D0                          LD A,(RNEG)
EA6E  AC                                XOR H
EA6F  32 39 D0                          LD (QNEG),A
EA72  CB 7C                             BIT 7,H
EA74  28 09                             JR Z,SDIV2
EA76  AF                                XOR A
EA77  95                                SUB L
EA78  6F                                LD L,A
EA79  9F                                SBC A,A
EA7A  94                                SUB H
EA7B  67                                LD H,A
EA7C  22 2E D0                          LD (DIVISOR),HL
EA7F  E3                        SDIV2:  EX (SP),HL              ; HL = |dividend| high, (SP) = |divisor|
EA80  EB                                EX DE,HL
EA81  E3                                EX (SP),HL              ; HL = |divisor|, (SP) = low
EA82  EB                                EX DE,HL                ; DE = |divisor|, HL = high
EA83  B7                                OR A
EA84  ED 52                             SBC HL,DE
EA86  19                                ADD HL,DE
EA87  D1                                POP DE
EA88  3F                                CCF
EA89  D8                                RET C
EA8A  3E 10                             LD A,16
EA8C  CD 34 EA                          CALL DIVU
EA8F  B7                                OR A
EA90  C9                                RET
                                
                                ; FE: INC / DEC r/m8
EA91  0A                        O_GRP4: LD A,(BC)
EA92  03                                INC BC
EA93  F5                                PUSH AF
EA94  CD 19 D9                          CALL EAB
EA97  F1                                POP AF
EA98  E6 38                             AND 38h
EA9A  28 0B                             JR Z,G4INC
EA9C  FE 08                             CP 08h
EA9E  C2 BA D8                          JP NZ,O_BAD
EAA1  08                                EX AF,AF'
EAA2  35                                DEC (HL)
EAA3  7E                                LD A,(HL)
EAA4  08                                EX AF,AF'
EAA5  DD E9                             JP (IX)
EAA7  08                        G4INC:  EX AF,AF'
EAA8  34                                INC (HL)
EAA9  7E                                LD A,(HL)
EAAA  08                                EX AF,AF'
EAAB  DD E9                             JP (IX)
                                
                                ; FF: INC DEC CALL CALLF JMP JMPF PUSH
EAAD  0A                        O_GRP5: LD A,(BC)
EAAE  03                                INC BC
EAAF  F5                                PUSH AF
EAB0  CD 0E D9                          CALL EAW
EAB3  F1                                POP AF
EAB4  E6 38                             AND 38h
EAB6  0F                                RRCA
EAB7  0F                                RRCA
EAB8  11 BE EA                          LD DE,G5T
EABB  C3 0B DA                          JP JTAB
EABE  CE EA DD EA E7 EA FA EA   G5T:    DW G5_INC, G5_DEC, G5_CALL, G5_CALLF, G5_JMP, G5_JMPF, G5_PUSH, G5_PUSH
EABE  15 EB 20 EB 2B EB 2B EB   
                                
EACE  E5                        G5_INC: PUSH HL
EACF  7E                                LD A,(HL)
EAD0  23                                INC HL
EAD1  66                                LD H,(HL)
EAD2  6F                                LD L,A
EAD3  CD 80 D5                          CALL INC16
EAD6  EB                        G5ST:   EX DE,HL
EAD7  E1                                POP HL
EAD8  73                                LD (HL),E
EAD9  23                                INC HL
EADA  72                                LD (HL),D
EADB  DD E9                             JP (IX)
EADD  E5                        G5_DEC: PUSH HL
EADE  7E                                LD A,(HL)
EADF  23                                INC HL
EAE0  66                                LD H,(HL)
EAE1  6F                                LD L,A
EAE2  CD 8C D5                          CALL DEC16
EAE5  18 EF                             JR G5ST
EAE7                            G5_CALL:
EAE7  5E                                LD E,(HL)
EAE8  23                                INC HL
EAE9  56                                LD D,(HL)
EAEA  D5                                PUSH DE
EAEB  CD 18 DA                          CALL GETIP
EAEE  CD 31 DA                          CALL PUSHDE
EAF1  D1                                POP DE
EAF2  2A 1A D0                          LD HL,(B_CS)
EAF5  19                                ADD HL,DE
EAF6  44                                LD B,H
EAF7  4D                                LD C,L
EAF8  DD E9                             JP (IX)
EAFA                            G5_CALLF:
EAFA  5E                                LD E,(HL)
EAFB  23                                INC HL
EAFC  56                                LD D,(HL)
EAFD  23                                INC HL
EAFE  D5                                PUSH DE
EAFF  5E                                LD E,(HL)
EB00  23                                INC HL
EB01  56                                LD D,(HL)
EB02  D5                                PUSH DE
EB03  ED 5B 12 D0                       LD DE,(R_CS)
EB07  CD 31 DA                          CALL PUSHDE
EB0A  CD 18 DA                          CALL GETIP
EB0D  CD 31 DA                          CALL PUSHDE
EB10  E1                                POP HL
EB11  D1                                POP DE
EB12  C3 22 DA                          JP FARJ
EB15  5E                        G5_JMP: LD E,(HL)
EB16  23                                INC HL
EB17  56                                LD D,(HL)
EB18  2A 1A D0                          LD HL,(B_CS)
EB1B  19                                ADD HL,DE
EB1C  44                                LD B,H
EB1D  4D                                LD C,L
EB1E  DD E9                             JP (IX)
EB20                            G5_JMPF:
EB20  5E                                LD E,(HL)
EB21  23                                INC HL
EB22  56                                LD D,(HL)
EB23  23                                INC HL
EB24  7E                                LD A,(HL)
EB25  23                                INC HL
EB26  66                                LD H,(HL)
EB27  6F                                LD L,A
EB28  C3 22 DA                          JP FARJ
EB2B                            G5_PUSH:
EB2B  5E                                LD E,(HL)
EB2C  23                                INC HL
EB2D  56                                LD D,(HL)
EB2E  CD 31 DA                          CALL PUSHDE
EB31  DD E9                             JP (IX)
                                
EB33                            ENDCODE:
                                ; BIOS.ASM - the BIOS traps of IOFDD.SYS in Z80 code, for the FDD3000.
                                ;
                                ; Assembled after I86.ASM (z86.build(bios=True)). The 8086 opcode 0F nn
                                ; calls TRAP with A = nn. A handler reads and writes the 8086 registers in
                                ; REGS and sets ZF / CF in AF' (the 8086 flags); TRAP keeps BC (the 8086
                                ; code pointer) and IX (the dispatcher).
                                ;
                                ; The hardware code is CBIOS A1.1's, which runs on real FDD3000s:
                                ;   console  the nibble protocol to the terminal on port 2Fh (CBIOS FAA8h
                                ;            send, FB0Dh receive, F719h status)
                                ;   disk     WD177x on C0h-C3h, drive latch E0h, DRQ in bit 7 of port 2Fh.
                                ;            A command ends with INTRQ on the Z80 INT line (IM 1, RST 38h):
                                ;            0038h is pointed at FDCINT for the duration of a disk call,
                                ;            which leaves the transfer loop and returns the status (CBIOS
                                ;            FBE2h / FC0Ch).
                                ;
                                ; The FDD3000 has no clock: the date and time are what DOS last set
                                ; (1-1-80 0:00 at boot), and INT 1Ah's tick count goes up by one per call.
                                
EB33                            NDRIVE  EQU 4                   ; drives on the latch
EB33                            SPT     EQU 18                  ; sectors per track, IDs 0-17
EB33                            NTRACK  EQU 40
EB33                            NSECT   EQU NTRACK*SPT          ; 720
EB33                            FIRDIR  EQU 5                   ; the disk layout (mkfat.py): boot sector,
EB33                            FIRREC  EQU 13                  ; 2 FATs of 2 sectors, 8 directory sectors
EB33                            GTOP    EQU 0D000h              ; end of the 8086's memory
EB33                            RETRIES EQU 10
                                
                                ; ---------------------------------------------------------------- dispatch
EB33  C5                        TRAP:   PUSH BC
EB34  DD E5                             PUSH IX
EB36  FE 1E                             CP 1Eh                  ; entries in TTAB
EB38  30 0F                             JR NC,TRAPX
EB3A  87                                ADD A,A
EB3B  6F                                LD L,A
EB3C  26 00                             LD H,0
EB3E  11 4E EB                          LD DE,TTAB
EB41  19                                ADD HL,DE
EB42  5E                                LD E,(HL)
EB43  23                                INC HL
EB44  56                                LD D,(HL)
EB45  EB                                EX DE,HL
EB46  CD 4D EB                          CALL JPHL
EB49  DD E1                     TRAPX:  POP IX
EB4B  C1                                POP BC
EB4C  C9                        TNONE:  RET
EB4D  E9                        JPHL:   JP (HL)
                                
EB4E  4C EB A7 EB B3 EB BA EB   TTAB:   DW TNONE, T_STAT, T_INP, T_OUTP         ; 0-3
EB56  C0 EB CC EB C6 EB C9 EC           DW T_PRINT, T_AUXIN, T_AUXOUT, T_READ   ; 4-7
EB5E  CC EC 0C EF 13 EF 1A EF           DW T_WRITE, T_DSKCHG, T_SDATE, T_STIME  ; 8-11
EB66  27 EF D3 EB 4C EB 4C EB           DW T_GTIME, T_FLUSH, TNONE, TNONE       ; 12, 13, 14 MAPDEV, 15
EB6E  3A EF CA EF D1 EF 4C EB           DW T_I10, T_I11, T_I12, TNONE           ; 10h-13h: IBM PC ROM BIOS
EB76  FF EF 4C EB D8 EF 66 F0           DW T_I14, TNONE, T_I16, T_I17           ; 14h-17h
EB7E  4C EB 4C EB 8C F0                 DW TNONE, TNONE, T_I1A                  ; 18h-1Ah
EB84  7E EE AF F0 D6 F0                 DW T_FMT, T_CPML, T_RET                 ; 1Bh: FORMAT.COM, 1Ch-1Dh: CPM.COM
EB8A                            TTEND:
                                
                                ; 8086 flags in F': F' = F' AND D OR E
EB8A  11 40 BF                  ZF1:    LD DE,0BF40h
EB8D  18 0D                             JR FSET
EB8F  11 00 BF                  ZF0:    LD DE,0BF00h
EB92  18 08                             JR FSET
EB94  11 01 FE                  CF1:    LD DE,0FE01h
EB97  18 03                             JR FSET
EB99  11 00 FE                  CF0:    LD DE,0FE00h
EB9C  08                        FSET:   EX AF,AF'
EB9D  F5                                PUSH AF
EB9E  E1                                POP HL
EB9F  7D                                LD A,L
EBA0  A2                                AND D
EBA1  B3                                OR E
EBA2  6F                                LD L,A
EBA3  E5                                PUSH HL
EBA4  F1                                POP AF
EBA5  08                                EX AF,AF'
EBA6  C9                                RET
                                
                                ; ---------------------------------------------------------------- console
                                ; 1 STATUS: ZF=1 no key; else ZF=0, AL = the key (left for INP)
EBA7  CD E3 EB                  T_STAT: CALL PEEKEY
EBAA  D2 8A EB                          JP NC,ZF1
EBAD  32 00 D0                          LD (R_AL),A
EBB0  C3 8F EB                          JP ZF0
                                
                                ; 2 INP: AL = key (waits)
EBB3  CD 00 EC                  T_INP:  CALL GETKEY
EBB6  32 00 D0                          LD (R_AL),A
EBB9  C9                                RET
                                
                                ; 3 OUTP: AL to the screen
EBBA  3A 00 D0                  T_OUTP: LD A,(R_AL)
EBBD  C3 0E EC                          JP CONOUT
                                
                                ; 4 PRINT: AL to the printer (WD2123 channel A); 6 AUXOUT: AL to AUX
                                ; (channel B); 5 AUXIN: AL from AUX. They wait as long as it takes, as
                                ; CP/M's LIST, PUNCH and READER do (the serial routines are in I86.ASM's
                                ; register page).
EBC0                            T_PRINT:
EBC0  3A 00 D0                          LD A,(R_AL)
EBC3  C3 3E D0                          JP SPRN
EBC6                            T_AUXOUT:
EBC6  3A 00 D0                          LD A,(R_AL)
EBC9  C3 42 D0                          JP SAUXO
EBCC                            T_AUXIN:
EBCC  CD 62 D0                          CALL SAUXI
EBCF  32 00 D0                          LD (R_AL),A
EBD2  C9                                RET
                                
                                ; 13 FLUSH: drop the keys typed ahead
EBD3                            T_FLUSH:
EBD3  AF                                XOR A
EBD4  32 0B F1                          LD (KFLAG),A
EBD7  DB 2F                     FL1:    IN A,(2Fh)
EBD9  E6 5F                             AND 5Fh
EBDB  FE 04                             CP 04h
EBDD  C0                                RET NZ
EBDE  CD 6B EC                          CALL CONIN
EBE1  18 F4                             JR FL1
                                
                                ; PEEKEY: CF=1 and A = the next key, which stays for GETKEY; CF=0 none.
                                ; The link can't look at a key without taking it, so it is kept here.
EBE3  3A 0B F1                  PEEKEY: LD A,(KFLAG)
EBE6  B7                                OR A
EBE7  20 12                             JR NZ,PK1
EBE9  DB 2F                             IN A,(2Fh)
EBEB  E6 5F                             AND 5Fh
EBED  EE 04                             XOR 04h                 ; the terminal has a key? (XOR, not CP: CP
EBEF  C0                                RET NZ                  ; left carry set below 04h - a phantom key)
EBF0  CD 6B EC                          CALL CONIN
EBF3  32 0C F1                          LD (KBUF),A
EBF6  3E 01                             LD A,1
EBF8  32 0B F1                          LD (KFLAG),A
EBFB  3A 0C F1                  PK1:    LD A,(KBUF)
EBFE  37                                SCF
EBFF  C9                                RET
                                
                                ; GETKEY: A = next key (waits)
EC00  21 0B F1                  GETKEY: LD HL,KFLAG
EC03  7E                                LD A,(HL)
EC04  B7                                OR A
EC05  CA 6B EC                          JP Z,CONIN
EC08  36 00                             LD (HL),0
EC0A  3A 0C F1                          LD A,(KBUF)
EC0D  C9                                RET
                                
                                ; CONOUT: A to the terminal (CBIOS FAA8h). Uses A, BC, DE.
EC0E  32 0D F1                  CONOUT: LD (COCHR),A
EC11  3A 0D F1                  CO1:    LD A,(COCHR)
EC14  47                                LD B,A
EC15  CD 23 EC                          CALL COSEND
EC18  C8                                RET Z
EC19  DB 2F                     CO2:    IN A,(2Fh)              ; timed out: wait for the terminal's abort
EC1B  E6 5F                             AND 5Fh
EC1D  FE 07                             CP 07h
EC1F  20 F8                             JR NZ,CO2
EC21  18 EE                             JR CO1
                                
                                ; COSEND: B in two nibbles, each echoed back. Z = sent.
EC23  78                        COSEND: LD A,B
EC24  E6 0F                             AND 0Fh
EC26  5F                                LD E,A
EC27  78                                LD A,B
EC28  E6 F0                             AND 0F0h
EC2A  0F                                RRCA
EC2B  0F                                RRCA
EC2C  0F                                RRCA
EC2D  0F                                RRCA
EC2E  57                                LD D,A
EC2F  3E 0A                     COS1:   LD A,0Ah                ; ask to send
EC31  D3 2F                             OUT (2Fh),A
EC33  DB 2F                             IN A,(2Fh)
EC35  E6 5F                             AND 5Fh
EC37  FE 0F                             CP 0Fh                  ; terminal ready
EC39  20 F4                             JR NZ,COS1
EC3B  7B                                LD A,E
EC3C  F6 10                             OR 10h                  ; low nibble
EC3E  D3 2F                             OUT (2Fh),A
EC40  47                                LD B,A
EC41  0E 00                             LD C,0
EC43  DB 2F                     COS2:   IN A,(2Fh)
EC45  0D                                DEC C
EC46  28 1D                             JR Z,LKFAIL
EC48  E6 5F                             AND 5Fh
EC4A  B8                                CP B
EC4B  20 F6                             JR NZ,COS2
EC4D  7A                                LD A,D
EC4E  F6 40                             OR 40h                  ; high nibble
EC50  D3 2F                             OUT (2Fh),A
EC52  47                                LD B,A
EC53  0E 00                             LD C,0
EC55  DB 2F                     COS3:   IN A,(2Fh)
EC57  0D                                DEC C
EC58  28 0B                             JR Z,LKFAIL
EC5A  E6 5F                             AND 5Fh
EC5C  B8                                CP B
EC5D  20 F6                             JR NZ,COS3
EC5F  3E 50                             LD A,50h                ; done
EC61  D3 2F                             OUT (2Fh),A
EC63  AF                                XOR A
EC64  C9                                RET
EC65  3E 07                     LKFAIL: LD A,07h                ; abort
EC67  D3 2F                             OUT (2Fh),A
EC69  A7                                AND A
EC6A  C9                                RET
                                
                                ; CONIN: A = key from the terminal, 7 bits (CBIOS FB0Dh). Uses A, BC, DE.
EC6B  CD 7C EC                  CONIN:  CALL CIRECV
EC6E  28 0A                             JR Z,CI2
EC70  DB 2F                     CI1:    IN A,(2Fh)
EC72  E6 5F                             AND 5Fh
EC74  FE 07                             CP 07h
EC76  28 F8                             JR Z,CI1
EC78  18 F1                             JR CONIN
EC7A  78                        CI2:    LD A,B
EC7B  C9                                RET
                                
EC7C  3E 06                     CIRECV: LD A,06h                ; ask for a key
EC7E  D3 2F                             OUT (2Fh),A
EC80  DB 2F                             IN A,(2Fh)
EC82  E6 5F                             AND 5Fh
EC84  FE 05                             CP 05h                  ; one is coming
EC86  20 F4                             JR NZ,CIRECV
EC88  3E 0F                             LD A,0Fh
EC8A  D3 2F                             OUT (2Fh),A
EC8C  0E 00                             LD C,0
EC8E  DB 2F                     CIR1:   IN A,(2Fh)              ; low nibble: 1x
EC90  0D                                DEC C
EC91  28 D2                             JR Z,LKFAIL
EC93  5F                                LD E,A
EC94  E6 50                             AND 50h
EC96  FE 10                             CP 10h
EC98  20 F4                             JR NZ,CIR1
EC9A  7B                                LD A,E
EC9B  D3 2F                             OUT (2Fh),A             ; echo
EC9D  E6 0F                             AND 0Fh
EC9F  5F                                LD E,A
ECA0  0E 00                             LD C,0
ECA2  DB 2F                     CIR2:   IN A,(2Fh)              ; high nibble: 4x
ECA4  0D                                DEC C
ECA5  28 BE                             JR Z,LKFAIL
ECA7  CB 77                             BIT 6,A
ECA9  28 F7                             JR Z,CIR2
ECAB  D3 2F                             OUT (2Fh),A
ECAD  E6 0F                             AND 0Fh
ECAF  07                                RLCA
ECB0  07                                RLCA
ECB1  07                                RLCA
ECB2  07                                RLCA
ECB3  B3                                OR E
ECB4  E6 7F                             AND 7Fh
ECB6  47                                LD B,A
ECB7  DB 2F                     CIR3:   IN A,(2Fh)
ECB9  E6 5F                             AND 5Fh
ECBB  FE 07                             CP 07h
ECBD  28 A6                             JR Z,LKFAIL
ECBF  FE 50                             CP 50h
ECC1  20 F4                             JR NZ,CIR3
ECC3  3E 50                             LD A,50h
ECC5  D3 2F                             OUT (2Fh),A
ECC7  AF                                XOR A
ECC8  C9                                RET
                                
                                ; ---------------------------------------------------------------- disk
                                ; 7 READ / 8 WRITE: AL = drive, DS:BX = buffer, CX = sectors, DX = first
                                ; logical sector. CF=1 on error with AL = DOS error code, CX = sectors left.
ECC9  AF                        T_READ: XOR A
ECCA  18 02                             JR DISKIO
ECCC                            T_WRITE:
ECCC  3E 01                             LD A,1
ECCE  32 14 F1                  DISKIO: LD (DWRITE),A
ECD1  3A 00 D0                          LD A,(R_AL)
ECD4  FE 04                             CP NDRIVE
ECD6  D2 62 ED                          JR NC,DNRDY
ECD9  32 15 F1                          LD (DDRIVE),A
ECDC  2A 1E D0                          LD HL,(B_DS)
ECDF  ED 5B 06 D0                       LD DE,(R_BX)
ECE3  19                                ADD HL,DE
ECE4  22 1B F1                          LD (DADDR),HL
ECE7  CD 50 EE                          CALL HOOK38
ECEA  2A 02 D0                  DLOOP:  LD HL,(R_CX)
ECED  7C                                LD A,H
ECEE  B5                                OR L
ECEF  28 54                             JR Z,DDONE
ECF1  2A 04 D0                          LD HL,(R_DX)
ECF4  11 D0 02                          LD DE,NSECT
ECF7  B7                                OR A
ECF8  ED 52                             SBC HL,DE
ECFA  3E 10                             LD A,10h                ; past the last sector: not found
ECFC  30 4D                             JR NC,DFAIL
ECFE  2A 1B F1                          LD HL,(DADDR)
ED01  11 01 CF                          LD DE,GTOP-255
ED04  B7                                OR A
ED05  ED 52                             SBC HL,DE
ED07  3E 01                             LD A,01h                ; buffer beyond the 8086's memory
ED09  30 40                             JR NC,DFAIL
ED0B  2A 04 D0                          LD HL,(R_DX)            ; track = DX / 18, B; sector = DX MOD 18
ED0E  11 EE FF                          LD DE,-SPT
ED11  06 FF                             LD B,0FFh
ED13  04                        DV1:    INC B
ED14  19                                ADD HL,DE
ED15  38 FC                             JR C,DV1
ED17  78                                LD A,B
ED18  32 16 F1                          LD (DTRK),A
ED1B  7D                                LD A,L
ED1C  C6 12                             ADD A,SPT
ED1E  5F                                LD E,A                  ; sector ID: 2:1 interleave in the track
ED1F  16 00                             LD D,0
ED21  21 F8 F0                          LD HL,SKEW
ED24  19                                ADD HL,DE
ED25  7E                                LD A,(HL)
ED26  32 17 F1                          LD (DSEC),A
ED29  CD 6C ED                          CALL SECTIO
ED2C  20 1D                             JR NZ,DFAIL
ED2E  2A 1B F1                          LD HL,(DADDR)
ED31  24                                INC H
ED32  22 1B F1                          LD (DADDR),HL
ED35  2A 04 D0                          LD HL,(R_DX)
ED38  23                                INC HL
ED39  22 04 D0                          LD (R_DX),HL
ED3C  2A 02 D0                          LD HL,(R_CX)
ED3F  2B                                DEC HL
ED40  22 02 D0                          LD (R_CX),HL
ED43  18 A5                             JR DLOOP
ED45  CD 67 EE                  DDONE:  CALL UNHOOK
ED48  C3 99 EB                          JP CF0
ED4B  F5                        DFAIL:  PUSH AF
ED4C  CD 67 EE                          CALL UNHOOK
ED4F  F1                                POP AF
ED50  21 66 ED                          LD HL,ERRTAB            ; the status's top bit -> DOS error code
ED53  06 05                             LD B,5
ED55  17                        DF1:    RLA
ED56  38 03                             JR C,DF2
ED58  23                                INC HL
ED59  10 FA                             DJNZ DF1
ED5B  7E                        DF2:    LD A,(HL)
ED5C  32 00 D0                  DERR:   LD (R_AL),A
ED5F  C3 94 EB                          JP CF1
ED62  3E 02                     DNRDY:  LD A,2                  ; no such drive: not ready
ED64  18 F6                             JR DERR
                                
ED66  06                        ERRTAB: DB 6                    ; 80h seek failed: seek error
ED67  00                                DB 0                    ; 40h write protect
ED68  02                                DB 2                    ; 20h no track 0 (no drive): not ready
ED69  08                                DB 8                    ; 10h record not found
ED6A  04                                DB 4                    ; 08h CRC: data error
ED6B  0C                                DB 0Ch                  ; lost data, bad buffer: general failure
                                
                                ; SECTIO: one sector, DSEC of track DTRK, at DADDR. Z = done; else
                                ; A = status (as ERRTAB).
ED6C  3A 15 F1                  SECTIO: LD A,(DDRIVE)
ED6F  CD FF ED                          CALL SELECT
ED72  C0                                RET NZ
ED73  3E 0A                             LD A,RETRIES
ED75  32 18 F1                          LD (DTRY),A
ED78  CD CF ED                  SIO1:   CALL SEEK
ED7B  C0                                RET NZ
ED7C  3A 17 F1                          LD A,(DSEC)
ED7F  D3 C2                             OUT (0C2h),A
ED81  2A 1B F1                          LD HL,(DADDR)
ED84  3A 14 F1                          LD A,(DWRITE)           ; XFER's transfer instruction: INI (ED A2)
ED87  C6 A2                             ADD A,0A2h              ; to read, OUTI (ED A3) to write
ED89  32 FA D3                          LD (XFI+1),A
ED8C  3A 14 F1                          LD A,(DWRITE)           ; and the command: 80h read sector,
ED8F  0F                                RRCA                    ; A0h write sector
ED90  0F                                RRCA
ED91  0F                                RRCA
ED92  C6 80                             ADD A,80h
ED94  CD D9 D3                          CALL XFER
ED97  B7                                OR A
ED98  C8                                RET Z
ED99  CB 77                             BIT 6,A                 ; write protected: no point retrying
ED9B  C0                                RET NZ
ED9C  CB 6F                             BIT 5,A                 ; timed out (no disk, no drive): nor here,
ED9E  C0                                RET NZ                  ; or DOS would wait 10 x 3 s
ED9F  32 1A F1                          LD (DSTAT),A
EDA2  21 18 F1                          LD HL,DTRY
EDA5  35                                DEC (HL)
EDA6  28 08                             JR Z,SIO4
EDA8  7E                                LD A,(HL)               ; half the tries gone: back to track 0, so
EDA9  FE 05                             CP RETRIES/2            ; that SEEK really moves the head again
EDAB  CC D8 D4                          CALL Z,FHOME            ; (it skips a seek to the track it is on)
EDAE  18 C8                             JR SIO1
EDB0  3A 1A F1                  SIO4:   LD A,(DSTAT)
EDB3  B7                                OR A
EDB4  C9                                RET
                                
                                ; Floppy waits time out after about 3 s at 4 MHz: a drive with no disk
                                ; (or no drive) gives the WD177x no index pulses, so a spin-up, a sector
                                ; search or a verify would never end.  FDTOUT then stops the command and
                                ; returns A = 20h (NZ), which DFAIL's ERRTAB turns into DOS's "not ready"
                                ; (error 2).  20h never comes from the FDC itself: its status is ANDed
                                ; with 5Ch on the way out.  The waits that time out: FDCCMD's, FHOME's,
                                ; and XFER's wait for the FIRST data byte; the byte loop itself is CBIOS
                                ; A1.1's, unchanged (the timing that ran on a real FDD3000).
                                
                                ; FDCCMD: command A, wait for INTRQ: A = status AND 5Ch, or A = 20h after
                                ; the timeout.  Corrupts B, DE (8 x 65536 turns of 26 T: ~3.4 s at 4 MHz).
EDB5  ED 56                     FDCCMD: IM 1
EDB7  FB                                EI
EDB8  D3 C0                             OUT (0C0h),A
EDBA  06 08                             LD B,8
EDBC  11 00 00                          LD DE,0
EDBF  1B                        FDCW:   DEC DE                  ; INTRQ ends this through FDCINT
EDC0  7A                                LD A,D
EDC1  B3                                OR E
EDC2  20 FB                             JR NZ,FDCW
EDC4  10 F9                             DJNZ FDCW
EDC6  C3 06 D5                          JP FDTOUT
                                
EDC9  F1                        FDCINT: POP AF                  ; drop the waiting loop's address
EDCA  DB C0                             IN A,(0C0h)             ; status; clears INTRQ
EDCC  E6 5C                             AND 5Ch
EDCE  C9                                RET                     ; to whoever called the loop (DI stays)
                                
                                ; SEEK: to DTRK with verify (CBIOS FB7Ch). Z = there; NZ, A = 80h failed.
EDCF  3A 16 F1                  SEEK:   LD A,(DTRK)
EDD2  47                                LD B,A
EDD3  DB C1                             IN A,(0C1h)
EDD5  B8                                CP B
EDD6  28 25                             JR Z,SKOK
EDD8  3E 0A                             LD A,RETRIES
EDDA  32 19 F1                          LD (STRY),A
EDDD  3A 16 F1                  SK1:    LD A,(DTRK)             ; (from memory: FDCCMD's timer uses B)
EDE0  D3 C3                             OUT (0C3h),A
EDE2  3E 15                             LD A,15h                ; seek, verify
EDE4  CD B5 ED                          CALL FDCCMD
EDE7  CB 6F                             BIT 5,A                 ; timed out: give up at once (A = 20h)
EDE9  C0                                RET NZ
EDEA  E6 18                             AND 18h                 ; seek error, CRC
EDEC  C8                                RET Z
EDED  CD D8 D4                          CALL FHOME
EDF0  CB 6F                             BIT 5,A                 ; the restore timed out too
EDF2  C0                                RET NZ
EDF3  21 19 F1                          LD HL,STRY
EDF6  35                                DEC (HL)
EDF7  20 E4                             JR NZ,SK1
EDF9  3E 80                             LD A,80h
EDFB  B7                                OR A
EDFC  C9                                RET
EDFD  AF                        SKOK:   XOR A
EDFE  C9                                RET
                                
                                
                                
                                
                                ; SELECT: drive A on, head loaded; the FDC track register is set to
                                ; where that drive's head is (CBIOS FA1Eh). A drive not used yet is
                                ; restored first. Z = done; NZ, A = 20h: the restore failed (no drive).
EDFF  4F                        SELECT: LD C,A
EE00  3A 0E F1                          LD A,(CURDRV)
EE03  B9                                CP C
EE04  20 05                             JR NZ,SEL0
EE06  CD 36 EE                          CALL LATCHC
EE09  AF                                XOR A
EE0A  C9                                RET
EE0B  FE 04                     SEL0:   CP NDRIVE
EE0D  30 06                             JR NC,SEL1
EE0F  CD 48 EE                          CALL TRKPTR             ; keep the old drive's track
EE12  DB C1                             IN A,(0C1h)
EE14  77                                LD (HL),A
EE15  79                        SEL1:   LD A,C
EE16  32 0E F1                          LD (CURDRV),A
EE19  CD 36 EE                          CALL LATCHC
EE1C  79                                LD A,C
EE1D  CD 48 EE                          CALL TRKPTR
EE20  7E                                LD A,(HL)
EE21  FE FF                             CP 0FFh
EE23  28 04                             JR Z,SEL2
EE25  D3 C1                             OUT (0C1h),A
EE27  AF                                XOR A
EE28  C9                                RET
EE29  CD D8 D4                  SEL2:   CALL FHOME
EE2C  C8                                RET Z
EE2D  3E FF                             LD A,0FFh               ; restore it again next time
EE2F  32 0E F1                          LD (CURDRV),A
EE32  3E 20                             LD A,20h
EE34  B7                                OR A
EE35  C9                                RET
                                
                                ; LATCHC: latch = drive C selected (bits 0-3 low active), side 0 (bit 4
                                ; high), boot ROM off (bit 6 high), head loaded (bit 7 low)
EE36  41                        LATCHC: LD B,C
EE37  04                                INC B
EE38  3E FE                             LD A,0FEh
EE3A  05                        LC1:    DEC B
EE3B  28 03                             JR Z,LC2
EE3D  07                                RLCA
EE3E  18 FA                             JR LC1
EE40  E6 5F                     LC2:    AND 5Fh
EE42  D3 E0                             OUT (0E0h),A
EE44  32 13 F1                          LD (LATCH),A
EE47  C9                                RET
                                
EE48  21 0F F1                  TRKPTR: LD HL,TRKTAB
EE4B  85                                ADD A,L
EE4C  6F                                LD L,A
EE4D  D0                                RET NC
EE4E  24                                INC H
EE4F  C9                                RET
                                
                                ; HOOK38 / UNHOOK: point 0038h (the 8086's INT 0Eh vector) at FDCINT for a
                                ; disk call, then put the vector back and unload the head.
EE50  21 38 00                  HOOK38: LD HL,0038h
EE53  11 1D F1                          LD DE,SAV38
EE56  01 03 00                          LD BC,3
EE59  ED B0                             LDIR
EE5B  3E C3                             LD A,0C3h               ; JP FDCINT
EE5D  32 38 00                          LD (0038h),A
EE60  21 C9 ED                          LD HL,FDCINT
EE63  22 39 00                          LD (0039h),HL
EE66  C9                                RET
                                
EE67  F3                        UNHOOK: DI
EE68  21 1D F1                          LD HL,SAV38
EE6B  11 38 00                          LD DE,0038h
EE6E  01 03 00                          LD BC,3
EE71  ED B0                             LDIR
EE73  3A 13 F1                          LD A,(LATCH)
EE76  F6 80                             OR 80h
EE78  D3 E0                             OUT (0E0h),A
EE7A  32 13 F1                          LD (LATCH),A
EE7D  C9                                RET
                                
                                ; 1Bh FORMAT TRACK, for FORMAT.COM: AL = drive, DL = track, DS:BX = the
                                ; track image, FMTLEN bytes as the WD177x write track takes them (F5h =
                                ; sync, F7h = CRC; FORMAT.COM makes it as the CP/M FORMAT 2.0 does). The
                                ; FDC then writes 4Eh until the index pulse. CF=1 on error, AL = DOS error
                                ; code (0 write protect, 2 not ready, 8 no such track, 0Ch buffer).
EE7E                            FMTLEN  EQU 32+SPT*332          ; FORMAT.ASM's image
EE7E  3A 00 D0                  T_FMT:  LD A,(R_AL)
EE81  FE 04                             CP NDRIVE
EE83  D2 62 ED                          JR NC,DNRDY
EE86  32 15 F1                          LD (DDRIVE),A
EE89  CD 50 EE                          CALL HOOK38
EE8C  3A 04 D0                          LD A,(R_DL)
EE8F  32 16 F1                          LD (DTRK),A
EE92  FE 28                             CP NTRACK
EE94  3E 10                             LD A,10h
EE96  D2 4B ED                          JP NC,DFAIL
EE99  2A 1E D0                          LD HL,(B_DS)
EE9C  ED 5B 06 D0                       LD DE,(R_BX)
EEA0  19                                ADD HL,DE
EEA1  22 1B F1                          LD (DADDR),HL
EEA4  11 89 B8                          LD DE,GTOP-FMTLEN+1
EEA7  B7                                OR A
EEA8  ED 52                             SBC HL,DE
EEAA  3E 01                             LD A,01h
EEAC  D2 4B ED                          JP NC,DFAIL
EEAF  3E 01                             LD A,01h                ; restore without verify: no IDs there yet
EEB1  32 0A F1                          LD (RESCMD),A
EEB4  3A 15 F1                          LD A,(DDRIVE)
EEB7  CD FF ED                          CALL SELECT
EEBA  47                                LD B,A
EEBB  3E 05                             LD A,05h
EEBD  32 0A F1                          LD (RESCMD),A
EEC0  78                                LD A,B
EEC1  C2 4B ED                          JP NZ,DFAIL
EEC4  3A 16 F1                          LD A,(DTRK)             ; seek without verify too
EEC7  D3 C3                             OUT (0C3h),A
EEC9  3E 11                             LD A,11h
