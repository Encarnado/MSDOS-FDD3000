                                ; ---------------------------------------------- shift / rotate loops
                                ; 16-bit at k*16, 8-bit at 128 + k*16 (k = ModR/M reg field).
                                ; In: HL (L) = value, D = count > 0; stack: old AF', operand address.
                                ; Out: Z80 C = last bit out, then a finisher sets the flags and stores.
D700                            SHPG:
D700  29                        S16R0:  ADD HL,HL               ; 0 ROL
D701  30 01                             JR NC,S16R0A
D703  2C                                INC L
D704  15                        S16R0A: DEC D
D705  20 F9                             JR NZ,S16R0
D707  C3 21 E6                          JP ROT16A
D70A  00 00 00 00 00 00                 DS SHPG+16-$
D710  CB 3C                     S16R1:  SRL H                   ; 1 ROR
D712  CB 1D                             RR L
D714  30 02                             JR NC,S16R1A
D716  CB FC                             SET 7,H
D718  15                        S16R1A: DEC D
D719  20 F5                             JR NZ,S16R1
D71B  C3 30 E6                          JP ROT16B
D71E  00 00                             DS SHPG+32-$
