; Z86.SYS: I86.ASM + BIOS.ASM (macros expanded), loaded at D000h
; address  bytes  source
                                ; I86.ASM - 8086 interpreter for the Timex FDD3000 (Z80), runs MS-DOS 1.25.
                                ;
                                ; Assembled by z86.py (tmxcobol's z80asm plus ;@FOR / ;@TABLE expansion).
                                ; cpu86.py is the reference: this must do exactly what it does.
                                ;
                                ; Guest memory: 8086 linear address n is Z80 address n, 0000h-CFFFh (52 KB).
                                ; A segment's base (seg << 4) is kept with it, so an operand's host address
                                ; is base + offset, both 16 bits.
                                ;
                                ; Z80 registers while 8086 code runs:
                                ;   BC   host address of the next 8086 code byte (CS base + IP)
                                ;   IX   NEXT, the dispatcher: every handler ends with JP (IX)
                                ;   AF'  the 8086 arithmetic flags. F' holds S Z AF(H) OF(V) CF(C) in the
                                ;        Z80 positions; A' is the low byte of the last result, PF is its
                                ;        parity. Only flag code does EX AF,AF'.
                                ;   A, DE, HL, IY, SP  scratch (SP is the Z80 stack)
                                ;
                                ; The 8086 registers live in memory (REGS), so a ModR/M operand is always a
                                ; host pointer: into guest memory, or into REGS for a register.
                                ;
                                ; Known differences from an 8086: AF after 16-bit add/subtract/inc/dec is
                                ; the Z80's (carry from bit 11, not bit 3); segment wrap above 64 KB is not
                                ; modelled (the guest has 52 KB).
                                
                                        ORG 0D000h
                                
                                ; ---------------------------------------------------------------- REGS page
D000                            REGS:
D000                            R_AX    EQU REGS+0
D000                            R_AL    EQU REGS+0
D000                            R_AH    EQU REGS+1
D000                            R_CX    EQU REGS+2
D000                            R_CL    EQU REGS+2
D000                            R_CH    EQU REGS+3
D000                            R_DX    EQU REGS+4
D000                            R_DL    EQU REGS+4
D000                            R_DH    EQU REGS+5
D000                            R_BX    EQU REGS+6
D000                            R_BL    EQU REGS+6
D000                            R_BH    EQU REGS+7
D000                            R_SP    EQU REGS+8
D000                            R_BP    EQU REGS+10
D000                            R_SI    EQU REGS+12
D000                            R_DI    EQU REGS+14
D000                            R_ES    EQU REGS+16             ; segment registers, 2 * sreg + 16
D000                            R_CS    EQU REGS+18
D000                            R_SS    EQU REGS+20
D000                            R_DS    EQU REGS+22
D000                            B_ES    EQU REGS+24             ; their bases (seg << 4), 2 * sreg + 24
D000                            B_CS    EQU REGS+26
D000                            B_SS    EQU REGS+28
D000                            B_DS    EQU REGS+30
D000                            EADS    EQU REGS+32             ; base for DS-relative operands (override aware)
D000                            EASS    EQU REGS+34             ; base for SS-relative operands (override aware)
D000                            FLAGHI  EQU REGS+36             ; FLAGS bits 8-10: TF IF DF
D000                            REPT    EQU REGS+37             ; F2h / F3h: the REP prefix of a string op
D000                            STEP1   EQU REGS+38             ; +1 / -1 by DF
D000                            STEP2   EQU REGS+40             ; +2 / -2 by DF
D000                            TMP     EQU REGS+42
D000                            TMP2    EQU REGS+44
D000                            DIVISOR EQU REGS+46
D000                            R8TAB   EQU REGS+48             ; reg8 number -> offset: AL CL DL BL AH CH DH BH
D000                            SHCNT   EQU REGS+56             ; shift count
D000                            QNEG    EQU REGS+57             ; bit 7: quotient negative
D000                            RNEG    EQU REGS+58             ; bit 7: remainder (dividend) negative
D000                            SHORIG  EQU REGS+60             ; operand before a shift
D000  00 00 00 00 00 00 00 00           DS 48
D000  00 00 00 00 00 00 00 00   
D000  00 00 00 00 00 00 00 00   
D000  00 00 00 00 00 00 00 00   
D000  00 00 00 00 00 00 00 00   
D000  00 00 00 00 00 00 00 00   
D030  00 02 04 06 01 03 05 07           DB 0,2,4,6,1,3,5,7
D038  00 00 00 00 00 00                 DS REGS+62-$
                                
                                ; ---- serial channels, for BIOS.ASM and CPMZ80.ASM. They are here, in the
                                ; free end of the register page, so that they take no room above the BIOS
                                ; (where CPM.COM's Z80 part goes).
                                ;
                                ; The FDD3000's WD2123 holds two 8251A-compatible channels with their own
                                ; baud-rate generators: channel A data 80h, control and status 81h, baud
                                ; 10h; channel B 40h, 41h, 11h. Status bits: 0 TxRDY, 1 RxRDY, 2 TxEMPTY,
                                ; 3 parity, 4 overrun, 5 framing error, 6 break, 7 DSR. As in CBIOS A1.1,
                                ; the printer is channel A (CP/M's LIST) and AUX channel B (PUNCH, READER).
                                ; C = the channel's control port throughout.
                                
                                ; SPRN, SAUXO: A to channel A, B; SAUXI: A from channel B; SLSTS: A = FFh
                                ; if channel A's DSR is on, else 0. They wait for ever, as CBIOS A1.1.
D03E  0E 81                     SPRN:   LD C,81h
D040  18 02                             JR SPF
D042  0E 41                     SAUXO:  LD C,41h
D044  5F                        SPF:    LD E,A
D045  21 00 00                          LD HL,0
                                ; SPUT: E to the channel when DSR and TxRDY are on. HL: polls before
                                ; giving up with CF=1 (0: for ever).
D048  3E 27                     SPUT:   LD A,27h                ; transmit, receive, DTR, RTS on
D04A  ED 79                             OUT (C),A
D04C  CD 98 D0                          CALL SERR
D04F  ED 78                     SP1:    IN A,(C)
D051  E6 81                             AND 81h
D053  FE 81                             CP 81h
D055  28 06                             JR Z,SP2
D057  CD 8F D0                          CALL SWAIT
D05A  30 F3                             JR NC,SP1
D05C  C9                                RET
D05D  0D                        SP2:    DEC C
D05E  ED 59                             OUT (C),E
D060  0C                                INC C
D061  C9                                RET
D062  0E 41                     SAUXI:  LD C,41h
D064  21 00 00                          LD HL,0
                                ; SGET: A = a byte from the channel; HL as SPUT. RTS is on only while
                                ; waiting, as CBIOS A1.1's READER does.
D067  3E 27                     SGET:   LD A,27h
D069  ED 79                             OUT (C),A
D06B  CD 98 D0                  SG1:    CALL SERR
D06E  ED 78                             IN A,(C)
D070  CB 4F                             BIT 1,A
D072  20 06                             JR NZ,SG2
D074  CD 8F D0                          CALL SWAIT
D077  30 F2                             JR NC,SG1
D079  C9                                RET
D07A  0D                        SG2:    DEC C
D07B  ED 58                             IN E,(C)
D07D  0C                                INC C
D07E  3E 07                             LD A,07h
D080  ED 79                             OUT (C),A
D082  7B                                LD A,E
D083  B7                                OR A
D084  C9                                RET
D085  0E 81                     SLSTS:  LD C,81h
D087  CD 98 D0                          CALL SERR
D08A  ED 78                             IN A,(C)
D08C  17                                RLA
D08D  9F                                SBC A,A
D08E  C9                                RET
                                ; SWAIT: one poll more; CF=1 when HL runs out (HL = 0: never)
D08F  7C                        SWAIT:  LD A,H
D090  B5                                OR L
D091  C8                                RET Z
D092  2B                                DEC HL
D093  7C                                LD A,H
D094  B5                                OR L
D095  C0                                RET NZ
D096  37                                SCF
D097  C9                                RET
                                ; SERR: clear the error flags, if any (command 37h)
D098  ED 78                     SERR:   IN A,(C)
D09A  E6 78                             AND 78h
D09C  C8                                RET Z
D09D  3E 37                             LD A,37h
D09F  ED 79                             OUT (C),A
D0A1  C9                                RET
                                ; SSET: set the channel up: mode byte D, baud code E (0-15: 50 75 110
                                ; 134.5 150 200 300 600 1200 1800 2400 3600 4800 7200 9600 19200, as TMX
                                ; CONFIGUR lists them). The three 0s and 40h reset the 8251A from any state.
D0A2  AF                        SSET:   XOR A
D0A3  ED 79                             OUT (C),A
D0A5  ED 79                             OUT (C),A
D0A7  ED 79                             OUT (C),A
D0A9  3E 40                             LD A,40h
D0AB  ED 79                             OUT (C),A
D0AD  ED 51                             OUT (C),D
D0AF  3E 07                             LD A,07h
D0B1  ED 79                             OUT (C),A
D0B3  79                                LD A,C                  ; baud register: 10h for A (81h), 11h for B
D0B4  17                                RLA
D0B5  3E 11                             LD A,11h
D0B7  DE 00                             SBC A,0
D0B9  C5                                PUSH BC
D0BA  4F                                LD C,A
D0BB  ED 59                             OUT (C),E
D0BD  C1                                POP BC
D0BE  C9                                RET
                                ; SSTAT: INT 14h's status: AH = line status (0 data ready, 1 overrun,
                                ; 2 parity, 3 framing, 4 break, 5 and 6 transmitter empty), AL = modem
                                ; status (5 DSR; 4 CTS, always on: the 8251A handles CTS itself)
D0BF  ED 78                     SSTAT:  IN A,(C)
D0C1  57                                LD D,A
D0C2  21 E1 D0                          LD HL,LSMAP
D0C5  06 07                             LD B,7
D0C7  7A                        SS1:    LD A,D
D0C8  A6                                AND (HL)
D0C9  C6 FF                             ADD A,0FFh
D0CB  CB 13                             RL E
D0CD  23                                INC HL
D0CE  10 F7                             DJNZ SS1
D0D0  7B                                LD A,E
D0D1  E6 7F                             AND 7Fh
D0D3  32 01 D0                          LD (R_AH),A
D0D6  7A                                LD A,D
D0D7  E6 80                             AND 80h
D0D9  0F                                RRCA
D0DA  0F                                RRCA
D0DB  F6 10                             OR 10h
D0DD  32 00 D0                          LD (R_AL),A
D0E0  C9                                RET
D0E1  04 01 40 20 08 10 02      LSMAP:  DB 04h,01h,40h,20h,08h,10h,02h  ; the 8251A's bits for AH bits 6-0
                                ; INT 14h's baud rates (0-8) as WD2123 codes
D0E8  02 04 06 07 08 0A 0C 0E   BAUDT:  DB 2,4,6,7,8,10,12,14,15        ; 110 150 300 600 1200 2400 4800 9600 19200
D0E8  0F                        
D0F1  00 00 00 00 00 00 00 00           DS REGS+253-$
D0F1  00 00 00 00               
D0FD  C3 2C F1                  BOOTJP: JP COLD                 ; D0FDh: the boot sector jumps here
                                
                                ; ----------------------------------------------- opcode and ModR/M tables
                                        DS (($+255)&0FF00h)-$
D100                            OPLO:
D100  03 11 24 33 45 5E 71 95           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_PUSH_ES&0FFh, O_POP_ES&0FFh
D108  03 11 24 33 45 5E 7A C1           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_PUSH_CS&0FFh, O_TRAP&0FFh
D110  03 11 24 33 45 5E 83 9E           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_PUSH_SS&0FFh, O_POP_SS&0FFh
D118  03 11 24 33 45 5E 8C A8           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_PUSH_DS&0FFh, O_POP_DS&0FFh
D120  03 11 24 33 45 5E 4F B2           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_SEG_ES&0FFh, O_DAA&0FFh
D128  03 11 24 33 45 5E 5F F6           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_SEG_CS&0FFh, O_DAS&0FFh
D130  03 11 24 33 45 5E 6F 22           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_ALU4&0FFh, O_ALU5&0FFh, O_SEG_SS&0FFh, O_AAA&0FFh
D138  03 11 24 33 54 5E 7F 50           DB O_ALU0&0FFh, O_ALU1&0FFh, O_ALU2&0FFh, O_ALU3&0FFh, O_CMPAL&0FFh, O_ALU5&0FFh, O_SEG_DS&0FFh, O_AAS&0FFh
D140  69 9B CD FF 31 63 95 C7           DB O_INC_AX&0FFh, O_INC_CX&0FFh, O_INC_DX&0FFh, O_INC_BX&0FFh, O_INC_SP&0FFh, O_INC_BP&0FFh, O_INC_SI&0FFh, O_INC_DI&0FFh
D148  74 A6 D8 0A 3C 6E A0 D2           DB O_DEC_AX&0FFh, O_DEC_CX&0FFh, O_DEC_DX&0FFh, O_DEC_BX&0FFh, O_DEC_SP&0FFh, O_DEC_BP&0FFh, O_DEC_SI&0FFh, O_DEC_DI&0FFh
D150  F9 00 07 0E 2A 15 1C 23           DB O_PUSH_AX&0FFh, O_PUSH_CX&0FFh, O_PUSH_DX&0FFh, O_PUSH_BX&0FFh, O_PUSH_SP&0FFh, O_PUSH_BP&0FFh, O_PUSH_SI&0FFh, O_PUSH_DI&0FFh
D158  7F B1 E3 15 47 79 AB DD           DB O_POP_AX&0FFh, O_POP_CX&0FFh, O_POP_DX&0FFh, O_POP_BX&0FFh, O_POP_SP&0FFh, O_POP_BP&0FFh, O_POP_SI&0FFh, O_POP_DI&0FFh
D160  57 5D 63 6A 71 78 7F 86           DB O_JO&0FFh, O_JNO&0FFh, O_JB&0FFh, O_JNB&0FFh, O_JZ&0FFh, O_JNZ&0FFh, O_JBE&0FFh, O_JA&0FFh
D168  8D 93 99 A2 AE BC CA D7           DB O_JS&0FFh, O_JNS&0FFh, O_JP&0FFh, O_JNP&0FFh, O_JL&0FFh, O_JGE&0FFh, O_JLE&0FFh, O_JG&0FFh
D170  57 5D 63 6A 71 78 7F 86           DB O_JO&0FFh, O_JNO&0FFh, O_JB&0FFh, O_JNB&0FFh, O_JZ&0FFh, O_JNZ&0FFh, O_JBE&0FFh, O_JA&0FFh
D178  8D 93 99 A2 AE BC CA D7           DB O_JS&0FFh, O_JNS&0FFh, O_JP&0FFh, O_JNP&0FFh, O_JL&0FFh, O_JGE&0FFh, O_JLE&0FFh, O_JG&0FFh
D180  E4 F7 E4 0E 25 2F 3F 4A           DB O_GRP80&0FFh, O_GRP81&0FFh, O_GRP80&0FFh, O_GRP83&0FFh, O_TEST84&0FFh, O_TEST85&0FFh, O_XCHG86&0FFh, O_XCHG87&0FFh
