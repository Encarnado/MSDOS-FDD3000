D7F8  00 00 00 00 00 00 00 00           DS SHPG+256-$
                                
                                ; ================================================================ dispatch
                                ; Start: the registers, segments and flags are in REGS / AF', IP in TMP.
D800  F3                        START:  DI
D801  31 00 00                          LD SP,0
D804  DD 21 3B D8                       LD IX,NEXT
D808  2A 10 D0                          LD HL,(R_ES)
D80B  CD 36 D8                          CALL SHL4
D80E  22 18 D0                          LD (B_ES),HL
D811  2A 14 D0                          LD HL,(R_SS)
D814  CD 36 D8                          CALL SHL4
D817  22 1C D0                          LD (B_SS),HL
D81A  22 22 D0                          LD (EASS),HL
D81D  2A 16 D0                          LD HL,(R_DS)
D820  CD 36 D8                          CALL SHL4
D823  22 1E D0                          LD (B_DS),HL
D826  22 20 D0                          LD (EADS),HL
D829  CD BD DA                          CALL SETSTEP
D82C  2A 12 D0                          LD HL,(R_CS)
D82F  ED 5B 2A D0                       LD DE,(TMP)
D833  C3 22 DA                          JP FARJ
                                
D836  29                        SHL4:   ADD HL,HL
D837  29                                ADD HL,HL
D838  29                                ADD HL,HL
D839  29                                ADD HL,HL
D83A  C9                                RET
                                
D83B  0A                        NEXT:   LD A,(BC)
D83C  03                                INC BC
D83D  6F                                LD L,A
D83E  26 D1                             LD H,OPLO>>8
D840  5E                                LD E,(HL)
D841  24                                INC H
D842  56                                LD D,(HL)
D843  EB                                EX DE,HL
D844  E9                                JP (HL)                 ; handler gets A = opcode
                                
                                ; After a prefix: the next byte.
D845  0A                        NEXT2:  LD A,(BC)
D846  03                                INC BC
D847  6F                        DISPA:  LD L,A
D848  26 D1                             LD H,OPLO>>8
D84A  5E                                LD E,(HL)
D84B  24                                INC H
D84C  56                                LD D,(HL)
D84D  EB                                EX DE,HL
D84E  E9                                JP (HL)
                                
                                ; 26 2E 36 3E: segment override. The operand bases become the segment's
                                ; and IX points at RESTORE for one instruction, which puts them back.
D84F                            O_SEG_ES:
D84F  2A 18 D0                          LD HL,(B_ES)
D852  22 20 D0                          LD (EADS),HL
D855  22 22 D0                          LD (EASS),HL
D858  DD 21 A8 D8                       LD IX,RESTORE
D85C  C3 45 D8                          JP NEXT2
D85F                            O_SEG_CS:
D85F  2A 1A D0                          LD HL,(B_CS)
D862  22 20 D0                          LD (EADS),HL
D865  22 22 D0                          LD (EASS),HL
D868  DD 21 A8 D8                       LD IX,RESTORE
D86C  C3 45 D8                          JP NEXT2
D86F                            O_SEG_SS:
D86F  2A 1C D0                          LD HL,(B_SS)
D872  22 20 D0                          LD (EADS),HL
D875  22 22 D0                          LD (EASS),HL
D878  DD 21 A8 D8                       LD IX,RESTORE
D87C  C3 45 D8                          JP NEXT2
D87F                            O_SEG_DS:
D87F  2A 1E D0                          LD HL,(B_DS)
D882  22 20 D0                          LD (EADS),HL
D885  22 22 D0                          LD (EASS),HL
D888  DD 21 A8 D8                       LD IX,RESTORE
D88C  C3 45 D8                          JP NEXT2
                                
D88F  0F                        SEGSET: RRCA                    ; the same, A = prefix (after REP)
D890  0F                                RRCA
D891  E6 06                             AND 06h
D893  C6 18                             ADD A,B_ES&0FFh
D895  6F                                LD L,A
D896  26 D0                             LD H,REGS>>8
D898  5E                                LD E,(HL)
D899  2C                                INC L
D89A  56                                LD D,(HL)
D89B  ED 53 20 D0                       LD (EADS),DE
D89F  ED 53 22 D0                       LD (EASS),DE
D8A3  DD 21 A8 D8                       LD IX,RESTORE
D8A7  C9                                RET
                                
D8A8                            RESTORE:
D8A8  2A 1E D0                          LD HL,(B_DS)
D8AB  22 20 D0                          LD (EADS),HL
D8AE  2A 1C D0                          LD HL,(B_SS)
D8B1  22 22 D0                          LD (EASS),HL
D8B4  DD 21 3B D8                       LD IX,NEXT
D8B8  DD E9                             JP (IX)
                                
D8BA                            O_LOCK  EQU NEXT2
                                
D8BA  0B                        O_BAD:  DEC BC
D8BB                            BADSTOP:
D8BB  18 FE                             JR BADSTOP              ; unknown opcode (the harness stops here)
                                
D8BD                            O_HLT:
D8BD  18 FE                     HALTED: JR HALTED
                                
D8BF  DD E9                     O_NOP:  JP (IX)
                                
                                ; 0F nn: BIOS trap (POP CS on a real 8086)
D8C1  0A                        O_TRAP: LD A,(BC)
D8C2  03                                INC BC
D8C3  CD 33 EB                          CALL TRAP
D8C6  DD E9                             JP (IX)
                                
                                ; TRAP (A = function) is the BIOS: BIOS.ASM, or a RET that z86.py hooks.
                                
                                ; ============================================================ ModR/M decode
                                ; MRW: fetch ModR/M of a word op -> HL = r/m operand, DE = reg operand.
D8C8  0A                        MRW:    LD A,(BC)
D8C9  03                                INC BC
D8CA  FE C0                             CP 0C0h
D8CC  38 0F                             JR C,MRWM
D8CE  5F                                LD E,A
D8CF  E6 07                             AND 7
D8D1  87                                ADD A,A
D8D2  6F                                LD L,A
D8D3  7B                                LD A,E
D8D4  0F                                RRCA
D8D5  0F                                RRCA
D8D6  E6 0E                             AND 0Eh
D8D8  5F                                LD E,A
D8D9  26 D0                             LD H,REGS>>8
D8DB  54                                LD D,H
D8DC  C9                                RET
D8DD  F5                        MRWM:   PUSH AF
D8DE  CD 26 D9                          CALL EAMEM
D8E1  F1                                POP AF
D8E2  0F                                RRCA
D8E3  0F                                RRCA
D8E4  E6 0E                             AND 0Eh
D8E6  5F                                LD E,A
D8E7  16 D0                             LD D,REGS>>8
D8E9  C9                                RET
                                
                                ; MRB: the same for a byte op.
D8EA  0A                        MRB:    LD A,(BC)
D8EB  03                                INC BC
D8EC  FE C0                             CP 0C0h
D8EE  38 0C                             JR C,MRBM
D8F0  5F                                LD E,A
D8F1  E6 07                             AND 7
D8F3  F6 30                             OR R8TAB&0FFh
D8F5  6F                                LD L,A
D8F6  26 D0                             LD H,REGS>>8
D8F8  6E                                LD L,(HL)
D8F9  7B                                LD A,E
D8FA  18 05                             JR REG8
D8FC  F5                        MRBM:   PUSH AF
D8FD  CD 26 D9                          CALL EAMEM
D900  F1                                POP AF
D901  0F                        REG8:   RRCA                    ; A = ModR/M -> DE = reg8 operand
D902  0F                                RRCA
D903  0F                                RRCA
D904  E6 07                             AND 7
D906  F6 30                             OR R8TAB&0FFh
D908  5F                                LD E,A
D909  16 D0                             LD D,REGS>>8
D90B  1A                                LD A,(DE)
D90C  5F                                LD E,A
D90D  C9                                RET
                                
                                ; EAW / EAB: A = ModR/M (fetched) -> HL = r/m operand
D90E  FE C0                     EAW:    CP 0C0h
D910  38 14                             JR C,EAMEM
D912  E6 07                             AND 7
D914  87                                ADD A,A
D915  6F                                LD L,A
D916  26 D0                             LD H,REGS>>8
D918  C9                                RET
D919  FE C0                     EAB:    CP 0C0h
D91B  38 09                             JR C,EAMEM
D91D  E6 07                             AND 7
D91F  F6 30                             OR R8TAB&0FFh
D921  6F                                LD L,A
D922  26 D0                             LD H,REGS>>8
D924  6E                                LD L,(HL)
D925  C9                                RET
D926  6F                        EAMEM:  LD L,A
D927  26 D3                             LD H,EALO>>8
D929  5E                                LD E,(HL)
D92A  24                                INC H
D92B  56                                LD D,(HL)
D92C  EB                                EX DE,HL
D92D  E9                                JP (HL)
                                
                                ; memory operands: EA<mod><rm>
D92E  2A 06 D0                  EA00:   LD HL,(R_BX)
D931  ED 5B 0C D0                       LD DE,(R_SI)
D935  19                                ADD HL,DE
D936  ED 5B 20 D0               ADDDS:  LD DE,(EADS)
D93A  19                                ADD HL,DE
D93B  C9                                RET
D93C  2A 06 D0                  EA01:   LD HL,(R_BX)
D93F  ED 5B 0E D0                       LD DE,(R_DI)
D943  19                                ADD HL,DE
D944  18 F0                             JR ADDDS
D946  2A 0A D0                  EA02:   LD HL,(R_BP)
D949  ED 5B 0C D0                       LD DE,(R_SI)
D94D  19                                ADD HL,DE
D94E  ED 5B 22 D0               ADDSS:  LD DE,(EASS)
D952  19                                ADD HL,DE
