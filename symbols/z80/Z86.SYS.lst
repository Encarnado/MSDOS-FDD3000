                                ; FHOME: restore to track 0, polled (CBIOS F7B5h). NZ: seek error, the
                                ; drive never showed track 0 (A = 10h), or the restore timed out (A =
                                ; 20h, ~3.1 s).  Keeps BC; corrupts DE.  In the EAHI page's free end.
D4C0  3A 0A F1                  FHOME:  LD A,(RESCMD)
D4C3  D3 C0                             OUT (0C0h),A
D4C5  C5                                PUSH BC
D4C6  06 12                             LD B,12h                ; let the FDC raise BUSY
D4C8  10 FE                     FH0:    DJNZ FH0
D4CA  06 04                             LD B,4
D4CC  11 00 00                          LD DE,0
D4CF  DB C0                     FH1:    IN A,(0C0h)
D4D1  1F                                RRA
D4D2  30 0B                             JR NC,FH2
D4D4  1B                                DEC DE
D4D5  7A                                LD A,D
D4D6  B3                                OR E
D4D7  20 F6                             JR NZ,FH1
D4D9  10 F4                             DJNZ FH1
D4DB  C1                                POP BC
D4DC  C3 E4 D4                          JP FDTOUT
D4DF  C1                        FH2:    POP BC
D4E0  17                                RLA
D4E1  E6 10                             AND 10h
D4E3  C9                                RET
                                
                                ; FDTOUT: a floppy wait timed out.  Stop the command (Force Interrupt with
                                ; no condition raises no INTRQ) and return NZ, A = 20h ("not ready").
                                ; Reached by JP from the waits, so its RET goes to their caller.
D4E4  F3                        FDTOUT: DI
D4E5  3E D0                             LD A,0D0h
D4E7  D3 C0                             OUT (0C0h),A
D4E9  3E 20                             LD A,20h
D4EB  B7                                OR A
D4EC  C9                                RET
D4ED                            EAHIEND:
D4ED  00 00 00 00 00 00 00 00           DS EAHI+256-$
D4ED  00 00 00 00 00 00 00 00   
D4ED  00 00 00                  
                                
                                ; ------------------------------------------------- ALU cores, 16-byte slots
                                ; In: HL = destination operand, E = source. Index: (op >> 3) & 7.
D500                            BCORE:
D500  7E                                LD A,(HL)               ; 0 ADD
D501  83                                ADD A,E
D502  77                                LD (HL),A
D503  08                                EX AF,AF'
D504  DD E9                             JP (IX)
D506  00 00 00 00 00 00 00 00           DS BCORE+16-$
D506  00 00                     
D510  7E                                LD A,(HL)               ; 1 OR
D511  B3                                OR E
D512  C6 00                             ADD A,0                 ; OF = CF = AF = 0
D514  77                                LD (HL),A
D515  08                                EX AF,AF'
D516  DD E9                             JP (IX)
D518  00 00 00 00 00 00 00 00           DS BCORE+32-$
D520  08                                EX AF,AF'               ; 2 ADC
D521  7E                                LD A,(HL)
D522  8B                                ADC A,E
D523  77                                LD (HL),A
D524  08                                EX AF,AF'
D525  DD E9                             JP (IX)
D527  00 00 00 00 00 00 00 00           DS BCORE+48-$
D527  00                        
D530  08                                EX AF,AF'               ; 3 SBB
D531  7E                                LD A,(HL)
D532  9B                                SBC A,E
D533  77                                LD (HL),A
D534  08                                EX AF,AF'
D535  DD E9                             JP (IX)
D537  00 00 00 00 00 00 00 00           DS BCORE+64-$
D537  00                        
D540  7E                                LD A,(HL)               ; 4 AND
D541  A3                                AND E
D542  C6 00                             ADD A,0
D544  77                                LD (HL),A
D545  08                                EX AF,AF'
D546  DD E9                             JP (IX)
D548  00 00 00 00 00 00 00 00           DS BCORE+80-$
D550  7E                                LD A,(HL)               ; 5 SUB
D551  93                                SUB E
D552  77                                LD (HL),A
D553  08                                EX AF,AF'
D554  DD E9                             JP (IX)
D556  00 00 00 00 00 00 00 00           DS BCORE+96-$
D556  00 00                     
D560  7E                                LD A,(HL)               ; 6 XOR
D561  AB                                XOR E
D562  C6 00                             ADD A,0
D564  77                                LD (HL),A
D565  08                                EX AF,AF'
D566  DD E9                             JP (IX)
D568  00 00 00 00 00 00 00 00           DS BCORE+112-$
D570  7E                                LD A,(HL)               ; 7 CMP
D571  93                                SUB E
D572  08                                EX AF,AF'
D573  DD E9                             JP (IX)
D575  00 00 00 00 00 00 00 00           DS BCORE+128-$
D575  00 00 00                  
                                
                                ; In: HL = 16-bit operand -> HL + 1, flags as INC (CF kept).
D580  08                        INC16:  EX AF,AF'
D581  9F                                SBC A,A                 ; A = CF ? FFh : 0
D582  11 00 00                          LD DE,0
D585  37                                SCF
D586  ED 5A                             ADC HL,DE
D588  1F                                RRA                     ; CF back, S Z V untouched
D589  7D                                LD A,L
D58A  08                                EX AF,AF'
D58B  C9                                RET
                                
D58C  08                        DEC16:  EX AF,AF'
D58D  9F                                SBC A,A
D58E  11 00 00                          LD DE,0
D591  37                                SCF
D592  ED 52                             SBC HL,DE
D594  1F                                RRA
D595  7D                                LD A,L
D596  08                                EX AF,AF'
D597  C9                                RET
                                
                                ; DE = result of a 16-bit AND/OR/XOR/TEST: S Z PF from it, OF = CF = AF = 0.
D598  EB                        LOGF16: EX DE,HL
D599  AF                                XOR A
D59A  57                                LD D,A
D59B  5F                                LD E,A
D59C  ED 5A                             ADC HL,DE
D59E  7D                                LD A,L
D59F  08                                EX AF,AF'
D5A0  DD E9                             JP (IX)
                                
                                ; ---- INT 14h's set-up (BIOS.ASM's T_I14, AH = 0 and 4), in the free end
                                ; of this page, as the serial routines are in the register page's
D5A2  3A 02 D0                  I14EXT: LD A,(R_CL)             ; 4: CL baud 0-8 (110 ... 9600, 19200),
D5A5  FE 09                             CP 9                    ;   CH data bits 0-3 (5-8), BL stop bits
D5A7  D0                                RET NC                  ;   (0: 1, 1: 2), BH parity (0 none, 1 odd,
D5A8  47                                LD B,A                  ;   2 even)
D5A9  3A 07 D0                          LD A,(R_BH)
D5AC  16 10                             LD D,10h
D5AE  3D                                DEC A
D5AF  28 07                             JR Z,I14E1
D5B1  16 30                             LD D,30h
D5B3  3D                                DEC A
D5B4  28 02                             JR Z,I14E1
D5B6  16 00                             LD D,0
D5B8  3A 06 D0                  I14E1:  LD A,(R_BL)
D5BB  E6 01                             AND 1
D5BD  0F                                RRCA
D5BE  F6 40                             OR 40h
D5C0  B2                                OR D
D5C1  57                                LD D,A
D5C2  3A 03 D0                          LD A,(R_CH)
D5C5  E6 03                             AND 3
D5C7  18 1C                             JR I14SET
D5C9  3A 00 D0                  I14INI: LD A,(R_AL)             ; 0: AL = baud (bits 7-5: 110 ... 9600),
D5CC  5F                                LD E,A                  ;   parity (4-3: x0 none, 01 odd, 11 even),
D5CD  E6 18                             AND 18h                 ;   stop bits (2: 1 or 2), data bits (1-0)
D5CF  87                                ADD A,A
D5D0  57                                LD D,A
D5D1  CB 53                             BIT 2,E
D5D3  3E 40                             LD A,40h
D5D5  28 02                             JR Z,I14I1
D5D7  3E C0                             LD A,0C0h
D5D9  B2                        I14I1:  OR D
D5DA  57                                LD D,A
D5DB  7B                                LD A,E
D5DC  07                                RLCA
D5DD  07                                RLCA
D5DE  07                                RLCA
D5DF  E6 07                             AND 7
D5E1  47                                LD B,A
D5E2  7B                                LD A,E
D5E3  E6 03                             AND 3
D5E5  87                        I14SET: ADD A,A                 ; A = data bits 0-3, D = parity and stop
D5E6  87                                ADD A,A                 ;   bits, B = index in BAUDT
D5E7  B2                                OR D
D5E8  F6 02                             OR 2                    ; x16 clock
D5EA  57                                LD D,A
D5EB  21 E8 D0                          LD HL,BAUDT
D5EE  7D                                LD A,L
D5EF  80                                ADD A,B
D5F0  6F                                LD L,A
